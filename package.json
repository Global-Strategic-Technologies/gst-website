{
  "name": "gst-website",
  "type": "module",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Global-Strategic-Technologies/gst-website.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:a11y": "playwright test tests/e2e/accessibility.test.ts --project=chromium",
    "test:mcp": "npm -w @gst/mcp-server run test",
    "test:docs": "vitest run tests/integration/docs-link-integrity.test.ts tests/integration/docs-variables-sync.test.ts tests/integration/design-sync-guards.test.ts tests/integration/mcp-published-tool-count.test.ts tests/integration/mcp-generated-bundle-freshness.test.ts",
    "setup:claude-hooks": "node .claude/hooks/install.mjs",
    "radar:seed": "node mcp-server/scripts/seed-radar-cache.mjs",
    "radar:unseed": "node mcp-server/scripts/seed-radar-cache.mjs --unseed",
    "radar:stub": "node scripts/radar-stub.mjs",
    "test:all": "npm run test:run && npm run test:e2e && npm run test:mcp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    ".",
    "mcp-server"
  ],
  "browserslist": [
    "defaults",
    "Safari >= 14",
    "not IE 11"
  ],
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.8",
    "@sentry/astro": "^10.72.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.9",
    "chart.js": "^4.5.1",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "fflate": "^0.8.3",
    "topojson-client": "^3.1.0",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "browserslist": "^4.28.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "^17.4.1",
    "playwright": "^1.58.0",
    "postcss-html": "^2.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "us-atlas": "^3.0.1",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "fast-uri": "3.1.7",
    "@modelcontextprotocol/sdk": {
      "express-rate-limit": "8.5.1"
    },
    "@hono/node-server": {
      ".": "2.0.11"
    },
    "@lhci/cli": {
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    },
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "qs": "6.16.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write",
      "prettier --check"
    ],
    "*.astro": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write",
      "prettier --check"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write",
      "prettier --check"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write",
      "prettier --check"
    ]
  }
}
