# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# vercel env pull output + any *.local-suffixed env file (per-developer, often plaintext secrets)
.env.*.local
.env.local

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# vercel deployment
.vercel/

# unoptimised source captures — must never ship (anything under public/ deploys verbatim).
# These are irreplaceable ORIGINALS, not build inputs: the optimised media in
# public/images/hub/mcp/ can be regenerated from them via the recipes in BL-138, but nothing
# regenerates these. Do not delete without checking that stanza first.
media-raw/

# claude local settings (per-developer)
.claude/settings.json
.claude/settings.local.json
# claude scheduled-tasks runtime lock (per-session)
.claude/scheduled_tasks.lock
# claude review-gate runtime markers (per-session; written by plan-reviewer / code-reviewer agents)
.claude/tasks/plan-review.json
.claude/tasks/impl-review.json

# playwright test results and reports
test-results/
playwright-report/

# test coverage reports
coverage/

# dev-mode API response cache
.cache/

# wrangler local dev cache + .dev.vars (per-developer secret overrides — never committed)
.wrangler/
.dev.vars
.dev.vars.*
.vercel

# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
