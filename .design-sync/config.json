    "FrostedSpecimen": ".design-sync/specimens/FrostedSpecimen.tsx",
    "ToolShellSpecimen": ".design-sync/specimens/ToolShellSpecimen.tsx",
    "ColorSpecimen": ".design-sync/specimens/ColorSpecimen.tsx",
