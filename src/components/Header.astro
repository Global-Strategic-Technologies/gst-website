---
import HeaderLogo from './HeaderLogo.astro';
import HeaderNavLinks from './HeaderNavLinks.astro';
// Note: trackNavigation is imported in the <script> block below to wire
// it to window for inline onclick handlers (rendered by HeaderLogo and
// HeaderNavLinks, whose presentational markup lives in those components
// so /brand can render the same thing — BL-095 AC-2).

import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/t';

interface Props {
  currentPath?: string;
  staticHeader?: boolean;
  locale?: Locale;
}

const { currentPath = '/', staticHeader = false, locale = DEFAULT_LOCALE } = Astro.props;
const { t } = useTranslations(locale, 'common');
---

<header class={`site-header${staticHeader ? ' site-header--static' : ''}`} role="banner">
  <div class="container">
    <nav role="navigation" aria-label={t('nav.ariaLabel')}>
      <HeaderLogo locale={locale} />
      <HeaderNavLinks currentPath={currentPath} locale={locale} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 1.275rem 0;
    background: light-dark(var(--bg-light-alt), var(--bg-dark));
    border-bottom: 2px solid var(--color-primary);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }

  .site-header--static {
    position: static;
  }

  .site-header nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Last-resort safety on the narrowest phones. The logo plus four links need
     ~307px. Until 2026-09-01 `.container` paid 3rem of gutter at every width,
     and against that the row could not fit below ~330px (~345 in WebKit): it
     overflowed the viewport instead.

     Those two thresholds are measured history, not arithmetic. They are not
     reproducible from 307 + 96, so do not "correct" them to a derived number —
     re-measure or leave them.

     The gutter ladder (global.css) has since given a 320px viewport 288px
     instead of 224px, and the row held one line at 320px even with
     HeaderNavLinks' gap-tightening disabled — measured 2026-09-01, Chromium.

     BL-153 then added a fifth <li>, the language switcher, which renders only
     while ≥2 locales are live. WITH it the row needs 318px (logo 101 + list
     217: four links 148 + switcher 37 + four 8px gaps — measured 2026-09-05,
     Chromium, forced-live server), so it holds one line from a 350px viewport
     (288 + 30 more of container) and wraps to two rows below that, which is
     exactly the case this rule exists for: at 320px the list drops under the
     logo, nothing overflows (measured 0px), and every link stays on screen
     (localization.test.ts sweeps 320–1440). Without live translations the
     numbers above are unchanged. The sash reserve tiers (540/512) are not
     touched by the fifth item: it sits inside the same <ul> the reserve pads.

     Deliberately NOT on the base rule, and the reason is a measurement tool, not
     tidiness: the sash's 540/512 tiers were derived by finding where the nav
     reserve fits, using horizontal overflow as the failure signal, and
     announcement-sash.test.ts still guards them that way from 400px up. A nav
     that can wrap cannot overflow, so a mis-sized reserve would silently become
     a two-row header instead of failing. Confined to 400px and below — where
     the sash has left the corner for the in-flow strip (sash.css) and the
     reserve is 0 — the two systems provably cannot interact. */
  @media (max-width: 400px) {
    .site-header nav {
      flex-wrap: wrap;
      row-gap: var(--spacing-xs);
    }
  }

  @media (max-width: 768px) {
    .site-header {
      padding: var(--spacing-lg) 0;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      padding: var(--spacing-md) 0;
    }
  }

  @media print {
    .site-header {
      display: none !important;
    }
  }
</style>

<script>
  import { trackNavigation } from '../utils/analytics';

  // Make trackNavigation available to inline onclick handlers.
  // TODO(phase-3): replace with proper ambient `Window` type declaration.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  (window as any).trackNavigation = trackNavigation;
</script>
