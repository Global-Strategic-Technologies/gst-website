---
import HeaderLogo from './HeaderLogo.astro';
import HeaderNavLinks from './HeaderNavLinks.astro';
// Note: trackNavigation is imported in the <script> block below to wire
// it to window for inline onclick handlers (rendered by HeaderLogo and
// HeaderNavLinks, whose presentational markup lives in those components
// so /brand can render the same thing — BL-095 AC-2).

interface Props {
  currentPath?: string;
  staticHeader?: boolean;
}

const { currentPath = '/', staticHeader = false } = Astro.props;
---

<header class={`site-header${staticHeader ? ' site-header--static' : ''}`} role="banner">
  <div class="container">
    <nav role="navigation" aria-label="Main navigation">
      <HeaderLogo />
      <HeaderNavLinks currentPath={currentPath} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 1.275rem 0;
    background: light-dark(var(--bg-light-alt), var(--bg-dark));
    border-bottom: 2px solid var(--color-primary);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }

  .site-header--static {
    position: static;
  }

  .site-header nav {
    display: flex;
    justify-content: space-between;
    align-items: center;

    /* Last-resort safety on the narrowest phones: the logo plus four links need
       ~307px beside the container's 3rem gutters, so below ~330px (~345 in
       WebKit) the row cannot fit and previously overflowed the viewport. It
       never wraps at 360px or above — HeaderNavLinks tightens its gap under
       400px to keep it that way — so this changes nothing on a real phone and
       simply refuses to push content off-screen on the smallest ones. */
    flex-wrap: wrap;
    row-gap: var(--spacing-xs);
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 1rem 0;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      padding: 0.75rem 0;
    }
  }

  @media print {
    .site-header {
      display: none !important;
    }
  }
</style>

<script>
  import { trackNavigation } from '../utils/analytics';

  // Make trackNavigation available to inline onclick handlers.
  // TODO(phase-3): replace with proper ambient `Window` type declaration.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  (window as any).trackNavigation = trackNavigation;
</script>
