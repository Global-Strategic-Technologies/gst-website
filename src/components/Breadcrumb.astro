---
/**
 * Site-wide breadcrumb navigation component.
 * Auto-generates from URL pathname using the shared slug-to-name mapping.
 * Renders accessible markup with proper ARIA attributes.
 *
 * Placed in BaseLayout.astro — every non-homepage page gets breadcrumbs automatically.
 *
 * Both props exist so `/brand` can exhibit this as a live specimen instead of the
 * hand-rolled replica it used to carry (BL-095); neither is set anywhere else.
 */
import { slugToName } from '../utils/breadcrumbs';

interface Props {
  /**
   * Override the derived crumbs. Used by the `/brand` specimen so its links stay
   * in-page (`#ui-library`) — the derived form emits real hrefs, which would
   * navigate away from the design-system page.
   *
   * `isLast` is honoured and a supplied list still passes through the FIFO
   * truncation below, so the prop cannot bypass MAX_BREADCRUMBS. (The `/brand`
   * specimen passes exactly 3, so it does not itself exercise truncation.)
   */
  crumbs?: { name: string; href: string; isLast: boolean }[];
  /**
   * Landmark name. Defaults to the real one; the `/brand` specimen passes a
   * distinct label because BaseLayout already renders this component on that page
   * and two identically-named landmarks is an axe `landmark-unique` violation.
   *
   * That rule is best-practice/moderate, which `tests/e2e/helpers/a11y.ts` filters
   * out — so nothing in CI would catch a collision here.
   */
  ariaLabel?: string;
}

const { crumbs: crumbsProp, ariaLabel = 'Breadcrumb' } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '');
const segments = pathname.split('/').filter(Boolean);

// Build full crumb list including Home, then FIFO-truncate to 3 max
const allCrumbs = crumbsProp ?? [
  { name: 'Home', href: '/', isLast: false },
  ...segments.map((slug, index) => ({
    name: slugToName(slug),
    // Trailing slash keeps these links consistent with the site-wide
    // trailing-slash canonicalization (Vercel `trailingSlash: true`) and the
    // BreadcrumbList JSON-LD in SEO.astro (which already emits the slash), so
    // breadcrumb clicks land on the canonical URL without a 308 hop.
    href: '/' + segments.slice(0, index + 1).join('/') + '/',
    isLast: index === segments.length - 1,
  })),
];

const MAX_BREADCRUMBS = 3;
const crumbs =
  allCrumbs.length > MAX_BREADCRUMBS
    ? allCrumbs.slice(allCrumbs.length - MAX_BREADCRUMBS)
    : allCrumbs;
---

<nav aria-label={ariaLabel} class="breadcrumb">
  <ol class="breadcrumb__list">
    {
      crumbs.map((crumb) => (
        <li class="breadcrumb__item">
          {crumb.isLast ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <>
              <a href={crumb.href}>{crumb.name}</a>
              <span class="breadcrumb__separator" aria-hidden="true">
                /
              </span>
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    padding: var(--spacing-lg) 0 0;
    margin-bottom: var(--spacing-lg);
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .breadcrumb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--text-muted);
    overflow: hidden;
  }

  .breadcrumb__item {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
    line-height: 1.4;
  }

  .breadcrumb__item:last-child {
    overflow: hidden;
  }

  .breadcrumb__item a,
  .breadcrumb__item [aria-current='page'] {
    font-size: var(--text-sm);
    font-weight: normal;
    line-height: 1.4;
  }

  .breadcrumb__item [aria-current='page'] {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .breadcrumb__item a {
    color: var(--color-tertiary);
    text-decoration: none;
    text-transform: none;
    letter-spacing: normal;
    border-bottom: none;
    transition: opacity var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  .breadcrumb__item a:hover {
    opacity: 0.8;
  }

  .breadcrumb__item a:active {
    opacity: 0.6;
  }

  .breadcrumb__separator {
    margin: 0 var(--spacing-sm);
  }

  @media (max-width: 480px) {
    .breadcrumb {
      padding: var(--spacing-sm) 0 0;
      margin-bottom: var(--spacing-md);
    }
  }
</style>
