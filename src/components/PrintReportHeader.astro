---
/**
 * PrintReportHeader — branded header rendered only when a page is printed.
 *
 * Hidden on screen (display: none) and revealed by its own @media print
 * block. Use this component anywhere a printed export needs the standard
 * GST brand + title + generation-date strip at the top of page 1.
 *
 * This component owns all of its styling, screen and print. Every selector
 * below is `:global()`, so a caller that genuinely needs a per-page
 * variant can target the plain class names — but only through `:global()`
 * (or a plain stylesheet): a caller's SCOPED `.print-report-header` rule
 * compiles to the caller's cid, which this markup never carries, so it
 * silently matches nothing. The tech-debt-calculator and regulatory-map
 * pages carried such overrides for their whole life without one of them
 * ever applying; they were deleted on 2026-09-26 (the guard in
 * tests/unit/scoped-selector-foreign-element.test.ts now fails on that
 * shape).
 */
import DeltaIcon from './DeltaIcon.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { formatDate } from '../i18n/formatters';
import { useTranslations } from '../i18n/t';

interface Props {
  title: string;
  locale?: Locale;
}

const { title, locale = DEFAULT_LOCALE } = Astro.props;
const { t } = useTranslations(locale, 'common');

const generatedLine = t('print.generated', {
  date: formatDate(new Date(), locale, { year: 'numeric', month: 'long', day: 'numeric' }),
});
---

<div class="print-report-header" aria-hidden="true">
  <div class="print-report-header__brand">
    <DeltaIcon class="bullet-icon" />
    <span>GST</span>
  </div>
  <div class="print-report-header__title">{title}</div>
  <div class="print-report-header__date">{generatedLine}</div>
</div>

<style>
  :global(.print-report-header) {
    display: none;
  }

  @media print {
    /* stylelint-disable scale-unlimited/declaration-strict-value -- print output is deliberately literal (paper has no theme) */
    :global(.print-report-header) {
      display: flex !important;
      align-items: center;
      gap: var(--spacing-lg);
      padding-bottom: var(--spacing-lg);
      margin-bottom: var(--spacing-2xl);
      border-bottom: 2px solid #000;
      font-family: var(--font-family-mono);
    }

    :global(.print-report-header__brand) {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      font-weight: 900;
      font-size: var(--text-xl);
      text-transform: uppercase;
    }

    :global(.print-report-header__title) {
      font-weight: 700;
      font-size: var(--text-base);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    :global(.print-report-header__date) {
      margin-left: auto;
      font-size: var(--text-xs);
      color: var(--text-muted);
    }
    /* stylelint-enable scale-unlimited/declaration-strict-value */
  }
</style>
