---
/**
 * Category filter pills for the Radar page.
 * Client-side filtering via data-category attributes.
 */
import type { RadarCategory } from '../../lib/inoreader/types';

interface Props {
  categories: Record<string, RadarCategory>;
}

const { categories } = Astro.props;

// Compute gravity --d values at build time to avoid CLS from client-side margin changes.
// --d is 0 at center, 1 at edges; margin grows quadratically via CSS.
const catEntries = Object.entries(categories);
const totalButtons = catEntries.length + 1; // +1 for "All"
const center = (totalButtons - 1) / 2;
const maxDist = center || 1;
const allD = (Math.abs(0 - center) / maxDist).toFixed(3);
---

<nav class="category-filter" aria-label="Filter by category">
  <button class="filter-btn active" data-filter="all" style={`--d: ${allD}`}>All</button>
  {
    catEntries.map(([key, cat], i) => {
      const d = (Math.abs(i + 1 - center) / maxDist).toFixed(3);
      return (
        <button class="filter-btn" data-filter={key} style={`--btn-color: ${cat.color}; --d: ${d}`}>
          {cat.label}
        </button>
      );
    })
  }
</nav>

<script>
  import {
    serializeToParams as serializeRadarFilters,
    deserializeFromParams as deserializeRadarFilters,
  } from '../../utils/radar-url';

  // BL-031.95 Phase 3.B: URL state ↔ category pill sync.
  //
  // - On init: read `?category=<X>` from the URL; if a known category is
  //   present, activate that pill and set the filter.
  // - On click: write `?category=<X>` (or strip when "all") via
  //   history.replaceState so a copied URL deep-links to the same view.
  //
  // Filtering is done by setting ONE attribute on `.radar-container` — a shell
  // element that exists at DOMContentLoaded — and letting CSS in
  // `pages/hub/radar/index.astro` hide the non-matching `[data-category]`
  // items. It deliberately does NOT touch the items themselves: RadarFeed is a
  // `server:defer` island whose contents arrive after DOMContentLoaded, and
  // Astro fires no event when they do (the runtime just splices a fragment in).
  // Any approach that reaches for the items on load has to guess at that
  // timing; this one cannot be wrong about it, because the rule is already in
  // place before the items exist. Reaching for `[data-category]` here is the
  // bug that made `?category=` activate the pill but never filter the feed.

  function applyFilter(root: Element | null, filter: string): void {
    if (root instanceof HTMLElement) root.dataset.activeCategory = filter;
  }

  function syncUrlState(filter: string): void {
    try {
      const filters = filter === 'all' ? {} : { category: filter as never };
      const params = serializeRadarFilters(filters);
      const queryString = params.toString();
      const url = queryString
        ? `${window.location.pathname}?${queryString}`
        : window.location.pathname;
      history.replaceState(null, '', url);
    } catch {
      // history API may be unavailable in sandboxed contexts; ignore.
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    // Resolved from a pill rather than queried globally, so this component
    // carries no assumption about where in the page it was mounted.
    const scope = buttons[0]?.closest('.radar-container') ?? null;

    // Hydrate from URL: if a known category is in `?category=`, activate
    // that pill and set the filter. Safe to run before the island lands.
    const urlFilters = deserializeRadarFilters(new URLSearchParams(window.location.search));
    if (urlFilters.category) {
      buttons.forEach((b) => {
        b.classList.toggle('active', (b as HTMLElement).dataset.filter === urlFilters.category);
      });
      applyFilter(scope, urlFilters.category);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter ?? 'all';

        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        applyFilter(scope, filter);
        syncUrlState(filter);
      });
    });
  });
</script>

<style>
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
    padding: var(--spacing-xl) 0;
    margin-bottom: var(--spacing-2xl);
  }

  .filter-btn {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-semibold);
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 1px solid var(--filter-chip-border);
    background: var(--filter-chip-bg);
    color: var(--filter-chip-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all var(--transition-normal);

    /* Gravity: --d is distance from center (0 = center, 1 = edge).
       Margin grows quadratically so center buttons cluster tight. */
    margin: var(--spacing-xs) calc(var(--spacing-xs) + var(--d, 0) * var(--d, 0) * 1.6rem);
  }

  .filter-btn:hover {
    border-color: var(--btn-color, var(--color-primary));
    color: var(--btn-color, var(--color-primary));
  }

  .filter-btn.active {
    background: var(--btn-color, var(--color-primary));
    border-color: var(--btn-color, var(--color-primary));
    color: var(--bg-light);
  }

  @media (max-width: 480px) {
    .category-filter {
      overflow-x: auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: var(--spacing-md) 0 var(--spacing-lg);
    }

    .category-filter::-webkit-scrollbar {
      display: none;
    }

    .filter-btn {
      flex-shrink: 0;
      white-space: nowrap;
      min-height: var(--touch-target-min);
      margin: var(--spacing-xs) var(--spacing-xs);
    }
  }
</style>
