---
/**
 * RadarFeed — Fetches and renders the unified feed as a server island.
 *
 * **BL-032.8 Phase A (2026-05-17)**: data source switched from direct
 * Inoreader API calls (`inoreader/client.ts`) to the MCP Worker's
 * `GET /radar/snapshot` endpoint. The website is now a downstream
 * consumer of the MCP substrate rather than a parallel Inoreader caller.
 *
 * Architectural benefits:
 *   - All BL-032.7 substrate protections (rate-limit, circuit breaker,
 *     day-counter, 429-header observability) automatically extend to
 *     website traffic.
 *   - One OAuth identity for all GST Inoreader traffic — visible as a
 *     single usage graph in the Inoreader Developer Console.
 *   - A 429 from Inoreader trips ONE circuit breaker and affects every
 *     consumer identically.
 *
 * **Rollback path**: `git revert` of the Phase A cutover commit. The
 * `inoreader/client.ts` module and the website-side OAuth flow are
 * retained in Phase A; Phase B (post-soak) deletes them. No runtime
 * feature flag — git is the source of truth for the rollback.
 *
 * Rendered as a `server:defer` server island with `RadarFeedSkeleton` in
 * `slot="fallback"`. `@astrojs/vercel` routes `/_server-islands/*` to the
 * UNCACHED render function, so a failed fetch self-heals on the next request
 * rather than being baked into an ISR entry for 6h. `/hub/radar` is `noindex`,
 * so deferring the page's primary content costs no indexability — see
 * ADR-0012 and RADAR.md § "Why the feed is a server island".
 *
 * No props — data fetching is self-contained. (Originally to dodge server-island
 * prop-serialization limits; kept because it keeps the fetch next to its use.)
 *
 * The fetch below MUST stay bounded: undici defaults to a 300s timeout and
 * this function sets no `maxDuration`, so an unbounded call to a hung Worker
 * would hold a serverless invocation open for the full default. That is true
 * of the island function exactly as it was of the inline render.
 */
import FyiItem from './FyiItem.astro';
import WireItem from './WireItem.astro';

import {
  snapshotToFyiItem,
  snapshotToWireItem,
  mergeFeed,
  CATEGORIES,
  type RadarSnapshotItem,
} from '../../lib/inoreader/transform';

import type { RadarFyiItem, RadarWireItem } from '../../lib/inoreader/types';
import { boundWireItems } from '../../utils/radar-feed-bounds';

// Typed env imports — see astro.config.mjs schema. MCP_KEY_WEBSITE_RADAR
// is optional in schema (graceful empty-feed degradation when unset);
// MCP_RADAR_SNAPSHOT_URL has a production default and is overridable on
// Vercel preview deploys to target the staging Worker.
import { MCP_KEY_WEBSITE_RADAR, MCP_RADAR_SNAPSHOT_URL } from 'astro:env/server';

const RADAR_SNAPSHOT_URL = MCP_RADAR_SNAPSHOT_URL;
const RADAR_BEARER = MCP_KEY_WEBSITE_RADAR;

interface RadarSnapshotResponse {
  wire: { ok: true; items: RadarSnapshotItem[] } | { ok: false; reason: string; message?: string };
  fyi: { ok: true; items: RadarSnapshotItem[] } | { ok: false; reason: string; message?: string };
  fetchedAt: string;
}

// --- Data Fetching (runs on Vercel per pageview — the island is uncached) ---

let fyi: RadarFyiItem[] = [];
let wire: RadarWireItem[] = [];

if (!RADAR_BEARER) {
  // Misconfigured env — log loud so operators see it in Vercel logs;
  // continue with empty feeds rather than throwing (radar-empty UX is
  // better than 500-ing the whole page).
  console.error(
    '[Radar] MCP_KEY_WEBSITE_RADAR is not bound on the env. /hub/radar will render empty.'
  );
} else {
  try {
    // 5s is a conservative bound, not a measured p95 of THIS path: the nearest
    // available proxies are cron-radar p95 <= 899ms (ARCHITECTURE.md § SLO
    // baselines, a section that explicitly defers tool/resource latency SLOs)
    // and ~930ms client-observed search_radar p95 from GRU (LATENCY_PROBE.md).
    // Neither measures Vercel-function -> Worker /radar/snapshot. Wide enough
    // that a slow-but-working Worker is not cut off; tight enough that a hung
    // one cannot pin the island invocation open for undici's 300s default.
    const res = await fetch(RADAR_SNAPSHOT_URL, {
      headers: {
        Authorization: `Bearer ${RADAR_BEARER}`,
        Accept: 'application/json',
      },
      signal: AbortSignal.timeout(5000),
    });
    if (!res.ok) {
      console.error(`[Radar] MCP /radar/snapshot returned ${res.status} ${res.statusText}`);
    } else {
      const snapshot = (await res.json()) as RadarSnapshotResponse;

      // FYI tier
      if (snapshot.fyi.ok) {
        fyi = snapshot.fyi.items
          .map(snapshotToFyiItem)
          .filter((item): item is RadarFyiItem => item !== null);
      } else {
        console.error('[Radar] FYI tier failed:', snapshot.fyi.reason, snapshot.fyi.message);
      }

      // Wire tier
      if (snapshot.wire.ok) {
        const fyiUrls = new Set(fyi.map((f) => f.url));
        const allWireItems = snapshot.wire.items
          .filter((item) => !fyiUrls.has(item.url))
          .map(snapshotToWireItem);

        // Guarantee each category is represented before filling chronologically, then
        // cap the tier. Extracted to `src/utils/radar-feed-bounds.ts` under BL-109 so the
        // MCP `search_radar` tool applies the identical bound — it previously applied
        // none, and returned ~46 wire items where this page renders 30. The dedupe above
        // must stay ahead of this call: the cap counts non-duplicates.
        wire = boundWireItems(allWireItems, Object.keys(CATEGORIES));
      } else {
        console.error('[Radar] Wire tier failed:', snapshot.wire.reason, snapshot.wire.message);
      }
    }
  } catch (e) {
    // Name the timeout explicitly: an AbortError here means the 5s bound above
    // fired, which is operationally different from a network or parse failure.
    // As an island this no longer risks caching the empty state — the next
    // request re-runs uncached — but the distinction still matters in logs.
    if (e instanceof Error && e.name === 'TimeoutError') {
      console.error('[Radar] MCP /radar/snapshot timed out after 5000ms — rendering empty feed.');
    } else {
      console.error('[Radar] MCP /radar/snapshot fetch threw:', e);
    }
  }
}

// --- Merge into unified feed ---
const feed = mergeFeed(fyi, wire);
---

{
  feed.length > 0 ? (
    <div class="feed-list">
      {feed.map((item) =>
        item.kind === 'fyi' ? <FyiItem item={item} /> : <WireItem item={item} />
      )}
    </div>
  ) : (
    <section class="radar-empty">
      <p>Intelligence feed is currently being refreshed. Check back shortly.</p>
    </section>
  )
}

<style>
  .feed-list {
    max-width: 48rem;
    margin: 0 auto;
  }

  .radar-empty {
    padding: var(--spacing-3xl) 0;
    text-align: center;
    color: var(--text-muted);
  }
</style>
