---
import DeltaIcon from '../DeltaIcon.astro';
import TableOfContents from '../TableOfContents.astro';
import Breadcrumb from '../Breadcrumb.astro';
import StatsBar from '../StatsBar.astro';
import WireItem from '../radar/WireItem.astro';
import HeaderLogo from '../HeaderLogo.astro';
import HeaderNavLinks from '../HeaderNavLinks.astro';
import ThemeToggleButton from '../ThemeToggleButton.astro';
import FooterLinks from '../FooterLinks.astro';
import CTABox from '../CTABox.astro';
import Sash from '../Sash.astro';
import type { RadarWireItem } from '../../lib/inoreader/types';

/**
 * Demo fixture for the Wire Item specimen (BL-095 AC-1 — it renders the real
 * component rather than a replica of it).
 *
 * `category` must be a real CATEGORIES key: WireItem renders its dot as
 * `{cat && …}`, so an unknown category silently drops the dot the caption
 * promises.
 */
const DEMO_WIRE_ITEM: RadarWireItem = {
  id: 'brand-specimen-wire',
  title: 'PE firms accelerate bolt-on acquisitions in vertical SaaS',
  url: '#lib-radar',
  source: 'TechCrunch',
  category: 'pe-ma',
  publishedAt: '2026-04-01T12:00:00.000Z',
};
---

<!-- Section 8: UI Component Library -->
<section class="brand-section" id="ui-library">
  <div class="container">
    <h2 class="brutal-heading-md brand-section__title">UI Component Library</h2>
    <p class="brutal-text-small brand-section__note">
      Shared controls and patterns used across the site. Each specimen renders live markup with the
      real CSS classes. This library defines UX platform standards.
    </p>

    <!-- 8a. Navigation -->
    <h3 class="brutal-heading-sm brand-group-title" id="lib-navigation">Navigation</h3>

    <h4 class="brutal-label brand-subgroup-title">Breadcrumb</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <nav aria-label="Breadcrumb brutalist demo" class="brutal-breadcrumb">
          <ol class="brutal-breadcrumb__list">
            <li class="brutal-breadcrumb__item">
              <a href="#ui-library">Home</a>
              <span class="brutal-breadcrumb__sep" aria-hidden="true">/</span>
            </li>
            <li class="brutal-breadcrumb__item">
              <a href="#ui-library">Hub</a>
              <span class="brutal-breadcrumb__sep" aria-hidden="true">/</span>
            </li>
            <li class="brutal-breadcrumb__item">
              <span aria-current="page">Current Page</span>
            </li>
          </ol>
        </nav>
        <code class="brand-code"
          >.brutal-breadcrumb — monospace, uppercase, primary links, wide letter-spacing</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Nav Link</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        <a class="nav-link" href="#ui-library">Default</a>
        <code class="brand-code">.nav-link</code>
      </div>
      <div class="brand-component-item">
        <a class="nav-link active" href="#ui-library">Active</a>
        <code class="brand-code">.nav-link.active</code>
      </div>
    </div>

    <!-- 8a-1b. Site Chrome -->
    <h3 class="brutal-heading-sm brand-group-title" id="lib-site-chrome">Site Chrome</h3>

    <h4 class="brutal-label brand-subgroup-title">Logo</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        {
          /* The real component (BL-095 AC-2), not a replica — the presentational
             lockup Header.astro composes. `href` keeps the link in-page AND
             suppresses the trackNavigation onclick: a specimen click must not
             emit a real `navigation_click` event. */
        }
        <HeaderLogo href="#ui-library" />
        <code class="brand-code"
          >.logo — monospace, 900 weight, uppercase, -0.05em tracking, primary "S" accent, pulsing
          dot. Rendered by HeaderLogo.astro, the lockup Header.astro composes</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Header Nav Links</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        {
          /* The real component (BL-095 AC-2), not a replica — the link list
             Header.astro composes inside its nav landmark (a styled list is
             not a landmark, so no aria-label is needed here). `links` keeps
             the entries in-page AND selects the untracked demo branch: a
             specimen click must not emit a real `navigation_click` event. */
        }
        <HeaderNavLinks
          links={[
            { label: 'Services', href: '#ui-library' },
            { label: 'M&A', href: '#ui-library', active: true },
            { label: 'Hub', href: '#ui-library' },
          ]}
        />
        <code class="brand-code"
          >Rendered by HeaderNavLinks.astro, the link list Header.astro composes — monospace,
          uppercase, bold, 2px primary underline + tertiary ink on active/hover, narrower size and
          gap below 768px</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Footer Links</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        {
          /* The real component (BL-095 AC-2), not a replica — the link row
             Footer.astro composes. Footer itself still cannot render twice
             (it embeds the singleton ThemeToggle), but its links no longer
             need it to. `links` keeps the entries in-page (Breadcrumb
             `crumbs` precedent). */
        }
        <FooterLinks
          links={[
            { label: 'LinkedIn', href: '#ui-library' },
            { label: 'Privacy', href: '#ui-library' },
            { label: 'Terms', href: '#ui-library' },
          ]}
        />
        <code class="brand-code"
          >.footer-links a — monospace, uppercase, bold, primary underline-reveal on hover. Rendered
          by FooterLinks.astro, which narrows the size and gap below 768px</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Breadcrumb (Site Chrome)</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        {
          /* The real component (BL-095 AC-1), not a replica. `crumbs` keeps the
             links in-page; `ariaLabel` avoids a second landmark named
             "Breadcrumb" alongside the live one BaseLayout renders on this page. */
        }
        <Breadcrumb
          ariaLabel="Breadcrumb site chrome demo"
          crumbs={[
            { name: 'Home', href: '#ui-library', isLast: false },
            { name: 'Hub', href: '#ui-library', isLast: false },
            { name: 'Current Page', href: '#ui-library', isLast: true },
          ]}
        />
        <code class="brand-code"
          >.breadcrumb — monospace font-family, tertiary-color links, slash separators</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Theme Toggle</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        {
          /* The real component (BL-095 AC-2), not a replica — the visual button
             ThemeToggle.astro wraps. No id/testId here, so `#themeToggle` and
             `[data-testid="theme-toggle"]` stay unique and the bound script
             keeps binding only the footer instance; this button is real but
             intentionally inert. The footer-fit negative margin lives in
             Footer.astro, so no compensation is needed here. */
        }
        <ThemeToggleButton title="Theme toggle specimen" ariaLabel="Theme toggle specimen" />
        <code class="brand-code"
          >.theme-toggle — delta icon, no border/radius, var(--color-primary) color,
          var(--transition-fast), 44px hit box. Rendered by ThemeToggleButton.astro, the button
          ThemeToggle.astro wraps</code
        >
      </div>
    </div>

    <!-- 8a-1c. Marketing Components -->
    <h3 class="brutal-heading-sm brand-group-title" id="lib-marketing">Marketing Components</h3>

    <h4 class="brutal-label brand-subgroup-title">Hero Title</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <span
          class="brutal-hero__title"
          style="font-size:3rem;font-weight:900;letter-spacing:-0.04em;line-height:0.95;"
          data-specimen>Technology Advisory</span
        >
        <code class="brand-code"
          >.brutal-hero__title — monospace, uppercase (pair with .hero h1 for size/weight)</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Hero Description</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <span
          class="brutal-hero__description"
          style="font-size:var(--text-xl);line-height:1.6;font-weight:400;"
          data-specimen
          >GST partners with private equity firms to evaluate, stabilize, and scale the technology
          assets inside their portfolio companies.</span
        >
        <code class="brand-code"
          >.brutal-hero__description — monospace (pair with .hero p for size/color)</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Trust Line</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        <span class="brutal-hero__trustline" style="font-size:0.9rem;" data-specimen
          >Trusted by PE firms managing $50B+ in assets</span
        >
        <code class="brand-code"
          >.brutal-hero__trustline — monospace, var(--text-muted), 500 weight</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Stats Bar</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        <div
          style="background:var(--color-primary);padding:var(--spacing-xl) var(--spacing-2xl);display:flex;gap:var(--spacing-3xl);"
        >
          <div style="text-align:center;">
            <div
              class="brutal-stat__value"
              style="font-size:2.5rem;font-weight:900;color:var(--bg-dark);line-height:1;margin-bottom:0.35rem;"
              data-specimen
            >
              51
            </div>
            <div
              class="brutal-stat__label"
              style="font-size:0.85rem;color:var(--bg-dark);font-weight:700;text-transform:uppercase;letter-spacing:0.15em;"
            >
              Projects
            </div>
          </div>
          <div style="text-align:center;">
            <div
              class="brutal-stat__value"
              style="font-size:2.5rem;font-weight:900;color:var(--bg-dark);line-height:1;margin-bottom:0.35rem;"
            >
              $2.4B+
            </div>
            <div
              class="brutal-stat__label"
              style="font-size:0.85rem;color:var(--bg-dark);font-weight:700;text-transform:uppercase;letter-spacing:0.15em;"
            >
              ARR Evaluated
            </div>
          </div>
        </div>
        <code class="brand-code"
          >.brutal-stat__value / .brutal-stat__label — monospace (pair with .stat-value/.stat-label
          for size/color)</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">CTA Box</h4>
    {
      /* TYPOGRAPHY specimen — sizes here are illustrative, deliberately smaller than
         production so the type relationship reads in a narrow column. Do NOT converge
         these on CTABox.astro. The specimen that shows the real thing is the CTA Box
         one under Layout Containers, which renders CTABox itself and so carries no
         sync obligation at all. */
    }
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <div
          style="border:2px solid var(--color-primary);padding:var(--spacing-2xl);max-width:500px;"
        >
          <div
            class="brutal-cta__title"
            style="font-size:1.75rem;font-weight:600;margin-bottom:var(--spacing-md);"
            data-specimen
          >
            Ready To Accelerate?
          </div>
          <div
            class="brutal-cta__description"
            style="font-size:var(--text-base);margin-bottom:var(--spacing-1_25);"
          >
            Schedule a confidential technology assessment for your next platform investment.
          </div>
          <a
            href="#ui-library"
            class="cta-button"
            style="font-size:0.85rem;padding:var(--spacing-md) var(--spacing-xl);"
            >BOOK_CALENDAR_SLOT()</a
          >
        </div>
        <code class="brand-code"
          >.brutal-cta__title — monospace, uppercase. .brutal-cta__description — monospace</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Announcement Sash</h4>
    {
      /* The first two render the REAL component (BL-095 AC-1), not a replica —
         Sash.astro with no `href` emits the decorative `aria-hidden` band, which
         is exactly what a specimen wants: no second link to /hub/mcp/ on this
         page and no analytics event on a specimen click. `--flat` has no
         component form (it is documentation-only and must never ship on a page),
         so that one is hand-written. */
    }
    <div class="brand-component-row">
      <div class="brand-component-item">
        <div class="brand-sash-frame">
          {
            /* The three MAIN-band segments (badge · label · detail) — a
              vocabulary demo, not the live entry, which lives in
              announcements.ts and currently uses no detail. The segments share
              one width budget; this frame is where a new combination is proven
              before it ships — see the table in Sash.astro. */
          }
          <Sash badge="New" label="MCP" detail="agents" />
        </div>
        <code class="brand-code"
          >.brutal-sash-corner &gt; .brutal-sash — 200px corner, --z-overlay. Segments: __badge
          (--sash-badge-bg chip, dark ink), __label (two type steps larger on this desktop page
          corner; one is the family default and the card corner keeps the band's base size),
          __detail. The band is --sash-bg on --sash-ink, always</code
        >
      </div>
      <div class="brand-component-item">
        <div class="brand-sash-frame brand-sash-frame--under">
          {
            /* Mirrors the live mcp-launch entry (announcements.ts) — minus the
              field hrefs, so the specimen stays decorative (the component
              renders spans, carrying the same __field class, when a field has
              no href). In production the main band is a link and each field is
              its own link to its own destination. */
          }
          <Sash
            badge="New"
            label="GST MCP"
            subtext={[{ text: 'Automate analysis' }, { text: 'Free pilot tier' }]}
          />
        </div>
        <code class="brand-code"
          >.brutal-sash-under — the OPTIONAL band below the main one (hidden 512–768px with
          __detail; the second line of the ≤511 strip). It is a LIST of rule-separated __field
          parts, spaced by --spacing-sm, and the band itself is inert: in production each field is
          its own link with its own destination, accessible name and analytics label, so the two
          halves go to different places. __field carries the min-height --touch-target-min-aa floor
          (the band inherits its thickness from it) and rides the same class as an &lt;a&gt; or a
          decorative &lt;span&gt;; the 7px gap to the main band is an axe target-size clearance —
          see sash.css. Inverted ink-on-band — the band's bg/ink pair swapped — the only colorway,
          because the family's mixes fail AA as text backgrounds (see sash.css). Its presence grows
          the corner box to 220px and widens the nav's reserve to match. Copy budget ~34 characters
          across all fields, and the rule plus its two gaps cost ~23px more per extra field — one
          ceiling on every engine, since the mono is pinned (Sash.astro)</code
        >
      </div>
      <div class="brand-component-item">
        <div class="brand-sash-frame brand-sash-frame--under">
          {
            /* Hand-written (the component cannot carry data-demo-state): a
              field's frozen hover — sash.css's 82% mix, poles swapped for the
              inverted fill. Forced-state rule lives in brand.astro's is:global
              block; axe excludes [data-demo-state="hover"]. Deliberately on ONE
              field: the fill landing on a single field is what shows the two
              are separate targets, which an all-spans band otherwise cannot. */
          }
          <div class="brutal-sash-corner">
            <span class="brutal-sash" aria-hidden="true">
              <span class="brutal-sash__badge">New</span>
              <span class="brutal-sash__label">GST MCP</span>
            </span>
            <span class="brutal-sash-under" aria-hidden="true"
              ><span class="brutal-sash-under__field" data-demo-state="hover"
                >Automate analysis</span
              ><span class="brutal-sash-under__rule">|</span><span class="brutal-sash-under__field"
                >Free pilot tier</span
              ></span
            >
          </div>
        </div>
        <code class="brand-code"
          >.brutal-sash-under__field:hover — background color-mix(in srgb, var(--sash-ink) 82%,
          var(--sash-bg)): the family's hover number, poles swapped for the inverted fill. The fill
          is per FIELD, not per band — two destinations need two affordances, and only the hovered
          field lights up. Focus ring: 2px var(--sash-bg), inset −4px, on the same field</code
        >
      </div>
      <div class="brand-component-item">
        <div class="brand-sash-frame brand-sash-frame--card">
          <Sash label="New" scale="card" />
        </div>
        <code class="brand-code"
          >.brutal-sash-corner--card — 104px corner, --z-raised, inside a card. Decorative: the card
          itself is the link</code
        >
      </div>
      <div class="brand-component-item">
        <span class="brutal-sash brutal-sash--flat" aria-hidden="true" data-specimen>
          <span class="brutal-sash__badge">New</span>
          <span class="brutal-sash__label">MCP</span>
          <span class="brutal-sash__detail">for AI agents</span>
        </span>
        <code class="brand-code"
          >.brutal-sash--flat — unrotated band, documentation only. Never mounted on a page (the
          ≤511px mobile strip is a media RESTYLE of the standard classes, not this modifier — a
          class cannot be toggled by a media query). All three segments shown; its label renders one
          step smaller than the production page band's (the --text-sm step is scoped to the corner).
          `.brutal-sash__detail` is hidden below 768px, and the segments share one width budget on
          the rotated band — see Sash.astro</code
        >
      </div>
    </div>

    <!-- 8a-1d. Legal Page Typography -->
    <h3 class="brutal-heading-sm brand-group-title" id="lib-legal">Legal Page Typography</h3>

    <h4 class="brutal-label brand-subgroup-title">Legal Page Heading</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <span
          style="font-size:2.5rem;font-weight:700;font-family:var(--font-family-mono);text-transform:uppercase;color:var(--text-primary);"
          data-specimen>Privacy Policy</span
        >
        <code class="brand-code">.legal-page-header h1 — monospace, 700 weight, uppercase</code>
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Legal Section Heading</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <span
          style="font-size:var(--text-2xl);font-weight:600;font-family:var(--font-family-mono);text-transform:uppercase;color:var(--text-primary);"
          data-specimen>Information We Collect</span
        >
        <code class="brand-code">.legal-page-body h2 — monospace, 600 weight, uppercase</code>
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Legal Body Text</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <p
          style="font-family:var(--font-family-mono);color:var(--text-secondary);line-height:1.8;margin:0;"
          data-specimen
        >
          GST is committed to protecting your privacy. This Privacy Policy explains how we collect,
          use, and safeguard information when you visit our website or engage with our services.
        </p>
        <code class="brand-code"
          >.legal-page-body — monospace, var(--text-secondary), 1.8 line-height</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Legal Contact Section</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <div
          style="padding:var(--spacing-xl);background:transparent;border-left:3px solid var(--color-primary);font-family:var(--font-family-mono);"
        >
          <span
            style="font-size:var(--text-xl);font-weight:600;text-transform:uppercase;color:var(--text-primary);display:block;margin-bottom:var(--spacing-sm);"
            data-specimen>Contact Us</span
          >
          <span style="color:var(--text-secondary);line-height:1.8;"
            >If you have questions about this policy, please contact us.</span
          >
        </div>
        <code class="brand-code"
          >.legal-contact-section — transparent bg, 3px primary left-border, monospace</code
        >
      </div>
    </div>

    <!-- 8a-1e. Homepage Sections -->
    <h3 class="brutal-heading-sm brand-group-title" id="lib-homepage">Homepage Sections</h3>

    <h4 class="brutal-label brand-subgroup-title">Trust Card</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        <div class="brand-hover-card" style="max-width:400px;" data-specimen>
          <div
            style="font-size:var(--text-lg);font-family:var(--font-family-mono);font-weight:var(--font-weight-bold);color:var(--text-primary);margin-bottom:var(--spacing-md);line-height:1.4;"
          >
            Independent, vendor-neutral guidance
          </div>
          <div
            style="font-size:var(--text-base);font-family:var(--font-family-mono);color:var(--text-secondary);line-height:1.7;"
          >
            No technology bias, no vendor relationships. Recommendations grounded in your strategic
            objectives.
          </div>
        </div>
        <code class="brand-code"
          >.trust-card — no radius, 2px border, transparent bg, primary-border on hover</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Engagement Step Card</h4>
    <div class="brand-component-row">
      <div class="brand-component-item">
        <div class="brand-hover-card" style="max-width:250px;text-align:center;" data-specimen>
          <div
            style="display:flex;flex-direction:column;align-items:center;gap:var(--spacing-sm);margin-bottom:var(--spacing-md);"
          >
            <svg
              viewBox="0 0 64 64"
              fill="none"
              style="width:4rem;height:4rem;color:var(--color-primary);"
              ><path
                d="M32 12 L52 52 L12 52 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="5.5"
                stroke-linejoin="miter"></path><text
                x="32"
                y="40"
                text-anchor="middle"
                dominant-baseline="middle"
                style="font-size:1.28rem;font-family:var(--font-family-mono);font-weight:700;fill:var(--text-primary);"
                >1</text
              ></svg
            >
            <span
              style="font-size:var(--text-sm);font-family:var(--font-family-mono);font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;"
              >Align</span
            >
          </div>
          <div
            style="font-size:var(--text-base);font-family:var(--font-family-mono);color:var(--text-primary);line-height:1.6;"
          >
            Clarify objectives, context, and constraints
          </div>
        </div>
        <code class="brand-code"
          >.step — no radius, 2px border, transparent bg, monospace labels, primary-border on hover</code
        >
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Section Heading (Homepage)</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <span
          style="font-size:var(--text-3xl);font-weight:var(--font-weight-bold);font-family:var(--font-family-mono);text-transform:uppercase;color:var(--text-primary);"
          data-specimen>Why Clients Trust GST</span
        >
        <code class="brand-code">.heading-lg (homepage) — monospace, uppercase, bold</code>
      </div>
    </div>

    <h4 class="brutal-label brand-subgroup-title">Delta Bullet List</h4>
    <div class="brand-component-row">
      <div class="brand-component-item brand-component-item--full">
        <ul
          style="list-style:none;display:flex;flex-direction:column;gap:var(--gap-wide);padding:0;margin:0;"
        >
          <li style="display:flex;align-items:center;gap:var(--spacing-lg);">
