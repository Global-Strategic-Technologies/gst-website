---
/**
 * The palette panel's Ambient Motion section body (BL-035, ADR-0039).
 *
 * Rendered by PalettePanel.astro inside its own `.palette-panel__section`
 * wrapper, on /brand only. Toggles and tunes the hero effect layer
 * (AmbientEffect.astro) through src/scripts/ambient-motion.ts; what is chosen
 * is saved for this browser under localStorage['ambient-motion'], separate
 * from colour edits, so neither Reset clears the other.
 *
 * The chips are `.brutal-filter-chip`, which lives in filter.css — a sheet
 * split out of global.css and imported by brand.astro, the only page that
 * renders this section. Moving the section to another page means importing
 * filter.css there too.
 */
import DeltaIcon from '../DeltaIcon.astro';
import { DEFAULT_STRENGTH, EFFECTS, PACE, STRENGTH } from '../../scripts/ambient-motion';
---

<div id="ambient-controls" data-testid="ambient-controls">
  <div class="brutal-filter-chips" role="group" aria-labelledby="ambient-controls-title">
    {
      EFFECTS.map((e) => (
        <button
          type="button"
          class="brutal-filter-chip"
          aria-pressed="false"
          data-ambient-effect={e.id}
          data-testid={`ambient-chip-${e.id}`}
        >
          {e.label}
        </button>
      ))
    }
  </div>

  <div class="ambient-controls__rows">
    {
      EFFECTS.map((e) => (
        <div class="ambient-controls__row">
          <label class="brutal-slider__label" for={`ambient-strength-${e.id}`}>
            {e.label}
          </label>
          <input
            id={`ambient-strength-${e.id}`}
            type="range"
            class="brutal-slider__input"
            min={STRENGTH.min}
            max={STRENGTH.max}
            step={STRENGTH.step}
            value={DEFAULT_STRENGTH[e.id]}
            disabled
            data-ambient-strength={e.id}
            data-testid={`ambient-strength-${e.id}`}
          />
          <span class="brutal-slider__value" data-ambient-value={e.id}>
            {DEFAULT_STRENGTH[e.id]}%
          </span>
        </div>
      ))
    }
  </div>

  <div class="brutal-slider ambient-controls__pace">
    <div class="brutal-slider__header">
      <label class="brutal-slider__label" for="ambient-pace">Pace · all effects</label>
      <span class="brutal-slider__value" id="ambient-pace-value">{PACE.default}%</span>
    </div>
    <input
      id="ambient-pace"
      type="range"
      class="brutal-slider__input"
      min={PACE.min}
      max={PACE.max}
      step={PACE.step}
      value={PACE.default}
      disabled
      data-testid="ambient-pace"
    />
    <div class="ambient-controls__scale" aria-hidden="true">
      <span>Slower</span><span>Faster</span>
    </div>
  </div>

  <p class="ambient-controls__note">
    <DeltaIcon size={12} />
    <span>
      <strong>Reduced motion wins.</strong> A system set to reduce motion switches every effect off, whatever
      is chosen here. Colour follows the palette.
    </span>
  </p>

  <div class="ambient-controls__foot">
    <span class="ambient-controls__state" id="ambient-state" aria-live="polite"
      >Nothing on — the hero stays still</span
    >
    <button
      type="button"
      class="brutal-btn brutal-btn--secondary ambient-controls__reset"
      id="ambient-reset"
      data-testid="ambient-reset"
      title="Switch every effect off and restore the default strengths and pace"
      >Reset motion</button
    >
  </div>
</div>

<style>
  .ambient-controls__rows {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--border-light);
  }

  /* label | range | value — the .brutal-slider parts laid out on one line */
  .ambient-controls__row {
    display: grid;
    grid-template-columns: 8rem 1fr 3rem;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .ambient-controls__row .brutal-slider__value {
    text-align: right;
  }

  /* An effect that is off keeps its row (so nothing jumps when a chip is
     toggled) but reads as inactive. Neither .brutal-slider* nor the chip has
     a disabled style of its own. Only the track dims: dimming the whole row
     took the teal value to 1.37:1, so the value turns muted instead, which
     holds AA at full opacity. */
  .ambient-controls__row :disabled,
  .ambient-controls__pace :disabled {
    opacity: 0.4;
    transition: opacity var(--transition-fast);
  }

  .ambient-controls__row:has(:disabled) .brutal-slider__value,
  .ambient-controls__pace:has(:disabled) .brutal-slider__value {
    color: var(--text-muted);
  }

  .ambient-controls__row:has(:disabled) .brutal-slider__label,
  .ambient-controls__pace:has(:disabled) .brutal-slider__label,
  .brutal-slider__input:disabled {
    cursor: not-allowed;
  }

  .ambient-controls__pace {
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--border-light);
  }

  .ambient-controls__scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-family-mono);
    font-size: var(--text-2xs);
    color: var(--text-muted);
  }

  .ambient-controls__note {
    display: flex;
    gap: var(--spacing-sm);
    align-items: flex-start;
    margin: var(--spacing-md) 0 0;
    padding: var(--spacing-sm);
    border-left: 3px solid var(--color-primary);
    background: var(--accent-light-bg);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .ambient-controls__note :global(svg) {
    margin-top: 2px;
    color: var(--color-primary);
  }

  .ambient-controls__note strong {
    color: var(--text-primary);
  }

  .ambient-controls__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-sm);
  }

  .ambient-controls__state {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* The size of the panel header's colour Reset, which is scoped to
     PalettePanel.astro and so cannot be borrowed here. */
  .ambient-controls__reset {
    flex-shrink: 0;
    font-size: var(--text-xs);
    padding: var(--spacing-xs) var(--spacing-md);
  }

  @media (max-width: 768px) {
    .ambient-controls__row {
      grid-template-columns: 6.5rem 1fr 2.75rem;
    }
  }
</style>

<script>
  import * as Sentry from '@sentry/browser';
  import {
    applySettings,
    defaultSettings,
    EFFECT_IDS,
    parseSettings,
    serializeSettings,
    STORAGE_KEY,
    type AmbientSettings,
    type EffectId,
  } from '../../scripts/ambient-motion';

  function readSettings(): AmbientSettings {
    try {
      return parseSettings(localStorage.getItem(STORAGE_KEY));
    } catch {
      return defaultSettings();
    }
  }

  function persist(s: AmbientSettings | null): void {
    try {
      if (s) localStorage.setItem(STORAGE_KEY, serializeSettings(s));
      else localStorage.removeItem(STORAGE_KEY);
    } catch {
      Sentry.addBreadcrumb({
        category: 'ambient-motion',
        message: 'localStorage write failed',
        level: 'warning',
      });
    }
  }

  function init(): void {
    const section = document.getElementById('ambient-controls');
    if (!section) return;

    let settings = readSettings();
    const chips = section.querySelectorAll<HTMLButtonElement>('[data-ambient-effect]');
    const strengths = section.querySelectorAll<HTMLInputElement>('[data-ambient-strength]');
    const pace = section.querySelector<HTMLInputElement>('#ambient-pace');
    const paceValue = section.querySelector<HTMLElement>('#ambient-pace-value');
    const state = section.querySelector<HTMLElement>('#ambient-state');
    const reset = section.querySelector<HTMLButtonElement>('#ambient-reset');

    function render(): void {
      chips.forEach((chip) => {
        const on = settings.on.includes(chip.dataset.ambientEffect as EffectId);
        chip.setAttribute('aria-pressed', String(on));
        chip.classList.toggle('brutal-filter-chip--active', on);
      });
      strengths.forEach((input) => {
        const id = input.dataset.ambientStrength as EffectId;
        input.value = String(settings.strength[id]);
        input.disabled = !settings.on.includes(id);
        const label = section!.querySelector(`[data-ambient-value="${id}"]`);
        if (label) label.textContent = `${settings.strength[id]}%`;
      });
      if (pace) {
        pace.value = String(settings.pace);
        pace.disabled = settings.on.length === 0;
      }
      if (paceValue) paceValue.textContent = `${settings.pace}%`;
      if (state) {
        state.textContent = settings.on.length
          ? `${settings.on.length} of ${EFFECT_IDS.length} on · saved for this browser`
          : 'Nothing on — the hero stays still';
      }
    }

    function commit(): void {
      applySettings(document.documentElement, settings);
      persist(settings);
      render();
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.ambientEffect as EffectId;
        const next = new Set(settings.on);
        if (next.has(id)) next.delete(id);
        else next.add(id);
        settings.on = EFFECT_IDS.filter((x) => next.has(x));
        commit();
      });
    });

    strengths.forEach((input) => {
      input.addEventListener('input', () => {
        settings.strength[input.dataset.ambientStrength as EffectId] = Number(input.value);
        commit();
      });
    });

    pace?.addEventListener('input', () => {
      settings.pace = Number(pace.value);
      commit();
    });

    reset?.addEventListener('click', () => {
      settings = defaultSettings();
      applySettings(document.documentElement, settings);
      // Forget the choice rather than store the default, so a public default
      // shipped later reaches this browser too.
      persist(null);
      render();
    });

    render();
    section.dataset.ready = 'true';
  }

  init();
</script>
