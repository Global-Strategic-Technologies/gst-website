---
// WhatWeDo section - displays core service offerings with SVG bullet indicators
// Copy comes from the `home` catalog (BL-153); `locale` defaults to English.
import DeltaIcon from './DeltaIcon.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const { t } = useTranslations(locale, 'home');
---

<section class="what-we-do" aria-label={t('whatWeDo.ariaLabel')}>
  <div class="container">
    <div class="services-content">
      <h2 class="brutal-heading-lg">{t('whatWeDo.heading')}</h2>
      <p class="intro-text">{t('whatWeDo.intro')}</p>

      <ul class="services-list">
        <li>
          <span>{t('whatWeDo.item1')}</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>{t('whatWeDo.item2')}</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>{t('whatWeDo.item3')}</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>{t('whatWeDo.item4')}</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>{t('whatWeDo.item5')}</span>
          <DeltaIcon class="bullet-icon" />
        </li>
      </ul>

      <p class="closing-text">{t('whatWeDo.closing')}</p>
    </div>
  </div>
</section>

<style>
  /* Component styles following design system patterns */
  .what-we-do {
    padding: var(--spacing-3xl) 0;
    background: transparent;
    position: relative;
  }

  .services-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: right;
  }

  .brutal-heading-lg {
    margin-bottom: var(--spacing-xl);
  }

  .intro-text {
    font-size: var(--text-lg);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-2xl);
    line-height: 1.7;
  }

  .services-list {
    list-style: none;
    margin-bottom: var(--spacing-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-wide);
  }

  .services-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-lg);
    justify-content: flex-end;
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* Inherits `text-align: right` from `.services-content` — deliberately NOT
     overridden. See the `::after` note below for why the marker moved
     instead. */
  .closing-text {
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.8;
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
    border-top: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  /* `::after`, where `WhoWeSupport.astro`'s twin rule uses `::before`. That is
     the mirror, not a divergence: this section is right-aligned and its delta
     bullets trail, so the marker belongs on the RIGHT edge. Leading it here
     stranded `//` mid-line at every width where this paragraph wraps, and it
     wraps at phone widths and in narrow desktop windows — it reaches a single
     line from around the small-tablet range up, so common tablet widths (768
     and above) are NOT affected. No exact boundary is quoted on purpose: it is
     a function of the computed font size, and `.closing-text`'s own responsive
     step-down is currently inert (see BL-147), so any figure written here
     would be measuring a bug rather than a design. Anchoring the marker to the
     alignment edge is what makes the two sections read as a pair, and that
     holds at every width regardless.

     The NBSP is load-bearing, and this one IS worth a number. With a plain
     space the marker is its own wrap opportunity, so `//` lands alone on the
     last line, right-aligned under the sentence — at 58 distinct viewport
     widths between 320 and 662. `\00a0` binds it to the final word: zero.
     (Chromium, production build, 1px sweep, 2026-09-01.) */
  .closing-text::after {
    content: '\00a0//';
    color: var(--color-primary);
    font-weight: 900;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .what-we-do {
      padding: var(--spacing-2xl) 0;
    }

    .intro-text {
      font-size: var(--text-base);
      margin-bottom: var(--spacing-xl);
    }

    .services-list {
      gap: var(--gap-normal);
    }

    .services-list li span {
      font-size: var(--text-small);
    }

    .closing-text {
      font-size: var(--text-small);
    }
  }

  @media (max-width: 480px) {
    .what-we-do {
      padding: var(--spacing-xl) 0;
    }

    .services-list li {
      gap: var(--spacing-md);
    }
  }
</style>
