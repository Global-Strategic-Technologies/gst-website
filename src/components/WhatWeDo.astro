---
// WhatWeDo section - displays core service offerings with SVG bullet indicators
import DeltaIcon from './DeltaIcon.astro';
---

<section class="what-we-do" aria-label="What we do">
  <div class="container">
    <div class="services-content">
      <h2 class="brutal-heading-lg">What We Do</h2>
      <p class="intro-text">
        GST unlocks enterprise value through expert business technology advisory.
      </p>

      <ul class="services-list">
        <li>
          <span>Buy-side and sell-side technical diligence</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>Architecture and platform assessments</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>Security, compliance, and operational risk evaluation</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>Product development and execution roadmaps</span>
          <DeltaIcon class="bullet-icon" />
        </li>
        <li>
          <span>Independent advisory for executives and boards</span>
          <DeltaIcon class="bullet-icon" />
        </li>
      </ul>

      <p class="closing-text">Clear findings. Decision-ready outputs. Practical next steps.</p>
    </div>
  </div>
</section>

<style>
  /* Component styles following design system patterns */
  .what-we-do {
    padding: var(--spacing-3xl) 0;
    background: transparent;
    position: relative;
  }

  .services-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: right;
  }

  .brutal-heading-lg {
    margin-bottom: var(--spacing-xl);
  }

  .intro-text {
    font-size: var(--text-lg);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-2xl);
    line-height: 1.7;
  }

  .services-list {
    list-style: none;
    margin-bottom: var(--spacing-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-wide);
  }

  .services-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-lg);
    justify-content: flex-end;
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* Inherits `text-align: right` from `.services-content` — deliberately NOT
     overridden. See the `::after` note below for why the marker moved
     instead. */
  .closing-text {
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.8;
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
    border-top: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  /* `::after`, where `WhoWeSupport.astro`'s twin rule uses `::before`. That is
     the mirror, not a divergence: this section is right-aligned and its delta
     bullets trail, so the marker belongs on the RIGHT edge. Leading it here
     stranded `//` mid-line at every width where this paragraph wraps, and it
     wraps at every phone and tablet width — it reaches a single line only on
     desktop. No exact boundary is quoted on purpose: it is a function of the
     computed font size, and `.closing-text`'s own responsive step-down is
     currently inert (see BL-147), so any figure written here would be
     measuring a bug rather than a design. Anchoring the marker to the
     alignment edge is what makes the two sections read as a pair, and that
     holds at every width regardless.

     The NBSP is load-bearing, and this one IS worth a number. With a plain
     space the marker is its own wrap opportunity, so `//` lands alone on the
     last line, right-aligned under the sentence — at 58 distinct viewport
     widths between 320 and 662. `\00a0` binds it to the final word: zero.
     (Chromium, production build, 1px sweep, 2026-09-01.) */
  .closing-text::after {
    content: '\00a0//';
    color: var(--color-primary);
    font-weight: 900;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .what-we-do {
      padding: var(--spacing-2xl) 0;
    }

    .intro-text {
      font-size: var(--text-base);
      margin-bottom: var(--spacing-xl);
    }

    .services-list {
      gap: var(--gap-normal);
    }

    .services-list li span {
      font-size: var(--text-small);
    }

    .closing-text {
      font-size: var(--text-small);
    }
  }

  @media (max-width: 480px) {
    .what-we-do {
      padding: var(--spacing-xl) 0;
    }

    .services-list li {
      gap: var(--spacing-md);
    }
  }
</style>
