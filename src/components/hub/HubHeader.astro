---
/**
 * Shared header for Hub section pages (Radar, Library, Tools).
 * Title, subtitle, optional timestamp — matches GST design language.
 * Breadcrumb navigation is handled site-wide by Breadcrumb.astro in BaseLayout.
 */
interface Props {
  /** Display name shown as page title */
  title: string;
  /**
   * Brief description shown below the title. Optional because a page can pass
   * a `subtitle` named slot instead (the slot wins) when the lede needs inline
   * markup — a prop string is always escaped, so an anchor cannot ride in it.
   */
  subtitle?: string;
  /** Whether to show a "last updated" timestamp (default: false) */
  showTimestamp?: boolean;
}

const { title, subtitle, showTimestamp = false } = Astro.props;

let dateStr = '';
if (showTimestamp) {
  const now = new Date();
  dateStr = now.toLocaleDateString('en-US', {
    timeZone: 'America/Santiago',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
}
---

<header class="hub-header">
  <h1 class="hub-header__title brutal-heading-xl">{title}</h1>
  <p class="hub-header__subtitle"><slot name="subtitle">{subtitle}</slot></p>
  {showTimestamp && <p class="hub-header__updated">Updated {dateStr}</p>}
</header>

<style>
  /* The space below the subtitle is the padding ALONE. It used to be padding
     plus an equal margin — the same job done twice — which put 64px of dead
     band between a two-line lede and the body copy that continues it, on every
     page in the Hub. 32px is what the `/hub/mcp/*` guide family already
     overrides this component to, so collapsing to it makes the two families
     agree rather than inventing a third number. The responsive steps below
     scale it: 24px at 768, 16px at 480. */
  .hub-header {
    padding: var(--spacing-3xl) 0 var(--spacing-2xl);
  }

  .hub-header__title {
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hub-header__subtitle {
    font-size: var(--text-lg);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    max-width: 720px;
    line-height: 1.6;
  }

  .hub-header__updated {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    font-style: italic;
    color: var(--text-muted);
    margin-top: var(--spacing-sm);
  }

  @media (max-width: 768px) {
    .hub-header {
      padding: var(--spacing-2xl) 0 var(--spacing-xl);
    }

    .hub-header__title {
      font-size: var(--text-2xl);
    }
  }

  @media (max-width: 480px) {
    .hub-header {
      padding: var(--spacing-xl) 0 var(--spacing-lg);
    }

    .hub-header__title {
      font-size: var(--text-xl);
    }

    .hub-header__subtitle {
      font-size: var(--text-base);
    }
  }
</style>
