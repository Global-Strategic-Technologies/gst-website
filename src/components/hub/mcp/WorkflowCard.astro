---
/**
 * One card in the Workflows lens: what the workflow is for, and the ordered
 * steps that run it. Each step links into the Reference lens at that
 * capability's contract, which is the whole point of the two-lens page.
 *
 * Steps are anchors, not the prototype's buttons: a step is an address, it
 * works without JS, and `:target` does the reveal.
 */
import type { Workflow } from '../../../data/mcp/capabilities';
import { capabilityAnchor } from '../../../utils/mcp-capability-search';

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
---

<article class="mdoc-flow">
  <div class="mdoc-flow__intro">
    <h3 class="mdoc-flow__title">{workflow.title}</h3>
    <p class="brutal-text-small mdoc-flow__desc">{workflow.description}</p>
  </div>
  <div class="mdoc-flow__steps">
    {
      workflow.steps.map((step, index) => (
        <a class="mdoc-step" href={`#${capabilityAnchor(step.capabilityId)}`}>
          <span class="brutal-label-small mdoc-step__label">
            {String(index + 1).padStart(2, '0')} · {step.kind}
          </span>
          <span class="mdoc-step__id">{step.capabilityId}</span>
          <span class="brutal-text-tiny mdoc-step__gloss">{step.gloss}</span>
        </a>
      ))
    }
  </div>
</article>

<style>
  /* The intro column is 260px rather than the design's 300px: those 40px buy a
     COLUMN at 1440px, not a few pixels. At 260px the steps grid is 920px, 8px
     more than the 912px three tracks need (3 × 296 + 2 × 12); at 300px it is
     880px and the grid drops to two. On the widest mono the id then sits ~17px
     inside its track at 1440. (This sentence used to say 1280px; since the
     track floor below was raised, 1280 is two tracks by design and 1440 is the
     width the 40px defends.) A title and a one-line description do not need
     the extra. */
  /* Frosted, on the same tokens as `.brutal-option-card` — the in-repo precedent
     for a bordered card that carries the treatment. The frost lives on the CARD,
     not on `.mdoc-step`: the steps sit over it and a `backdrop-filter` of their
     own would blur an already-blurred backdrop (STYLES_GUIDE § Frosted Glass). */
  .mdoc-flow {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--spacing-2xl);
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    padding: var(--spacing-xl);
    background: var(--surface-subtle-bg);
    backdrop-filter: blur(2px);
    box-shadow:
      inset 0 1px 0 var(--frost-highlight),
      0 0 0 1px var(--frost-edge);
  }

  .mdoc-flow__title {
    font-family: var(--font-family-mono);
    font-size: var(--text-lg);
    margin: 0 0 var(--spacing-sm);
  }

  .mdoc-flow__desc {
    color: var(--text-secondary);
    margin: 0;
  }

  /* Auto-fit rather than a fixed three columns, with a track wide enough for the
     longest capability name. Three equal `1fr` tracks gave each step 285px
     including 15px of chrome, and `assess_infrastructure_cost_governance`
     rendered at 285px on its own AT THE SIZE IT THEN USED, so every desktop
     width wrapped it (and most other identifiers between 769px and 1200px).
     At today's `--text-xs` it measures 244px on this machine's default mono
     and 267px on the widest face available here — the pair the floor below is
     sized from. Dropping to two tracks and then
     one is the graceful failure; splitting a wire identifier across two lines,
     which reads as two steps, is not. */
  .mdoc-flow__steps {
    display: grid;
    /* The floor is the id's INTRINSIC minimum, not a width that happens to
       pass: an auto-fit track equals its floor exactly at every column-add
       threshold, so a floor below that minimum leaves narrow bands where the
       id overflows its own track even though the sampled widths are clean.
       18.5rem = 296px against 267px of ink plus 15px of chrome — ~14px clear at
       ANY width. 17rem was the CI failure: it still fitted three tracks at 1280
       while a track could not hold the id, so it squeezed instead of dropping a
       column. 17.5rem fixed the sampled widths but left bands at ~1305 and
       ~1012 still 1px over. Column counts at 18.5rem: three at 1440, two at
       1280, one at and below 1024.

       That 267px was measured against the widest mono any engine here resolved
       the bare `monospace` generic to, because the face was whatever the OS
       chose. BL-144 pinned it, and the pinned face's 600/1000 advance IS that
       widest case — so the floor that was a worst-case guess is now the exact
       figure, and the engine-to-engine spread this floor was buying headroom
       against is gone. Left as is: it is correct and no longer speculative. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.5rem), 1fr));
    gap: var(--spacing-md);
  }

  .mdoc-step {
    display: block;
    text-decoration: none;
    border-left: 3px solid var(--color-primary);
    padding: 4px 0 4px var(--spacing-md);
    min-height: var(--touch-target-min);
    transition: background var(--transition-fast);
  }

  .mdoc-step:hover {
    background: var(--accent-faint-bg);
  }

  .mdoc-step__label {
    display: block;
    color: var(--text-muted);
  }

  /* One identifier, one line, at the same size the Reference sidebar uses for
     the same identifiers. It does NOT shrink to fit: at `--text-2xs` the id
     would render smaller than its own gloss and the card's hierarchy would
     invert, so the track above is what yields instead. Below 768px the line
     rule yields too — see the media block at the foot of this file for why
     wrapping beats the alternatives there.
     Margins for the longest id on the widest mono measured here, by width:
     1440 ~17px (three across), 1280 ~133px (two), 1024 ~303px (one). The
     floor above is what guarantees the worst case (~14px) at widths nobody
     sampled; tests/e2e/hub-mcp-docs.test.ts checks eight of them, including
     the two bands the previous floor left over. */
  .mdoc-step__id {
    display: block;
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    color: var(--color-primary);
    white-space: nowrap;
  }

  .mdoc-step__gloss {
    display: block;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    /* minmax(0, 1fr), not 1fr: a bare 1fr is minmax(auto, 1fr), so the track is
       floored at its content's min-content — here the nowrap wire id — and the
       grid grows past its container instead of the id overflowing its own track.
       At 320px that put both rows 57px off-screen (`assess_infrastructure_cost_
       governance` is 266px of ink against 224px of usable width, so nothing that
       keeps the id on one line at full size can fit it there). Same blowout, and
       the same fix, as `.stats-grid` in StatsBar.astro. */
    .mdoc-flow {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-md);
    }

    .mdoc-flow__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    /* With the track capped, the longest id is wider than the narrowest phones.
       The doctrine above says the id neither splits nor shrinks, which left
       scrolling as the only way to keep it whole — and that was tried and
       reversed: `overflow: auto` makes this a scroll container, and axe rates a
       scrollable region with no keyboard access `scrollable-region-focusable`,
       SERIOUS, which this repo does not carry. The usual remedy is
       `tabindex="0"`, but this element sits INSIDE the step's `<a>`, so it would
       put a tab stop within a link on every step of every workflow.

       So the doctrine yields here, and only here. Below 768px a step is a
       full-width block with its label above it and its gloss below, so an id
       wrapped onto a second line still reads as one id — the "reads as two
       steps" failure the doctrine guards against is a symptom of the
       side-by-side desktop layout, which does not exist at this width.
       `anywhere` rather than `break-word` so the id also stops contributing its
       full width to min-content sizing. */
    .mdoc-step__id {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>
