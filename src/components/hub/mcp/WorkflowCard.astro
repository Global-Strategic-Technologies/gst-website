---
/**
 * One card in the Workflows lens: what the workflow is for, and the ordered
 * steps that run it. Each step links into the Reference lens at that
 * capability's contract, which is the whole point of the two-lens page.
 *
 * Steps are anchors, not the prototype's buttons: a step is an address, it
 * works without JS, and `:target` does the reveal.
 */
import type { Workflow } from '../../../data/mcp/capabilities';
import { capabilityAnchor } from '../../../utils/mcp-capability-search';

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
---

<article class="mdoc-flow">
  <div class="mdoc-flow__intro">
    <h3 class="mdoc-flow__title">{workflow.title}</h3>
    <p class="brutal-text-small mdoc-flow__desc">{workflow.description}</p>
  </div>
  <div class="mdoc-flow__steps">
    {
      workflow.steps.map((step, index) => (
        <a class="mdoc-step" href={`#${capabilityAnchor(step.capabilityId)}`}>
          <span class="brutal-label-small mdoc-step__label">
            {String(index + 1).padStart(2, '0')} · {step.kind}
          </span>
          <span class="mdoc-step__id">{step.capabilityId}</span>
          <span class="brutal-text-tiny mdoc-step__gloss">{step.gloss}</span>
        </a>
      ))
    }
  </div>
</article>

<style>
  /* The intro column is 260px rather than the design's 300px: those 40px are
     what keep three step tracks at 1440px — measured on the widest mono, 260px
     leaves the longest wire id ~17px inside its track there and 300px leaves
     ~4px. (This sentence used to say 1280px; since the track floor below was
     raised, 1280 is two tracks by design and 1440 is the width the 40px
     defends.) A title and a one-line description do not need the extra. */
  /* Frosted, on the same tokens as `.brutal-option-card` — the in-repo precedent
     for a bordered card that carries the treatment. The frost lives on the CARD,
     not on `.mdoc-step`: the steps sit over it and a `backdrop-filter` of their
     own would blur an already-blurred backdrop (STYLES_GUIDE § Frosted Glass). */
  .mdoc-flow {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--spacing-2xl);
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    padding: var(--spacing-xl);
    background: var(--surface-subtle-bg);
    backdrop-filter: blur(2px);
    box-shadow:
      inset 0 1px 0 var(--frost-highlight),
      0 0 0 1px var(--frost-edge);
  }

  .mdoc-flow__title {
    font-family: var(--font-family-mono);
    font-size: var(--text-lg);
    margin: 0 0 var(--spacing-sm);
  }

  .mdoc-flow__desc {
    color: var(--text-secondary);
    margin: 0;
  }

  /* Auto-fit rather than a fixed three columns, with a track wide enough for the
     longest capability name. Three equal `1fr` tracks gave each step 285px
     including 15px of chrome, and `assess_infrastructure_cost_governance`
     rendered at 285px on its own AT THE SIZE IT THEN USED, so every desktop
     width wrapped it (and most other identifiers between 769px and 1200px).
     At today's `--text-xs` it measures 244px on this machine's default mono
     and 267px on the widest face available here — the pair the floor below is
     sized from. Dropping to two tracks and then
     one is the graceful failure; splitting a wire identifier across two lines,
     which reads as two steps, is not. */
  .mdoc-flow__steps {
    display: grid;
    /* The floor is the id's INTRINSIC minimum, not a width that happens to
       pass: an auto-fit track equals its floor exactly at every column-add
       threshold, so a floor below that minimum leaves narrow bands where the
       id overflows its own track even though the sampled widths are clean.
       18.5rem = 296px against 267px of ink (the widest mono available here,
       ~22px wider over `assess_infrastructure_cost_governance` than this
       machine's default face) plus 15px of chrome — ~14px clear at ANY width.
       17rem was the CI failure: it still fitted three tracks at 1280 while a
       track could not hold the id, so it squeezed instead of dropping a
       column. 17.5rem fixed the sampled widths but left bands at ~1305 and
       ~1012 still 1px over. Column counts at 18.5rem: three at 1440, two at
       1280, one at and below 1024. `--font-family-mono` being the bare
       `monospace` generic is why any of this is engine-dependent — BL-144. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.5rem), 1fr));
    gap: var(--spacing-md);
  }

  .mdoc-step {
    display: block;
    text-decoration: none;
    border-left: 3px solid var(--color-primary);
    padding: 4px 0 4px var(--spacing-md);
    min-height: var(--touch-target-min);
    transition: background var(--transition-fast);
  }

  .mdoc-step:hover {
    background: var(--accent-faint-bg);
  }

  .mdoc-step__label {
    display: block;
    color: var(--text-muted);
  }

  /* One identifier, one line, at the same size the Reference sidebar uses for
     the same identifiers. It does NOT shrink to fit: at `--text-2xs` the id
     would render smaller than its own gloss and the card's hierarchy would
     invert, so the track above is what yields instead.
     Margins for the longest id on the widest mono measured here, by width:
     1440 ~17px (three across), 1280 ~133px (two), 1024 ~303px (one). The
     floor above is what guarantees the worst case (~14px) at widths nobody
     sampled; tests/e2e/hub-mcp-docs.test.ts checks six of them, including the
     two bands the previous floor left over. */
  .mdoc-step__id {
    display: block;
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    color: var(--color-primary);
    white-space: nowrap;
  }

  .mdoc-step__gloss {
    display: block;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .mdoc-flow {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .mdoc-flow__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
