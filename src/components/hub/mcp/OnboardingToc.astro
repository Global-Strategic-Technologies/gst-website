---
/**
 * Sticky horizontal in-page nav for the MCP onboarding pages.
 *
 * Each link targets a `[data-section]` section by id; the shared scroll-spy
 * (src/utils/scroll-spy.ts, also behind TableOfContents.astro) marks the last
 * section past the 100px threshold with `.is-active`, styled here — active
 * state is a class, never JS-written inline styles.
 */
interface TocLink {
  /** Section id the link targets (no leading #). */
  id: string;
  /** Visible label, e.g. "01 Before you start". */
  label: string;
}

interface Props {
  links: TocLink[];
}

const { links } = Astro.props;
---

<nav aria-label="On this page" class="onboarding-toc" data-onboarding-toc>
  {
    links.map((link) => (
      <a href={`#${link.id}`} data-toc-link={link.id}>
        <span>{link.label}</span>
      </a>
    ))
  }
</nav>

<script>
  import { initScrollSpy } from '../../../utils/scroll-spy';

  document.querySelectorAll<HTMLElement>('[data-onboarding-toc]').forEach((nav) => {
    initScrollSpy(nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'), {
      threshold: 100,
    });
  });
</script>

<style>
  .onboarding-toc {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--bg-light);
    border-bottom: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    margin-bottom: var(--spacing-2xl);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--spacing-xl);
  }

  .onboarding-toc a {
    color: inherit;
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: var(--touch-target-min);
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
  }

  .onboarding-toc a span {
    font-family: var(--font-family-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
  }

  .onboarding-toc a.is-active {
    border-bottom-color: var(--color-primary);
  }

  /* Tertiary, not primary: the label is 10.4px text, and #05cd99 on the light
     background is 2.05:1 (axe serious). --color-tertiary is the design
     system's teal-for-text token — dark teal in light theme, #05cd99 in dark,
     so the dark-theme look matches the design exactly. The border above keeps
     the primary accent in both themes. */
  .onboarding-toc a.is-active span {
    color: var(--color-tertiary);
    font-weight: var(--font-weight-semibold);
  }
</style>
