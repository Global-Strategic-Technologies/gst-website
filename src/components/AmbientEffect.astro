---
/**
 * Hero ambient motion (BL-035, ADR-0039) — a decorative, CSS-only effect layer.
 *
 * Renders all five effect layers, each `display: none` until <html> names it
 * in `data-ambient` (set before first paint by BaseLayout's init script, and
 * live by the /brand palette panel — src/scripts/ambient-motion.ts). A layer
 * that is off is never rendered, so it costs nothing. No JS animates anything:
 * transform/opacity keyframes only, so every frame stays on the compositor.
 *
 * Budget: at most 15 animated elements on screen, whatever is chosen. One
 * effect alone shows its full table (≤14); with two or more on, or at ≤768px,
 * the `solo` elements hide — src/data/ambient-effects.ts owns the tables and
 * tests/unit/ambient-effect-budget.test.ts the arithmetic.
 *
 * The parent must be `position: relative`; content that should sit above the
 * layer needs its own stacking (the global `.container` rule already has it).
 */
import DeltaIcon from './DeltaIcon.astro';
import { DELTAS, GRID_CELLS, GRID_DURATION, RAILS } from '../data/ambient-effects';

const solo = (isSolo: boolean) => (isSolo ? ' ambient__el--solo' : '');
const vertical = (dir: string) => dir === 'up' || dir === 'down';
---

<div class="ambient" aria-hidden="true">
  <div class="ambient__layer ambient__layer--grid">
    {
      GRID_CELLS.map((c) => (
        <span
          class={`ambient__cell${solo(c.solo)}`}
          style={`--x: ${c.x}%; --y: ${c.y}%; --d: ${GRID_DURATION}; --o: ${c.delay};`}
        />
      ))
    }
  </div>

  <div class="ambient__layer ambient__layer--glow">
    <span class="ambient__glow ambient__glow--a"></span>
    <span class="ambient__glow ambient__glow--b"></span>
  </div>

  <div class="ambient__layer ambient__layer--scan">
    <span class="ambient__scan"></span>
  </div>

  <div class="ambient__layer ambient__layer--rails">
    {
      RAILS.map((r) => (
        <span
          class={`ambient__rail ambient__rail--${vertical(r.dir) ? 'v' : 'h'}${solo(r.solo)}`}
          style={`--pos: ${r.pos}%; --w: ${r.rail}px; --tint: ${r.tint};`}
        >
          <span
            class={`ambient__mark ambient__mark--${r.dir}`}
            style={`--len: ${r.len}px; --thick: ${r.thick}px; --pk: ${r.peak}; --d: ${r.duration}; --o: ${r.offset};`}
          />
        </span>
      ))
    }
  </div>

  <div class="ambient__layer ambient__layer--deltas">
    {
      DELTAS.map((d) => (
        <span
          class={`ambient__delta${solo(d.solo)}`}
          style={`--x: ${d.x}%; --y: ${d.y}%; --s: ${d.size}px; --d: ${d.duration}; --o: ${d.offset};`}
        >
          <DeltaIcon size={d.size} />
        </span>
      ))
    }
  </div>
</div>

<style>
  /* The settings' "off" values. The panel and BaseLayout's init script write
     the live values inline on <html>, which beats this rule. */
  :global(html) {
    --ambient-grid: 0;
    --ambient-glow: 0;
    --ambient-scan: 0;
    --ambient-rails: 0;
    --ambient-deltas: 0;
    --ambient-pace: 1;
  }

  .ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ambient__layer {
    position: absolute;
    inset: 0;
    display: none;
  }

  /* Strength per layer, 0–1, from the panel. */
  .ambient__layer--grid {
    opacity: var(--ambient-grid);
  }
  .ambient__layer--glow {
    opacity: var(--ambient-glow);
  }
  .ambient__layer--scan {
    opacity: var(--ambient-scan);
  }
  .ambient__layer--rails {
    opacity: var(--ambient-rails);
  }
  .ambient__layer--deltas {
    opacity: var(--ambient-deltas);
  }

  /* Which layers render — <html data-ambient="glow rails"> */
  :global(html[data-ambient~='grid']) .ambient__layer--grid,
  :global(html[data-ambient~='glow']) .ambient__layer--glow,
  :global(html[data-ambient~='scan']) .ambient__layer--scan,
  :global(html[data-ambient~='rails']) .ambient__layer--rails,
  :global(html[data-ambient~='deltas']) .ambient__layer--deltas {
    display: block;
  }

  /* Budget: with several effects layered, or on a phone, each keeps only its
     share (the prototype's Combined subset). */
  :global(html[data-ambient-layered]) .ambient__el--solo {
    display: none;
  }

  /* Every animated element takes its cycle (--d, s) and head start (--o, s)
     inline; Pace divides both, so faster keeps the same rhythm. */
  .ambient__cell,
  .ambient__glow,
  .ambient__scan,
  .ambient__mark,
  .ambient__delta {
    animation-duration: calc(var(--d, 1) * 1s / var(--ambient-pace));
    animation-delay: calc(var(--o, 0) * -1s / var(--ambient-pace));
    animation-iteration-count: infinite;
  }

  /* 01 Grid Pulse — accent cells breathing on the 50px lattice */
  .ambient__cell {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 50px;
    height: 50px;
    background: var(--color-primary);
    opacity: 0;
    animation-name: ambient-pulse;
    animation-timing-function: ease-in-out;
  }

  @keyframes ambient-pulse {
    0%,
    100% {
      opacity: 0;
    }

    45%,
    55% {
      opacity: 0.18;
    }
  }

  /* 02 Glow Shift — two slow radial washes */
  .ambient__glow {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 44%, transparent) 0%,
      transparent 65%
    );
    animation-timing-function: ease-in-out;
    animation-direction: alternate;
  }

  .ambient__glow--a {
    --d: 38;

    width: 70%;
    left: -16%;
    top: -42%;
    animation-name: ambient-drift-a;
  }

  .ambient__glow--b {
    --d: 46;

    width: 55%;
    right: -12%;
    bottom: -44%;
    opacity: 0.8;
    animation-name: ambient-drift-b;
  }

  @keyframes ambient-drift-a {
    from {
      transform: translate(0, 0) scale(1);
    }

    to {
      transform: translate(47%, 18%) scale(1.15);
    }
  }

  @keyframes ambient-drift-b {
    from {
      transform: translate(0, 0) scale(1.1);
    }

    to {
      transform: translate(-54%, -17%) scale(0.95);
    }
  }

  /* 03 Scan Sweep — a band that falls, decelerating and fading as it slows.
     Translate is a percentage of the band's own height (19.5% of the layer). */
  .ambient__scan {
    --d: 16;

    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 19.5%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-primary) 14%, transparent) 85%,
      color-mix(in srgb, var(--color-primary) 70%, transparent) 99%,
      transparent 100%
    );
    transform: translateY(-114%);
    animation-name: ambient-scan;
    animation-timing-function: linear;
  }

  @keyframes ambient-scan {
    0% {
      transform: translateY(-114%);
      opacity: 1;
    }

    10% {
      transform: translateY(86%);
      opacity: 0.95;
    }

    20% {
      transform: translateY(236%);
      opacity: 0.8;
    }

    30% {
      transform: translateY(343%);
      opacity: 0.62;
    }

    40% {
      transform: translateY(418%);
      opacity: 0.45;
    }

    50% {
      transform: translateY(468%);
      opacity: 0.3;
    }

    60% {
      transform: translateY(500%);
      opacity: 0.17;
    }

    70% {
      transform: translateY(519%);
      opacity: 0.07;
    }

    78%,
    100% {
      transform: translateY(529%);
      opacity: 0;
    }
  }

  /* 04 Data Rails — faint lines in four directions; each carries one mark
     that fires, fades, and stays dark for the rest of its cycle. The mark is
     painted at the leading end of a full-length strip, so translate
     percentages are percentages of the rail. */
  .ambient__rail {
    position: absolute;
    background: color-mix(in srgb, var(--color-primary) calc(var(--tint) * 2%), transparent);
  }

  .ambient__rail--v {
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: var(--w);
  }

  .ambient__rail--h {
    left: 0;
    right: 0;
    top: var(--pos);
    height: var(--w);
  }

  .ambient__mark {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    background-repeat: no-repeat;
    animation-timing-function: linear;
  }

  .ambient__mark--up,
  .ambient__mark--down {
    width: var(--thick);
    height: 100%;
    background-position: top;
    background-size: 100% var(--len);
  }

  .ambient__mark--right,
  .ambient__mark--left {
    width: 100%;
    height: var(--thick);
    background-position: left;
    background-size: var(--len) 100%;
  }

  .ambient__mark--up {
    background-image: linear-gradient(180deg, transparent, var(--color-primary));
    animation-name: ambient-rail-up;
  }

  .ambient__mark--down {
    background-image: linear-gradient(0deg, transparent, var(--color-primary));
    animation-name: ambient-rail-down;
  }

  .ambient__mark--right {
    background-image: linear-gradient(90deg, transparent, var(--color-primary));
    animation-name: ambient-rail-right;
  }

  .ambient__mark--left {
    background-image: linear-gradient(270deg, transparent, var(--color-primary));
    animation-name: ambient-rail-left;
  }

  @keyframes ambient-rail-up {
    0% {
      transform: translateY(100%);
      opacity: 0;
    }

    6%,
    34% {
      opacity: var(--pk);
    }

    52% {
      opacity: calc(var(--pk) * 0.35);
    }

    64%,
    100% {
      transform: translateY(calc(-1 * var(--len)));
      opacity: 0;
    }
  }

  @keyframes ambient-rail-down {
    0% {
      transform: translateY(calc(-1 * var(--len)));
      opacity: 0;
    }

    6%,
    34% {
      opacity: var(--pk);
    }

    52% {
      opacity: calc(var(--pk) * 0.35);
    }

    64%,
    100% {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  @keyframes ambient-rail-right {
    0% {
      transform: translateX(calc(-1 * var(--len)));
      opacity: 0;
    }

    6%,
    34% {
      opacity: var(--pk);
    }

    52% {
      opacity: calc(var(--pk) * 0.35);
    }

    64%,
    100% {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  @keyframes ambient-rail-left {
    0% {
      transform: translateX(100%);
      opacity: 0;
    }

    6%,
    34% {
      opacity: var(--pk);
    }

    52% {
      opacity: calc(var(--pk) * 0.35);
    }

    64%,
    100% {
      transform: translateX(calc(-1 * var(--len)));
      opacity: 0;
    }
  }

  /* 05 Delta Drift — brand deltas (DeltaIcon: stroke 6 in a 64 box) */
  .ambient__delta {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    color: var(--color-primary);
    opacity: 0.28;
    animation-name: ambient-float;
    animation-timing-function: ease-in-out;
    animation-direction: alternate;
  }

  /* DeltaIcon's <svg> carries its own scope, so reach it through this one;
     it fills the span, which sets the size. */
  .ambient__delta :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes ambient-float {
    from {
      transform: translateY(0) rotate(0deg);
    }

    to {
      transform: translateY(-36px) rotate(14deg);
    }
  }

  @media (max-width: 768px) {
    .ambient__el--solo {
      display: none;
    }
  }

  /* Reduced motion wins over any stored choice: the layer is not drawn at all. */
  @media (prefers-reduced-motion: reduce) {
    .ambient {
      display: none;
    }
  }
</style>
