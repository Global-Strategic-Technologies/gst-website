---
import FooterLinks from './FooterLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<footer role="contentinfo">
  <div class="container">
    <div class="footer-top">
      <FooterLinks locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</footer>

<style>
  footer {
    padding: var(--spacing-1_25) 0 0;
    background: var(--footer-bg);
    border-top: 2px solid var(--color-primary);
    position: relative;
    z-index: 0;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0;
    gap: var(--spacing-md);
  }

  /* :global() needed — .theme-toggle is rendered by the ThemeToggleButton
     child component (via ThemeToggle), whose <button> gets that component's
     scope, not Footer's. The rule lives HERE because it is footer-fit, not
     intrinsic to the button: it recenters the 44px hit box so the MARGIN box
     stays 13.6px and `.footer-top` is unmoved (WCAG 2.5.5 measures the
     target, not the paint — the height rule itself is in ThemeToggleButton).
     Never add height/min-height/width/min-width here: the touch-target floor
     scan guards this selector's last compound (`.theme-toggle`), and a
     sub-44px value would fail it, correctly. */
  .footer-top :global(.theme-toggle) {
    margin-block: calc((0.85rem - var(--touch-target-min)) / 2);
  }

  @media (max-width: 480px) {
    footer {
      padding: var(--spacing-xl) 0 var(--spacing-md);
    }

    .footer-top {
      flex-direction: row;
      gap: var(--spacing-lg);
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--spacing-md);
    }
  }

  /* Tablet (480px - 768px) */
  @media (min-width: 480px) and (max-width: 767px) {
    footer {
      padding: var(--spacing-xl) 0 0.375rem;
    }

    .footer-top {
      margin-bottom: var(--spacing-md);
      gap: var(--spacing-1_25);
    }
  }

  /* Desktop (768px+) */
  @media (min-width: 768px) {
    footer {
      padding: var(--spacing-2xl) 0 var(--spacing-sm);
    }

    .footer-top {
      margin-bottom: var(--spacing-lg);
      gap: var(--spacing-2xl);
    }
  }

  /* Print */
  @media print {
    footer {
      display: none;
    }
  }
</style>
