---
// Sash.astro — the announcement sash: a clipping corner box plus a rotated band
// carrying up to three segments (badge · label · detail), and optionally a
// second band (`subtext`) below it.
//
// The component is the CONTROL, not the announcement. What it says, where it
// mounts and when it retires all live in src/data/announcements.ts; a page
// renders `getActiveAnnouncement(Astro.url.pathname)` and passes the entry
// through. Announcing the next release is one registry entry.
//
// Copy budget — a 45° band cannot grow, so over-budget copy is cut or stepped up
// a scale, never shrunk with font-size. The segments share ONE budget: an
// earlier table here gave per-segment ceilings (label ≤ 18, detail ≤ 10) that
// were never provable together — 'New | MCP Server | for agents' (3+10+10)
// shaves the badge chip and runs the detail into the clip corner. Measured
// 2026-08-28 by rendering the /brand frame specimen at 3×, which is also how
// any new combination gets proven (clipping shows at the chip's corner and
// the detail's tail first). The label renders larger than the band's other
// segments — one step (--text-xs) is the family default, TWO (--text-sm) on the
// desktop page corner, and the card corner opts back down to the band's base
// size (sash.css) — so budgets are per tier:
//
//   page ≥769  ~13 characters across all segments with a badge (its chip +
//              gap costs about 5 more) at the --text-sm label.
//              Fits:  New | GST MCP (proven at --text-sm, 2026-08-28)
//              The ≤768 tiers keep the --text-xs label AND drop `detail`
//              entirely (sash.css display:nones it there), so only two-segment
//              copy can render on them — New | MCP Server is the proven one.
//   page ≥769  under-band (`subtext`): ≤ 37 characters — the same ceiling on
//              all three engines, which is new. This budget used to be
//              engine-specific (40 on Chromium and Firefox, 37 on WebKit)
//              because `--font-family-mono` was the bare `monospace` generic
//              and each engine resolved it to a different face: the live
//              35-character string was 222px of ink on two of them and 240px
//              on the third. BL-144 pinned the face, and the three engines now
//              set that string at 253.2 / 252.7 / 253.2px — a 0.5px spread
//              where there was an 18px one. Character counts are still a HINT;
//              the real budget is ink px into the usable chord, which is what
//              announcement-sash.test.ts asserts per engine — prove new copy by
//              running it, not by counting. Re-measured 2026-08-29 at the 220px
//              box under the pinned face.
//   page ≤511  no corner budget: the sash renders as a full-width in-flow
//              strip (sash.css) and both lines wrap.
//   card       label ≤ 4, nothing else — and never a subtext (the component
//              refuses it at card scale; a 104px corner has no second chord)
//
// Scale modifiers go on the CORNER BOX, never on the band: the band's per-scale
// geometry is keyed off the corner-box modifier so the box size and the band's
// top/width can never drift apart. Geometry and colour rules live in
// src/styles/components/sash.css (shared with the /brand specimens), which also
// documents how the page scale changes FORM below 512px: the corner overlay
// becomes a full-width, in-flow, two-line strip above the header (an overlay
// there would overflow the nav — the measured history is in sash.css).
//
// Page scale is a real link. Card scale is decorative — no href, no
// analytics, aria-hidden — because the .hub-card around it is already the link
// and is already tracked.
//
// Touch note: the MAIN band's height (~39px at desktop page scale) is below
// --touch-target-min (44px, AAA). That is acceptable ONLY because the sash is
// a redundant entry point — the same destination is in the Hub nav and in the
// hub card. Do not make it the sole path to anything. The under-band link
// carries `min-height: var(--touch-target-min-aa)` (24px, the AA floor) in
// sash.css — it is the real finger target on the unrotated mobile strip.

interface Props {
  /** The subject. The one required segment. */
  label: string;
  /** Status word chip, leading — secondary-accent fill (--sash-badge-bg). */
  badge?: string;
  /** Version or qualifier, rule-separated. Hidden below 768px. */
  detail?: string;
  /**
   * Optional subtext on a second, smaller band below the main one
   * (`.brutal-sash-under` — inverted ink-on-band colours; sash.css documents
   * why that inversion is the only colorway). Hidden 512–768px with `detail`,
   * never rendered at card scale; on the ≤511 strip it is the second line.
   * When the sash is a link, the under-band is its OWN link (to `subtextHref`,
   * or the main `href` absent one). Setting subtext also GROWS the desktop
   * corner box to 220px and widens the nav's reserve to match (sash.css and
   * HeaderNavLinks.astro both key on the class with :has()) — the subtext runs
   * nearly the whole chord, so the extra room is what keeps it off the box
   * edge; that room was sized against the widest face any engine resolved the
   * then-unpinned generic to, which is exactly the pinned face's advance, so it
   * is still right (BL-144). Proven to fit at 769px+ on
   * all three engines (2026-08-29). The sourced-claim rule applies to it like
   * every segment.
   */
  subtext?: string;
  /** The under-band link's destination; defaults to `href`. Fragments are the
   *  point (e.g. '/hub/mcp/#tiers'), guarded by
   *  tests/integration/announcement-anchor.test.ts. */
  subtextHref?: string;
  /** Accessible name for the under-band link; defaults to the raw subtext.
   *  Override when the subtext carries a visual separator a screen reader
   *  would read out (a literal pipe is spoken "vertical line"). */
  subtextAriaLabel?: string;
  /** Makes the band an <a>. Omit for the decorative card scale. */
  href?: string;
  /** 'page' (default) | 'card'. */
  scale?: 'page' | 'card';
  /** Full spoken announcement; composed from the segments when absent. */
  ariaLabel?: string;
  /** Announcement id — the analytics labels are `Sash: <id>` and
   *  `Sash: <id>-under`. */
  id?: string;
}

const {
  label,
  badge,
  detail,
  subtext,
  subtextHref,
  subtextAriaLabel,
  href,
  scale = 'page',
  ariaLabel,
  id,
} = Astro.props;

const isLink = scale !== 'card' && href !== undefined;

// Page scale only — the under-band has no card-scale geometry (see docblock).
const underBand = scale === 'page' && subtext !== undefined;
// The under-band is a link exactly when the sash is: /brand's specimens pass
// no href and keep the decorative span.
const underHref = subtextHref ?? href;
const underIsLink = underBand && isLink && underHref !== undefined;

const cornerClass = ['brutal-sash-corner', scale !== 'page' && `brutal-sash-corner--${scale}`]
  .filter(Boolean)
  .join(' ');

// The main link speaks the whole announcement (subtext included); the
// under-band link carries its own, shorter name.
const spokenLabel =
  ariaLabel ??
  `${badge ? `${badge}: ` : ''}${label}${detail ? ` ${detail}` : ''}${
    underBand ? ` — ${subtext}` : ''
  } — open the linked page`;
const underSpokenLabel = subtextAriaLabel ?? subtext;

// Destinations are recorded WITHOUT the trailing slash, matching every other
// trackNavigation call on the site (see HeaderNavLinks.astro) — otherwise the
// same page arrives in GA4 under two names. Fragments are PRESERVED (defined
// here 2026-08-29; there was no prior convention — the guide pages'
// #request-access links are untracked): '/hub/mcp/#tiers' records as
// '/hub/mcp#tiers'. The split is what makes the slash-strip work at all — the
// old one-line regex was a no-op on a fragment URL.
const toDestination = (raw: string): string => {
  const hashAt = raw.indexOf('#');
  const path = hashAt === -1 ? raw : raw.slice(0, hashAt);
  const fragment = hashAt === -1 ? '' : raw.slice(hashAt);
  return (path.replace(/\/+$/, '') || '/') + fragment;
};
const destination = href ? toDestination(href) : '';
// The handler is an inline attribute, so a lone apostrophe in a future id or
// href would end the JS string argument early. Registry values are ours, not
// user input — this just keeps a typo from becoming a broken page.
const jsString = (value: string) => value.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
const trackAttrs =
  isLink && id
    ? { onclick: `trackNavigation('${jsString(destination)}', 'Sash: ${jsString(id)}')` }
    : {};
const underTrackAttrs =
  underIsLink && id
    ? {
        onclick: `trackNavigation('${jsString(toDestination(underHref!))}', 'Sash: ${jsString(id)}-under')`,
      }
    : {};
---

<div class={cornerClass}>
  {
    isLink ? (
      <a class="brutal-sash" href={href} aria-label={spokenLabel} {...trackAttrs}>
        {badge && <span class="brutal-sash__badge">{badge}</span>}
        <span class="brutal-sash__label">{label}</span>
        {detail && <span class="brutal-sash__detail">{detail}</span>}
      </a>
    ) : (
      <span class="brutal-sash" aria-hidden="true">
        {badge && <span class="brutal-sash__badge">{badge}</span>}
        <span class="brutal-sash__label">{label}</span>
        {detail && <span class="brutal-sash__detail">{detail}</span>}
      </span>
    )
  }
  {
    underBand &&
      (underIsLink ? (
        <a
          class="brutal-sash-under"
          href={underHref}
          aria-label={underSpokenLabel}
          {...underTrackAttrs}
        >
          {subtext}
        </a>
      ) : (
        <span class="brutal-sash-under" aria-hidden="true">
          {subtext}
        </span>
      ))
  }
</div>
