---
// Sash.astro — the announcement sash: a clipping corner box plus a rotated band
// carrying up to three segments (badge · label · detail).
//
// The component is the CONTROL, not the announcement. What it says, where it
// mounts and when it retires all live in src/data/announcements.ts; a page
// renders `getActiveAnnouncement(Astro.url.pathname)` and passes the entry
// through. Announcing the next release is one registry entry.
//
// Copy budget — a 45° band cannot grow, so over-budget copy is cut or stepped up
// a scale, never shrunk with font-size. The segments share ONE budget: an
// earlier table here gave per-segment ceilings (label ≤ 18, detail ≤ 10) that
// were never provable together — 'New | MCP Server | for agents' (3+10+10)
// shaves the badge chip and runs the detail into the clip corner. Measured
// 2026-08-28 by rendering the /brand frame specimen at 3×, which is also how
// any new combination gets proven (clipping shows at the chip's corner and
// the detail's tail first):
//
//   page   ~16 characters across all segments with a badge (its chip +
//          gap costs about 5 more), ~20 without one.
//          Fits:  New | MCP Server          ·  New | MCP | for AI agents
//                 MCP Server | for agents (no badge)
//          Clips: New | MCP Server | for agents
//   page   under-band (`subtext`): ≤ 36 characters — its chord is LONGER
//          than the main band's, so subtext gets more room than the whole
//          headline. Measured 2026-08-28 on the /brand specimen with a
//          clipped-ink pixel diff: 36 renders clean, 40 loses glyphs to the
//          corner. Prove a longer string there before shipping it.
//   card   label ≤ 4, nothing else — and never a subtext (the component
//          refuses it at card scale; a 104px corner has no second chord)
//
// Scale modifiers go on the CORNER BOX, never on the band: the band's per-scale
// geometry is keyed off the corner-box modifier so the box size and the band's
// top/width can never drift apart. Geometry and colour rules live in
// src/styles/components/sash.css (shared with the /brand specimens), which also
// documents why the page scale stands down below 512px.
//
// Page scale is a real link. Card scale is decorative — no href, no
// analytics, aria-hidden — because the .hub-card around it is already the link
// and is already tracked.
//
// Touch note: the band's height (~30px at page scale) is below
// --touch-target-min. That is acceptable ONLY because the sash is a redundant
// entry point — the same destination is in the Hub nav and in the hub card. Do
// not make it the sole path to anything.

interface Props {
  /** The subject. The one required segment. */
  label: string;
  /** Status word chip, leading — secondary-accent fill (--sash-badge-bg). */
  badge?: string;
  /** Version or qualifier, rule-separated. Hidden below 768px. */
  detail?: string;
  /**
   * Optional subtext on a second, smaller band below the main one
   * (`.brutal-sash-under` — inverted ink-on-band colours, the badge's own
   * token pair; sash.css documents why that inversion is the only colorway).
   * Page scale + desktop only: hidden ≤768px with `detail`, never rendered at
   * card scale. Setting it also widens the nav's desktop corner reserve to
   * 200px (HeaderNavLinks.astro keys on the class with :has()) — proven to
   * fit at 769px+ on all three engines when the capability landed
   * (2026-08-28). The sourced-claim rule applies to it like every segment.
   */
  subtext?: string;
  /** Makes the band an <a>. Omit for the decorative card scale. */
  href?: string;
  /** 'page' (default) | 'card'. */
  scale?: 'page' | 'card';
  /** Full spoken announcement; composed from the segments when absent. */
  ariaLabel?: string;
  /** Announcement id — the analytics label is `Sash: <id>`. */
  id?: string;
}

const { label, badge, detail, subtext, href, scale = 'page', ariaLabel, id } = Astro.props;

const isLink = scale !== 'card' && href !== undefined;

// Page scale only — the under-band has no card-scale geometry (see docblock).
const underBand = scale === 'page' && subtext !== undefined;

const cornerClass = ['brutal-sash-corner', scale !== 'page' && `brutal-sash-corner--${scale}`]
  .filter(Boolean)
  .join(' ');

// The under-band is aria-hidden; its subtext is spoken here instead.
const spokenLabel =
  ariaLabel ??
  `${badge ? `${badge}: ` : ''}${label}${detail ? ` ${detail}` : ''}${
    underBand ? ` — ${subtext}` : ''
  } — open the linked page`;

// Destinations are recorded WITHOUT the trailing slash, matching every other
// trackNavigation call on the site (see HeaderNavLinks.astro) — otherwise the
// same page arrives in GA4 under two names. `trackNavigation` is put on window
// by Header.astro, which every page renders through BaseLayout.
const destination = href ? href.replace(/\/+$/, '') || '/' : '';
// The handler is an inline attribute, so a lone apostrophe in a future id or
// href would end the JS string argument early. Registry values are ours, not
// user input — this just keeps a typo from becoming a broken page.
const jsString = (value: string) => value.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
const trackAttrs =
  isLink && id
    ? { onclick: `trackNavigation('${jsString(destination)}', 'Sash: ${jsString(id)}')` }
    : {};
---

<div class={cornerClass}>
  {
    isLink ? (
      <a class="brutal-sash" href={href} aria-label={spokenLabel} {...trackAttrs}>
        {badge && <span class="brutal-sash__badge">{badge}</span>}
        <span class="brutal-sash__label">{label}</span>
        {detail && <span class="brutal-sash__detail">{detail}</span>}
      </a>
    ) : (
      <span class="brutal-sash" aria-hidden="true">
        {badge && <span class="brutal-sash__badge">{badge}</span>}
        <span class="brutal-sash__label">{label}</span>
        {detail && <span class="brutal-sash__detail">{detail}</span>}
      </span>
    )
  }
  {
    underBand && (
      <span class="brutal-sash-under" aria-hidden="true">
        {subtext}
      </span>
    )
  }
</div>
