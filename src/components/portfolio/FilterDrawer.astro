---
import type { Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/t';
import { portfolioLabeler, type LabelKind } from '../../lib/portfolio-labels';

interface Props {
  uniqueThemes: string[];
  uniqueEngagementCategories: string[];
  locale: Locale;
}

const { uniqueThemes, uniqueEngagementCategories, locale } = Astro.props;
const { t } = useTranslations(locale, 'ma-portfolio');
const label = portfolioLabeler(locale);
const collator = new Intl.Collator(locale.intl);

// Chips carry the English value in `data-value` and `data-testid`, which the
// filter script, URL params and analytics read. Only the text and order vary.
const chips = (kind: LabelKind, values: string[]) =>
  values
    .map((value) => ({ value, text: label(kind, value) }))
    .sort((a, b) => collator.compare(a.text, b.text));
---

<!--
  Filter Drawer — slide-out panel with engagement and theme filter chips.
  Template-only: event wiring (open/close, chip clicks, clear-all) is handled
  by PortfolioHeader's script block via ID-based DOM queries.
  Styles are in src/styles/components/filter.css.

  Uses brutal-frosted--blur-only for the backdrop-filter without adding
  contrast when the drawer overlaps the green stats band. Filter chips
  themselves have their own fill and remain readable.
-->
<div
  id="filter-drawer"
  class="filter-drawer portfolio-filter-drawer brutal-frosted--blur-only"
  data-testid="portfolio-filter-drawer"
>
  <div class="drawer-header">
    <h2 class="drawer-title">{t('drawer.title')}</h2>
    <button
      id="drawer-close"
      class="drawer-close"
      aria-label={t('drawer.close')}
      data-testid="portfolio-drawer-close"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="drawer-content">
    <button id="clear-filters" class="clear-filters-button" data-testid="clear-filters-button">
      {t('drawer.clearAll')}
    </button>

    <div class="filter-section">
      <div class="filter-label">{t('drawer.engagement')}</div>
      <div class="filter-chips" id="engagement-chips" data-testid="engagement-filter-chips">
        <div class="filter-chip active" data-value="all" data-testid="filter-chip-engagement-all">
          {t('drawer.allEngagements')}
        </div>
        {chips('category', uniqueEngagementCategories).map(({ value: cat, text }) => (
          <div
            class="filter-chip"
            data-value={cat}
            data-testid={`filter-chip-engagement-${cat.toLowerCase().replace(/[\s&]+/g, '-')}`}
          >
            {text}
          </div>
        ))}
      </div>
    </div>

    <div class="filter-section">
      <div class="filter-label">{t('drawer.theme')}</div>
      <div class="filter-chips" id="theme-chips" data-testid="theme-filter-chips">
        <div class="filter-chip active" data-value="all" data-testid="filter-chip-theme-all">
          {t('drawer.allThemes')}
        </div>
        {chips('theme', uniqueThemes).map(({ value: theme, text }) => (
          <div
            class="filter-chip"
            data-value={theme}
            data-testid={`filter-chip-theme-${theme.toLowerCase().replace(/\s+/g, '-')}`}
          >
            {text}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-xl);
    border-bottom: 1px solid light-dark(var(--border-light), var(--border-dark));
    flex-shrink: 0;
  }

  .drawer-title {
    font-family: var(--font-family-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .drawer-close {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: var(--spacing-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .drawer-close:hover {
    color: var(--color-primary);
  }

  .drawer-close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .drawer-content {
    padding: var(--spacing-xl);
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .filter-section {
    margin-bottom: var(--spacing-xl);
  }

  .filter-section:last-of-type {
    margin-bottom: var(--spacing-2xl);
  }

  .filter-label {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--spacing-md);
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .clear-filters-button {
    width: calc(100% - 3rem);
    margin: 0 var(--spacing-xl) var(--spacing-xl);
  }

  @media (max-width: 480px) {
    .drawer-header {
      padding: var(--spacing-lg);
      flex-shrink: 0;
    }

    .drawer-content {
      padding: var(--spacing-lg);
      max-height: calc(85vh - 60px);
      overflow-y: auto;
    }

    .filter-chips {
      gap: 0.625rem;
    }
  }
</style>

<!-- Drawer Overlay (Mobile & Desktop) -->
<div
  id="filter-overlay"
  class="filter-overlay portfolio-filter-overlay"
  data-testid="portfolio-filter-overlay"
></div>
