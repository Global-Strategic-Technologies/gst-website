---
import type { Project } from '../../types/portfolio';
import ProjectModal from './ProjectModal.astro';
import '../../styles/components/portfolio.css';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="portfolio-grid-container brutal-frosted--blur-only">
  <div class="container">
    <div class="grid" data-testid="portfolio-grid">
      {
        projects.map((project) => (
          <div
            class="project-card"
            data-project-id={project.id}
            data-testid="project-card"
            role="button"
            tabindex="0"
          >
            <div class="card-header">
              <div>
                <h3 class="project-title">{project.codeName}</h3>
                <p class="project-industry">{project.industry}</p>
              </div>
              <div class="year-badge">{project.year}</div>
            </div>

            <div class="metrics">
              <div class="metric">
                <div class="metric-label">ARR</div>
                <div class="metric-value arr">
                  {project.arr === 'Not in source' ? '--' : project.arr}
                </div>
              </div>
              <div class="metric">
                <div class="metric-label">Stage</div>
                <div class="metric-value">{project.growthStage}</div>
              </div>
            </div>

            <p class="summary">{project.summary}</p>

            <div class="tags">
              <div class="tag theme">{project.theme}</div>
              <div class="tag engagement">{project.engagementCategory}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Project Details Modal -->
  <ProjectModal />
</div>

<style>
  .portfolio-grid-container {
    padding: var(--spacing-2xl) 0 4rem;
  }

  /* Deliberately NOT the global `.container` — a narrower grid column with its
     own gutter ladder (1.5 / 1 / 0.75rem against the page's 3 / 1.5 / 1rem).
     Astro scopes this at (0,2,0), so it overrides the global rule by design
     rather than by accident; it is not the shadowing that global.css documents.
     Keep the two ladders stepping at the same breakpoints. */
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--spacing-xl);
  }

  .no-results-message {
    grid-column: 1 / -1;
    padding: var(--spacing-3xl) var(--spacing-xl);
    text-align: center;
    color: light-dark(var(--text-secondary), var(--text-dark-muted));
    font-size: var(--text-base);
  }

  /* .project-card is styled GLOBALLY in src/styles/components/cards.css —
     the single definition both this grid and the /brand specimen consume
     (BL-095 closeout; a scoped duplicate here used to shadow it and the two
     drifted). The interior below stays scoped: its /brand documentation is
     the converged replica pair noted in cards.css. */

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-lg);
    gap: var(--spacing-lg);
  }

  .project-title {
    font-family: var(--font-family-mono);
    font-weight: 900;
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: 0 0 var(--spacing-xs);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .project-industry {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
  }

  .year-badge {
    font-family: var(--font-family-mono);
    background: light-dark(var(--filter-chip-bg), var(--accent-dark-bg));
    color: var(--text-secondary);
    padding: 0.35rem var(--spacing-md);
    border-radius: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-lg);
    background: var(--search-input-bg);
    border-left: 3px solid var(--color-primary);
  }

  .metric {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-family: var(--font-family-mono);
    font-size: var(--text-2xs);
    color: light-dark(var(--text-muted), var(--text-dark-muted));
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .metric-value {
    font-family: var(--font-family-mono);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .metric-value.arr {
    color: var(--color-tertiary);
    font-size: var(--text-lg);
  }

  .summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: var(--spacing-lg) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin: var(--spacing-sm) 0;
  }

  .tag {
    font-family: var(--font-family-mono);
    background: var(--accent-dark-bg);
    color: var(--color-primary);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag.theme,
  .tag.engagement {
    background: var(--accent-light-bg-hover);
    color: var(--color-tertiary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .container {
      padding: 0 var(--spacing-lg);
    }

    .project-title {
      font-size: var(--text-lg);
    }

    .metrics {
      gap: var(--spacing-md);
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 var(--spacing-md);
    }

    .portfolio-grid-container {
      padding: var(--spacing-lg) 0 var(--spacing-2xl);
    }

    .grid {
      gap: var(--spacing-lg);
    }

    /* .project-card's 480px padding lives with its global rule in cards.css */

    .card-header {
      margin-bottom: var(--spacing-md);
    }

    .project-title {
      font-size: var(--text-base);
    }

    .metrics {
      margin: var(--spacing-md) 0;
      padding: var(--spacing-md);
      gap: var(--spacing-sm);
    }

    .metric-value {
      font-size: var(--text-sm);
    }

    .metric-value.arr {
      font-size: var(--text-base);
    }

    .summary {
      font-size: var(--text-sm);
      margin: var(--spacing-md) 0;
    }
  }

  /* The `.project-modal` / `.modal-*` responsive overrides that used to sit here were
     DEAD and were deleted in BL-096. This component's \3c style> is Astro-scoped and it
     renders no modal markup — the only `.modal-close` in the repo is
     ProjectModal.astro:11 — so these rules carried this component's scope id and could
     never match anything. Two of them (min-width/min-height: 40px) surfaced as
     touch-target violations, which is how they were found. Modal styling lives in
     ProjectModal.astro. */
</style>

<script is:inline>
  function openProjectModal(projectId) {
    // Use ProjectModal component's open function
    window.projectModal.open(projectId, window.portfolioState.allProjects);
  }

  function trackFilterApplication(filterType, filterValue) {
    // Track filter actions in analytics
    if (window.gtag) {
      window.gtag('event', 'filter_applied', {
        event_category: 'portfolio',
        filter_type: filterType,
        filter_value: filterValue,
      });
    }
  }

  function initPortfolioGrid() {
    const cards = document.querySelectorAll('.project-card');

    // Card click handlers
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        openProjectModal(card.dataset.projectId);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openProjectModal(card.dataset.projectId);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPortfolioGrid);
  } else {
    initPortfolioGrid();
  }

  // Listen for filter updates and track them
  window.addEventListener('portfolioFiltered', (e) => {
    if (e.detail && e.detail.filterType && e.detail.filterValue) {
      trackFilterApplication(e.detail.filterType, e.detail.filterValue);
    }
  });
</script>
