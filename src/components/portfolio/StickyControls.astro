---
// Markup and styles only. PortfolioHeader.astro's script is this bar's runtime: it
// binds #search-input-sticky and #filter-toggle-sticky alongside the header bar's
// controls, and slides the bar in (`sticky-active`) once the header scrolls under the nav.
---

<!-- Fixed Controls - Positioned independently at viewport level -->
<div class="sticky-controls-overlay">
  <div class="portfolio-controls-fixed brutal-frosted--heavy">
    <div class="controls-wrapper brutal-frosted">
      <div class="search-box">
        <svg
          class="search-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="search"
          id="search-input-sticky"
          class="search-input"
          placeholder="Name, industry, technology"
          aria-label="Search projects"
          data-testid="sticky-search-input"
        />
      </div>

      <button
        id="filter-toggle-sticky"
        class="filter-button"
        aria-label="Open filters"
        aria-expanded="false"
        data-testid="sticky-filter-toggle"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <span class="filter-text">Filters</span>
        <span
          id="filter-badge-sticky"
          class="filter-badge"
          aria-live="polite"
          data-testid="sticky-filter-badge"
        ></span>
      </button>
    </div>
  </div>
</div>

<style>
  /* Sticky Controls Overlay - Independent of page layout */
  .sticky-controls-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 9999;
    pointer-events: auto;
  }

  /* Fixed Search/Filter Controls */
  .portfolio-controls-fixed {
    border-bottom: none;
    padding: 0;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform var(--transition-fast) ease-out,
      opacity var(--transition-fast) ease-out;
    position: fixed;
    left: 50%;
    width: fit-content;
    max-width: calc(100% - 3rem);
    z-index: 1002;
    box-shadow: var(--shadow-sm);
    pointer-events: auto;
    top: 73px;
    transform: translateX(-50%) translateY(-200px);
    opacity: 0;
  }

  .portfolio-controls-fixed.sticky-active {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  .search-box {
    position: relative;
    flex: 1;
    min-width: 375px;
    display: flex;
    align-items: center;
    margin-left: var(--spacing-md);
  }

  .search-input {
    font-family: var(--font-family-mono);
    background: transparent;
  }

  .search-icon {
    position: absolute;
    left: 0.875rem;
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    pointer-events: none;
    z-index: 1;
  }

  .filter-button {
    margin-right: var(--spacing-md);
    min-height: var(--touch-target-min);
    pointer-events: auto;
    padding: var(--spacing-md) var(--spacing-lg);
    background: transparent;
  }

  .filter-button svg {
    pointer-events: auto;
  }

  .filter-text {
    display: inline;
  }

  .filter-badge {
    display: none;
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--color-primary);
    color: var(--bg-light);
    font-size: var(--text-2xs);
    font-weight: 700;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: 50%;
    min-width: 20px;
    text-align: center;
    animation: badgePulse 0.3s ease-out;
  }

  @keyframes badgePulse {
    0% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
    }
  }

  /* This component renders the sticky search/filter bar and nothing else. The
     drawer, its overlay and their contents are rendered by FilterDrawer.astro,
     so scoped rules here cannot reach them — they compile to
     `[data-astro-cid-<this file>]` and those elements carry the child's id.
     Their styles live in src/styles/components/filter.css (BL-139). */

  /* Dark Theme */

  /* dark theme frosted glass handled by .brutal-frosted (base, 3px blur) */

  :global(html.dark-theme) .controls-wrapper {
    border-bottom-color: var(--color-primary);
  }

  /* dark theme frosted glass handled by .brutal-frosted--overlay */

  /* Responsive */
  @media (max-width: 768px) {
    .portfolio-controls-fixed {
      max-width: calc(100% - 2rem);
    }

    .search-box {
      min-width: 270px;
    }
  }

  @media (max-width: 480px) {
    .portfolio-controls-fixed {
      max-width: calc(100% - 0.5rem);
    }

    .search-box {
      flex: 1;
      min-width: 240px;
      min-height: 38px;
      display: flex;
      align-items: center;
      margin-left: var(--spacing-md);
    }

    .search-input {
      padding: 0.625rem var(--spacing-md) 0.625rem 2.25rem;
      font-size: var(--text-xs);
      min-height: 38px;
    }

    .search-icon {
      left: var(--spacing-md);
      width: 16px;
      height: 16px;
    }

    .filter-text {
      display: none;
    }
  }
</style>
