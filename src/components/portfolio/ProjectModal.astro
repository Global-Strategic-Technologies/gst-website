---
// ProjectModal Component
// Extracted from PortfolioGrid for reusability and separation of concerns
//
// Every value is written by the inline script below before the dialog opens, so
// the markup carries no placeholder text. That script can't import modules, so a
// non-English page gives it the translated labels in the `portfolio-labels`
// island; on English it shows the data values, which are the English labels.
import { isDefaultLocale, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/t';
import { portfolioLabelIsland } from '../../lib/portfolio-labels';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale, 'ma-portfolio');
const isEnglish = isDefaultLocale(locale);
const entryLang = isEnglish ? undefined : 'en';
---

<!-- Project Details Modal -->
<dialog id="project-modal-2" class="project-modal" data-testid="project-modal">
  <div class="modal-content">
    <button
      id="modal-close-2"
      class="modal-close"
      aria-label={t('modal.close')}
      data-testid="project-modal-close"
    >
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-header">
      <div>
        <h2
          id="modal-title-2"
          class="modal-title"
          data-testid="project-modal-title"
          lang={entryLang}
        ></h2>
        <p
          id="modal-industry-2"
          class="modal-industry"
          data-testid="project-modal-industry"
          lang={entryLang}
        ></p>
      </div>
    </div>

    <div class="modal-metrics">
      <div class="modal-metric">
        <div class="metric-label">{t('modal.arr')}</div>
        <div id="modal-arr-2" class="metric-value arr" data-testid="project-modal-arr"></div>
      </div>
      <div class="modal-metric">
        <div class="metric-label">{t('modal.growthStage')}</div>
        <div id="modal-stage-2" class="metric-value" data-testid="project-modal-stage"></div>
      </div>
      <div class="modal-metric">
        <div class="metric-label">{t('modal.theme')}</div>
        <div id="modal-theme-2" class="metric-value" data-testid="project-modal-theme"></div>
      </div>
      <div class="modal-metric">
        <div class="metric-label">{t('modal.year')}</div>
        <div id="modal-year-2" class="metric-value" data-testid="project-modal-year"></div>
      </div>
    </div>

    <div class="modal-section">
      <h3 class="modal-section-title">{t('modal.engagementType')}</h3>
      <p
        id="modal-engagement-line-2"
        class="modal-engagement-line"
        data-testid="project-modal-engagement"
      ></p>
    </div>

    <div class="modal-section">
      <h3 class="modal-section-title">{t('modal.summary')}</h3>
      <p
        id="modal-summary-2"
        class="modal-text"
        data-testid="project-modal-summary"
        lang={entryLang}
      ></p>
    </div>

    <div
      class="modal-section"
      id="modal-challenge-section"
      style="display: none;"
      data-testid="project-modal-challenge-section"
    >
      <h3 class="modal-section-title">{t('modal.challenge')}</h3>
      <p
        id="modal-challenge-2"
        class="modal-text"
        data-testid="project-modal-challenge"
        lang={entryLang}
      ></p>
    </div>

    <div
      class="modal-section"
      id="modal-solution-section"
      style="display: none;"
      data-testid="project-modal-solution-section"
    >
      <h3 class="modal-section-title">{t('modal.solution')}</h3>
      <p
        id="modal-solution-2"
        class="modal-text"
        data-testid="project-modal-solution"
        lang={entryLang}
      ></p>
    </div>

    <div class="modal-section">
      <h3 class="modal-section-title">{t('modal.technologies')}</h3>
      <div
        id="modal-tech-tags-2"
        class="modal-tech-tags"
        data-testid="project-modal-tech-tags"
        lang={entryLang}
      >
        <!-- Tech tags will be inserted here -->
      </div>
    </div>
  </div>
</dialog>

{!isEnglish && (
  <script
    is:inline
    type="application/json"
    id="portfolio-labels"
    set:html={JSON.stringify({
      ...portfolioLabelIsland(locale),
      notAvailable: t('modal.notAvailable'),
    }).replace(/</g, '\\u003c')}
  />
)}

<style>
  /* Modal Styles */
  .project-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 700px;
    width: 90%;
    max-height: 85vh;
    padding: var(--spacing-2xl);
    background: light-dark(var(--bg-light), var(--bg-dark-secondary));
    border: 1px solid light-dark(var(--border-light), var(--border-dark-default));
    border-radius: 0;
    clip-path: polygon(
      2.5% 0%,
      97.5% 0%,
      100% 2.5%,
      100% 97.5%,
      97.5% 100%,
      2.5% 100%,
      0% 97.5%,
      0% 2.5%
    );
    z-index: var(--z-modal);
    border-top: 3px solid var(--color-primary);
    overflow-y: auto;
  }

  .project-modal::backdrop {
    background: var(--scrim-50);
  }

  .modal-content {
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    background: transparent;
    border: 2px solid transparent;
    cursor: pointer;
    color: var(--text-muted);
    padding: var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    min-width: var(--touch-target-min);
    min-height: var(--touch-target-min);
  }

  .modal-close:hover {
    color: var(--color-primary);
    background: light-dark(var(--accent-light-bg), transparent);
  }

  .modal-close:active {
    transform: scale(0.95);
  }

  .modal-close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    background: light-dark(var(--accent-light-bg), transparent);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-xl);
    gap: var(--spacing-lg);
  }

  .modal-title {
    font-size: var(--text-3xl);
    font-family: var(--font-family-mono);
    font-weight: 900;
    color: var(--text-primary);
    margin: 0 0 var(--spacing-xs);
    letter-spacing: -0.01em;
  }

  .modal-industry {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
  }

  .modal-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-2xl);
    border-bottom: 1px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  .modal-metric {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: light-dark(var(--text-secondary), var(--text-muted));
    margin: 0 0 var(--spacing-sm);
  }

  .metric-value {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .modal-section {
    margin-bottom: var(--spacing-xl);
  }

  .modal-section-title {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: light-dark(var(--text-secondary), var(--text-muted));
    margin: 0 0 var(--spacing-md);
  }

  .modal-text {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  :global(.modal-tech-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  :global(.modal-tech-tags .tech-tag) {
    background: light-dark(var(--filter-chip-bg-hover), var(--accent-dark-bg));
    color: var(--text-secondary);
    padding: 0.35rem 0.65rem;
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .modal-engagement-line {
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    font-weight: 600;
    color: var(--color-tertiary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* Dark theme modal */
  /* .project-modal background/border use light-dark() */

  @media (max-width: 768px) {
    .project-modal {
      width: 95%;
      max-height: 90vh;
      padding: var(--spacing-xl);
    }

    .modal-close {
      top: var(--spacing-md);
      right: var(--spacing-md);
    }

    .modal-metrics {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-xl);
      padding-bottom: var(--spacing-xl);
    }
  }

  @media (max-width: 480px) {
    .project-modal {
      width: 100%;
      max-width: none;
      max-height: 100vh;
      padding: var(--spacing-lg);
      transform: translate(0, 0);
      top: 0;
      left: 0;
      border-radius: 0;
      clip-path: none;
    }

    .project-modal::backdrop {
      background: var(--scrim-60);
    }

    .modal-close {
      top: var(--spacing-sm);
      right: var(--spacing-sm);
      padding: var(--spacing-sm);
      min-width: var(--touch-target-min);
      min-height: var(--touch-target-min);
    }

    .modal-title {
      font-size: var(--text-xl);
    }

    .modal-metrics {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-md);
    }

    .modal-section-title {
      font-size: var(--text-xs);
    }

    .modal-text {
      font-size: var(--text-sm);
    }
  }
</style>

<script is:inline>
  // Export modal utility functions for use in PortfolioGrid
  window.projectModal = {
    open: function (projectId, projects) {
      const project = projects.find((p) => p.id === projectId);
      if (!project) return;

      // Track project view in analytics
      if (window.gtag) {
        window.gtag('event', 'portfolio_view_details', {
          event_category: 'portfolio',
          project_id: projectId,
          project_name: project.codeName,
          industry: project.industry,
        });
      }

      // Translated labels on a non-English page; bad JSON must not stop the dialog
      let labels = {};
      try {
        labels = JSON.parse(document.getElementById('portfolio-labels')?.textContent ?? '{}');
      } catch {
        labels = {};
      }
      const label = (kind, value) => labels[kind]?.[value] ?? value;

      // Populate modal with null checks
      const modalTitle = document.getElementById('modal-title-2');
      const modalIndustry = document.getElementById('modal-industry-2');
      const modalYear = document.getElementById('modal-year-2');
      const modalArr = document.getElementById('modal-arr-2');
      const modalStage = document.getElementById('modal-stage-2');
      const modalTheme = document.getElementById('modal-theme-2');
      const modalEngagementLine = document.getElementById('modal-engagement-line-2');
      const modalSummary = document.getElementById('modal-summary-2');

      if (modalTitle) modalTitle.textContent = project.codeName;
      if (modalIndustry) modalIndustry.textContent = project.industry;
      if (modalYear) modalYear.textContent = project.year.toString();
      if (modalArr) modalArr.textContent = project.arr === 'Not in source' ? '--' : project.arr;
      if (modalStage) modalStage.textContent = label('stage', project.growthStage);
      if (modalTheme) modalTheme.textContent = label('theme', project.theme);
      if (modalEngagementLine) {
        const parts = [
          label('category', project.engagementCategory),
          label('type', project.engagementType),
        ].filter(Boolean);
        modalEngagementLine.textContent = parts.join(' \u00B7 ') || labels.notAvailable || 'N/A';
      }

      if (modalSummary) modalSummary.textContent = project.summary;

      // Handle Challenge section (show only if present)
      const challengeSection = document.getElementById('modal-challenge-section');
      const modalChallenge = document.getElementById('modal-challenge-2');
      if (challengeSection && modalChallenge) {
        if (project.challenge) {
          modalChallenge.textContent = project.challenge;
          challengeSection.style.display = 'block';
        } else {
          challengeSection.style.display = 'none';
        }
      }

      // Handle Solution section (show only if present)
      const solutionSection = document.getElementById('modal-solution-section');
      const modalSolution = document.getElementById('modal-solution-2');
      if (solutionSection && modalSolution) {
        if (project.solution) {
          modalSolution.textContent = project.solution;
          solutionSection.style.display = 'block';
        } else {
          solutionSection.style.display = 'none';
        }
      }

      // Render technologies
      const techs = Array.isArray(project.technologies)
        ? project.technologies
        : typeof project.technologies === 'string'
          ? project.technologies.split(',').map((t) => t.trim())
          : [];

      const techTagsContainer = document.getElementById('modal-tech-tags-2');
      if (techTagsContainer) {
        techTagsContainer.innerHTML = techs
          .map((tech) => `<span class="tech-tag">${window.projectModal.escapeHtml(tech)}</span>`)
          .join('');
      }

      // Show modal
      const modal = document.getElementById('project-modal-2');
      if (modal) modal.showModal();
    },

    close: function () {
      const modal = document.getElementById('project-modal-2');
      if (modal) {
        // Track modal close in analytics
        if (window.gtag) {
          window.gtag('event', 'portfolio_close_modal', {
            event_category: 'portfolio',
          });
        }
        modal.close();
      }
    },

    init: function () {
      const modal = document.getElementById('project-modal-2');
      const closeBtn = document.getElementById('modal-close-2');

      // Modal close button
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          window.projectModal.close();
        });
      }

      // Close modal on backdrop click
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            window.projectModal.close();
          }
        });

        // Close on Escape key
        modal.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            window.projectModal.close();
          }
        });
      }
    },

    escapeHtml: function (text) {
      const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;',
      };
      return text.replace(/[&<>"']/g, (m) => map[m]);
    },
  };

  // Initialize modal on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.projectModal.init();
    });
  } else {
    window.projectModal.init();
  }
</script>
