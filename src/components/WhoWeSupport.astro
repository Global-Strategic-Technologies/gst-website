---
// WhoWeSupport section - displays target audience segments with SVG bullet indicators
// Copy comes from the `home` catalog (BL-153); `locale` defaults to English.
import DeltaIcon from './DeltaIcon.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const { t } = useTranslations(locale, 'home');
---

<section class="who-we-support" aria-label={t('support.ariaLabel')}>
  <div class="container">
    <div class="support-content">
      <h2 class="brutal-heading-lg">{t('support.heading')}</h2>
      <p class="intro-text">{t('support.intro')}</p>

      <ul class="support-list">
        <li>
          <DeltaIcon class="bullet-icon" />
          <span>{t('support.item1')}</span>
        </li>
        <li>
          <DeltaIcon class="bullet-icon" />
          <span>{t('support.item2')}</span>
        </li>
        <li>
          <DeltaIcon class="bullet-icon" />
          <span>{t('support.item3')}</span>
        </li>
        <li>
          <DeltaIcon class="bullet-icon" />
          <span>{t('support.item4')}</span>
        </li>
      </ul>

      <p class="closing-text">{t('support.closing')}</p>
    </div>
  </div>
</section>

<style>
  /* Component styles following design system patterns */
  .who-we-support {
    padding: var(--spacing-3xl) 0;
    background: transparent;
    position: relative;
  }

  .support-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .brutal-heading-lg {
    margin-bottom: var(--spacing-xl);
  }

  .intro-text {
    font-size: var(--text-lg);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-2xl);
    line-height: 1.7;
  }

  .support-list {
    list-style: none;
    margin-bottom: var(--spacing-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-wide);
  }

  .support-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-lg);
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-primary);
    line-height: 1.6;
  }

  .closing-text {
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.8;
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
    border-top: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  /* `::before` here, `::after` in `WhatWeDo.astro`. Both put the marker on the
     edge its own section aligns to — this one is left-aligned with leading
     delta bullets, that one is right-aligned with trailing ones. The two are
     mirror twins, so a reader who "fixes" one to match the other's PSEUDO
     breaks the symmetry they were trying to restore. Match the edge, not the
     selector. */
  .closing-text::before {
    content: '// ';
    color: var(--color-primary);
    font-weight: 900;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .who-we-support {
      padding: var(--spacing-2xl) 0;
    }

    .intro-text {
      font-size: var(--text-base);
      margin-bottom: var(--spacing-xl);
    }

    .support-list {
      gap: var(--gap-normal);
    }

    .support-list li span {
      font-size: var(--text-small);
    }

    .closing-text {
      font-size: var(--text-small);
    }
  }

  @media (max-width: 480px) {
    .who-we-support {
      padding: var(--spacing-md) 0 var(--spacing-xl) 0;
    }

    .support-list li {
      gap: var(--spacing-md);
    }
  }
</style>
