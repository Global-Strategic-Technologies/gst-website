---
import { isDefaultLocale, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale, 'ma-portfolio');
---

<section class="portfolio-summary" aria-label={t('summary.ariaLabel')}>
  <div class="container">
    <div class="summary-content">
      <h2>{t('summary.heading')}</h2>
      <p>{t('summary.body')}</p>
      {!isDefaultLocale(locale) && (
        <p class="portfolio-summary__note">{t('notice.entriesEnglish')}</p>
      )}
    </div>
  </div>
</section>

<style>
  .portfolio-summary {
    padding: var(--spacing-3xl) 0;
    background: transparent;
    border-bottom: none;
  }

  .summary-content {
    max-width: 900px;
  }

  .portfolio-summary h2 {
    font-size: var(--text-3xl);
    font-family: var(--font-family-mono);
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-xl);
  }

  .portfolio-summary p:not(.portfolio-summary__note) {
    font-size: var(--text-lg);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.8;
  }

  /* Tier C notice (BL-153), on non-English pages. Excluded from the rule above,
     whose specificity would otherwise win over this class at every width. */
  .portfolio-summary__note {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    font-style: italic;
    color: var(--text-muted);
    margin-top: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .portfolio-summary {
      padding: var(--spacing-2xl) 0;
    }

    .portfolio-summary h2 {
      font-size: var(--text-2xl);
      margin-bottom: var(--spacing-lg);
    }

    .portfolio-summary p:not(.portfolio-summary__note) {
      font-size: var(--text-base);
    }
  }

  @media (max-width: 480px) {
    .portfolio-summary {
      padding: var(--spacing-xl) 0;
    }

    .portfolio-summary h2 {
      font-size: var(--text-xl);
      margin-bottom: var(--spacing-md);
    }

    .portfolio-summary p:not(.portfolio-summary__note) {
      font-size: var(--text-sm);
      line-height: 1.6;
    }
  }
</style>
