---
// WhyClientsTrustUs section - displays core credibility drivers with 2x2 card grid
// Copy comes from the `home` catalog (BL-153); `locale` defaults to English.
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const { t } = useTranslations(locale, 'home');
const cards = ['card1', 'card2', 'card3', 'card4'] as const;
---

<section class="why-clients-trust-us" aria-label={t('trust.ariaLabel')}>
  <div class="container">
    <div class="trust-content">
      <h2 class="brutal-heading-lg">{t('trust.heading')}</h2>

      <div class="trust-cards">
        {
          cards.map((card) => (
            <div class="trust-card brutal-frosted">
              <h3>{t(`trust.${card}.title`)}</h3>
              <p>{t(`trust.${card}.body`)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Component styles following design system patterns */
  .why-clients-trust-us {
    padding: var(--spacing-3xl) 0;
    background: transparent;
    position: relative;
  }

  .trust-content {
    max-width: 1200px;
    margin: 0 auto;
  }

  .brutal-heading-lg {
    margin-bottom: var(--spacing-2xl);
    text-align: center;
  }

  .trust-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-extra-wide);
  }

  .trust-card {
    padding: var(--spacing-2xl);
    background: transparent;
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    border-radius: 0;
    transition: border-color var(--transition-normal);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .trust-card:hover {
    border-color: var(--color-primary);
  }

  .trust-card h3 {
    font-size: var(--text-lg);
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    line-height: 1.4;
  }

  .trust-card p {
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.7;
    flex-grow: 1;
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .trust-cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gap-wide);
    }

    .trust-card {
      padding: var(--spacing-xl);
    }

    .trust-card h3 {
      font-size: var(--text-base);
    }

    .trust-card p {
      font-size: var(--text-small);
    }
  }

  @media (max-width: 768px) {
    .why-clients-trust-us {
      padding: var(--spacing-2xl) 0;
    }

    .brutal-heading-lg {
      margin-bottom: var(--spacing-xl);
    }

    .trust-cards {
      grid-template-columns: 1fr;
      gap: var(--gap-normal);
    }

    .trust-card {
      padding: var(--spacing-lg);
    }

    .trust-card h3 {
      font-size: var(--text-base);
      margin-bottom: var(--spacing-sm);
    }

    .trust-card p {
      font-size: var(--text-small);
    }
  }

  @media (max-width: 480px) {
    .why-clients-trust-us {
      padding: var(--spacing-xl) 0;
    }

    .brutal-heading-lg {
      font-size: var(--text-xl);
      margin-bottom: var(--spacing-lg);
    }

    .trust-cards {
      gap: var(--gap-normal);
    }

    .trust-card {
      padding: var(--spacing-md);
    }

    /* No `text-align` here. A centered title over a left-aligned paragraph
       inside the same bordered box is mixed alignment, not a mobile
       treatment — and ≤480 was the ONLY width that did it, so the card
       changed axis at one breakpoint for no stated reason. Added
       incidentally in af3abe41 (2026-04-15), a three-concern PR; removed
       2026-09-01 so the title agrees with the body, as it does at every
       other width. */
    .trust-card h3 {
      font-size: var(--text-small);
      margin-bottom: var(--spacing-sm);
    }

    .trust-card p {
      font-size: var(--text-tiny);
      line-height: 1.6;
    }
  }
</style>
