---
// CTASection.astro — the production CTA shell: singleton `id="contact"`
// section landmark, `.cta-section` spacing, and the script wiring trackCTA
// to window for the inline onclick handlers CTABox renders. The visual box
// lives in CTABox.astro so /brand can render the same component without
// duplicating this wrapper's singleton id (BL-095 AC-2). `demoHref` is
// excluded from this wrapper's Props so no page can reach the demo branch
// through it.
import CTABox from './CTABox.astro';
import type { Props as CTABoxProps } from './CTABox.astro';

type Props = Omit<CTABoxProps, 'demoHref'>;
---

<section class="cta-section" id="contact" aria-label="Schedule a consultation">
  <div class="container">
    <CTABox {...Astro.props} />
  </div>
</section>

<style>
  .cta-section {
    padding: 4rem 0;
    /* text-align: center moved onto `.cta-box` (CTABox.astro) in the BL-095
       extraction — computed-identical, the box is this section's only content. */
  }

  @media (max-width: 480px) {
    .cta-section {
      padding: 2.5rem 0;
    }
  }
</style>

<script>
  import { trackCTA } from '../utils/analytics';

  // Make trackCTA available to inline onclick handlers.
  // TODO(phase-3): replace with proper ambient `Window` type declaration.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  (window as any).trackCTA = trackCTA;
</script>
