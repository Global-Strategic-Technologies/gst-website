---
/**
 * SEO Component
 * Provides structured data, meta tags, and Open Graph tags for SEO optimization
 * Includes JSON-LD for search engine indexing and social media sharing
 */

interface Props {
  title?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  canonicalUrl?: string;
  // Enhanced social media meta tags
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogSiteName?: string;
  ogLocale?: string;
  twitterSite?: string;
  faqItems?: Array<{ question: string; answer: string }>;
  /**
   * Keep this page out of the search index. Emits `noindex, follow` —
   * `follow` is retained deliberately so outbound link equity still flows.
   * Pair every `noindex` page with a sitemap exclusion in
   * `src/utils/sitemap-filter.ts`; submitting a URL you also tell crawlers
   * to drop is a contradictory signal.
   */
  noindex?: boolean;
  /**
   * Page locale from the registry (BL-153). Drives `og:locale`, the hreflang
   * alternates, the localized BreadcrumbList names and `inLanguage`. Defaults
   * to English so callers outside BaseLayout are unchanged. A DRAFT locale
   * forces `noindex` — its pages are reachable for review but never indexed.
   */
  locale?: Locale;
}

const {
  title = 'GST | M&A Strategic Technology Advisory',
  ogTitle,
  ogDescription = 'Specialized technical diligence and AI strategy for organizations navigating complex product transitions.',
  ogImage = '/og-image.png',
  ogType = 'website',
  ogUrl,
  canonicalUrl,
  // Enhanced social media meta tags
  ogImageAlt = 'GST - M&A Strategic Technology Advisory and Technical Due Diligence',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = 'image/png',
  ogSiteName = 'GST',
  ogLocale: ogLocaleProp,
  twitterSite = '@globalstrategic',
  faqItems,
  noindex: noindexProp = false,
  locale = DEFAULT_LOCALE,
} = Astro.props;

// A draft locale is never indexed, whatever the page asked for.
const noindex = noindexProp || locale.status === 'draft';
const robotsDirective = noindex ? 'noindex, follow' : 'index, follow';

const ogLocale = ogLocaleProp ?? locale.ogLocale;

// Derive og:title from page title when not explicitly provided
const finalOgTitle = ogTitle || title;

import { slugToName } from '../utils/breadcrumbs';
import { DEFAULT_LOCALE, localeFromPath, type Locale } from '../i18n/locales';
import { absoluteLocalizedUrl, alternatesFor, localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';

const { t } = useTranslations(locale, 'common');

// Use Astro.site (from astro.config.mjs) for stable URLs across environments
const siteBase = Astro.site?.origin || `${Astro.url.protocol}//${Astro.url.host}`;
const currentPath = Astro.url.pathname;
const currentUrl = `${siteBase}${currentPath}`;
const baseUrl = siteBase;

// hreflang (BL-153). Alternates are the LIVE locales that carry this route. A
// list of one means "no alternates" — English-only route, or a DRAFT page —
// and emits no cluster at all (a cluster of one is noise; a draft-to-English
// link would be non-reciprocal). `x-default` points at the English URL.
const { routePath } = localeFromPath(currentPath);
const alternates = alternatesFor(routePath, locale);
const hreflangLinks =
  alternates.length > 1
    ? [
        ...alternates.map((alt) => ({
          hreflang: alt.htmlLang,
          href: absoluteLocalizedUrl(siteBase, routePath, alt),
        })),
        { hreflang: 'x-default', href: absoluteLocalizedUrl(siteBase, routePath, DEFAULT_LOCALE) },
      ]
    : [];
const ogLocaleAlternates = alternates.filter((alt) => alt !== locale).map((alt) => alt.ogLocale);

// Use provided URLs or auto-generate from current page
const finalCanonicalUrl = canonicalUrl || currentUrl;
const finalOgUrl = ogUrl || currentUrl;

// Convert relative image paths to absolute URLs
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${baseUrl}${ogImage.startsWith('/') ? ogImage : '/' + ogImage}`;

// Build BreadcrumbList from the locale-free pathname (the locale prefix is not
// a crumb), with names and item URLs in the page locale — mirrors Breadcrumb.astro.
const pathname = routePath.replace(/\/$/, '');
const segments = pathname.split('/').filter(Boolean);
const isHomepage = segments.length === 0;

const breadcrumbJsonLd = !isHomepage
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('breadcrumb.home'),
          item: `https://globalstrategic.tech${localizedHref('/', locale)}`,
        },
        ...segments.map((slug, index) => {
          const position = index + 2;
          const name = slugToName(slug, locale);
          const isLast = index === segments.length - 1;
          const path = '/' + segments.slice(0, index + 1).join('/') + '/';

          return isLast
            ? { '@type': 'ListItem' as const, position: position, name: name }
            : {
                '@type': 'ListItem' as const,
                position: position,
                name: name,
                item: `https://globalstrategic.tech${localizedHref(path, locale)}`,
              };
        }),
      ],
    }
  : null;

// Build FAQPage schema when faqItems are provided.
// Answers may carry limited HTML (Google's FAQ rich-result guidance allows
// anchors), but the JSON-LD copy is read out of page context, where a relative
// href resolves to nothing. Absolutize root-relative hrefs for the structured
// data only — the rendered set:html answers keep the site-relative form. The
// (?!\/) guard leaves protocol-relative //host URLs alone.
const absolutizeFaqHrefs = (answer: string): string =>
  answer.replace(/href="\/(?!\/)/g, `href="${siteBase}/`);

const faqJsonLd =
  faqItems && faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: absolutizeFaqHrefs(item.answer),
          },
        })),
      }
    : null;

