---
/**
 * The brand delta, inline so it inherits `currentColor` (never an <img>).
 *
 * A class you pass in lands on THIS file's `<svg>`, so it never receives the
 * CALLER's scope attribute — a bare `.your-class { … }` in the calling
 * component's `<style>` compiles to `.your-class[data-astro-cid-CALLER]` and
 * matches nothing, silently. Style it through a scoped ancestor instead:
 * `.your-row :global(.your-class) { … }`. See STYLES_GUIDE § "The scoped-rule /
 * foreign-element trap" and § "When `:global()` Is Necessary" case 3; BL-150
 * tracks seven selectors already lost this way.
 *
 * `filled` (BL-153) paints the same path solid in `currentColor` instead of
 * stroking it — the marker the language menu puts on the current locale. It is
 * additive: the default rendering is byte-identical to before the prop existed.
 */
interface Props {
  size?: number;
  class?: string;
  /** Solid `currentColor` fill, no stroke. Default: stroked outline. */
  filled?: boolean;
}
const { size = 14, class: className = '', filled = false } = Astro.props;
---

<svg
  viewBox="0 0 64 64"
  fill={filled ? 'currentColor' : 'none'}
  aria-hidden="true"
  width={size}
  height={size}
  class={className}
  style="flex-shrink:0;"
>
  <path
    d="M32 12 L52 52 L12 52 Z"
    fill={filled ? 'currentColor' : 'none'}
    stroke={filled ? undefined : 'currentColor'}
    stroke-width={filled ? undefined : '6'}
    stroke-linejoin="miter"></path>
</svg>
