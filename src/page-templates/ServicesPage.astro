---
/**
 * /services/ in every locale. Rendered by src/pages/services.astro (English)
 * and by src/pages/[locale]/[...route].astro. FAQ answers carry inline markup
 * and feed both the visible accordion and the FAQPage JSON-LD (SEO.astro
 * absolutizes the hrefs for the structured-data copy), so they come through
 * tHtml; the MCP answer's link is localized via an escaped {mcpHref} param.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';
import EngagementFlow from '../components/EngagementFlow.astro';
import PrintReportHeader from '../components/PrintReportHeader.astro';
import DeltaIcon from '../components/DeltaIcon.astro';
import type { Locale } from '../i18n/locales';
import { localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, tHtml } = useTranslations(locale, 'services');
const mcpHref = localizedHref('/hub/mcp/', locale);

const faqItems = ([1, 2, 3, 4, 5, 6] as const).map((n) => ({
  question: t(`faq.q${n}`),
  answer: tHtml(`faq.a${n}`, { mcpHref }),
}));

const serviceCards = (['card1', 'card2', 'card3'] as const).map((card) => ({
  title: t(`${card}.title`),
  subtitle: t(`${card}.subtitle`),
  items: ([1, 2, 3, 4] as const).map((n) => t(`${card}.item${n}`)),
}));

const audienceCards = (['card1', 'card2', 'card3'] as const).map((card) => ({
  title: t(`audience.${card}.title`),
  body: t(`audience.${card}.body`),
}));
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  ogTitle={t('meta.ogTitle')}
  ogDescription={t('meta.ogDescription')}
  ogImage="/og-image.png"
  ogImageAlt={t('meta.ogImageAlt')}
  faqItems={faqItems}
>
  <PrintReportHeader title={t('print.title')} locale={locale} />

  <Hero
    title={t('hero.title')}
    subtitle={t('hero.subtitle')}
    description={t('hero.description')}
    locale={locale}
  />

  <section class="services-section">
    <div class="container">
      <div class="services-cards">
        {
          serviceCards.map((card) => (
            <div class="service-card brutal-frosted">
              <h2>{card.title}</h2>
              <span class="service-subtitle">{card.subtitle}</span>
              <ul class="service-list">
                {card.items.map((item) => (
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mcp-offer">
    <div class="container">
      <div class="mcp-offer__panel brutal-frosted">
        <span class="mcp-offer__label">{t('mcp.label')}</span>
        <h2 class="brutal-heading-lg">{t('mcp.heading')}</h2>
        <p>{t('mcp.body')}</p>
        <a href={mcpHref} class="cta-button" onclick="trackNavigation('/hub/mcp', 'MCP Server')"
          >{t('mcp.cta')}</a
        >
      </div>
    </div>
  </section>

  <section class="audience-section">
    <div class="container">
      <div class="audience-content">
        <h2 class="brutal-heading-lg">{t('audience.heading')}</h2>
        <div class="audience-cards">
          {
            audienceCards.map((card) => (
              <div class="audience-card brutal-frosted">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <EngagementFlow locale={locale} />

  <section class="faq-section">
    <div class="container">
      <h2 class="brutal-heading-lg">{t('faq.heading')}</h2>
      <div class="brutal-faq brutal-faq--lg">
        {
          faqItems.map((item) => (
            <details class="brutal-faq__item">
              <summary class="brutal-faq__question">
                <span>{item.question}</span>
                <DeltaIcon class="delta-chevron" />
              </summary>
              <div class="brutal-faq__answer" set:html={item.answer} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title={t('cta.title')}
    description={t('cta.description')}
    buttonText={t('cta.button')}
    bookingUrl="https://calendarbridge.com/book/globalstrategictech/"
    emailAddress="contact@globalstrategic.tech"
    locale={locale}
  />
</BaseLayout>

<style>
  .services-section {
    padding: var(--spacing-2_5xl) 0;
  }

  .mcp-offer {
    padding: 0 0 var(--spacing-2_5xl);
  }

  .mcp-offer__panel {
    padding: var(--spacing-2_5xl);
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    border-left: 3px solid var(--color-primary);
  }

  .mcp-offer__label {
    display: block;
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tertiary);
    margin-bottom: var(--spacing-sm);
  }

  .mcp-offer__panel h2 {
    margin-bottom: var(--spacing-lg);
  }

  .mcp-offer__panel p {
    max-width: 800px;
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-xl);
  }

  .services-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2_5xl);
  }

  .service-card {
    padding: var(--spacing-2_5xl);
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    border-top: 3px solid var(--color-primary);
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-card:hover {
    border-color: var(--color-primary);
  }

  .service-card h2 {
    font-size: var(--text-2xl);
    font-family: var(--font-family-mono);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--spacing-sm);
    line-height: 1.3;
  }

  .service-subtitle {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tertiary);
    margin-bottom: var(--spacing-xl);
    display: block;
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .service-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    font-size: var(--text-base);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .service-list .bullet-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 0.3em;
    opacity: 0.7;
  }

  .audience-section {
    padding: var(--spacing-3xl) 0;
  }

  .audience-content {
    max-width: 1100px;
    margin: 0 auto;
  }

  .audience-content .brutal-heading-lg {
    margin-bottom: var(--spacing-2xl);
    text-align: center;
  }

  .audience-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2_5xl);
  }

  .audience-card {
    padding: var(--spacing-2xl);
    border-left: 3px solid var(--color-primary);
  }

  .audience-card h3 {
    font-size: var(--text-lg);
    font-family: var(--font-family-mono);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .audience-card p {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .audience-cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-1_75);
    }
  }

  @media (max-width: 768px) {
    .audience-section {
      padding: var(--spacing-2xl) 0;
    }

    .audience-cards {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }

    .audience-card {
      padding: var(--spacing-xl);
    }

    .audience-card h3 {
      font-size: var(--text-base);
    }

    .audience-card p {
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 480px) {
    .audience-card {
      padding: var(--spacing-1_25);
    }

    .audience-card h3 {
      font-size: var(--text-base);
    }

    .audience-card p {
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 1024px) {
    .services-cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-1_75);
    }

    .service-card {
      padding: var(--spacing-1_75);
    }

    .service-card h2 {
      font-size: var(--text-xl);
    }

    .service-list li {
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 768px) {
    /* .services-section deliberately has no override here: the 768px rule was
       byte-identical to the base rule, so it only ever restated it. */
    .services-cards {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }

    .service-card {
      padding: var(--spacing-xl);
    }

    .service-card h2 {
      font-size: var(--text-lg);
    }

    .service-list li {
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 480px) {
    .services-section {
      padding: var(--spacing-2xl) 0;
    }

    .services-cards {
      gap: var(--spacing-1_25);
    }

    .service-card {
      padding: var(--spacing-1_25);
    }

    .service-card h2 {
      font-size: var(--text-base);
    }

    .service-list li {
      font-size: var(--text-sm);
    }

    .service-list .bullet-icon {
      width: 12px;
      height: 12px;
    }
  }

  .faq-section {
    padding: var(--spacing-3xl) 0;
  }

  .faq-section .brutal-heading-lg {
    margin-bottom: var(--spacing-2xl);
    text-align: center;
  }

  .brutal-faq {
    max-width: 800px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: var(--spacing-2xl) 0;
    }
  }

  /* Print */
  @media print {
    .service-card {
      break-inside: avoid;
    }

    .brutal-faq__item {
      break-inside: avoid;
    }

    @page {
      margin: 1.5cm;
    }
  }
</style>

<script>
  import { trackEvent } from '../utils/analytics';

  // The MCP offer section's inline onclick calls `trackNavigation`, which is
  // NOT wired here: `Header.astro` puts it on `window` and BaseLayout renders
  // that header on every page. A second assignment here was redundant.

  document.querySelectorAll('.brutal-faq__item').forEach((item) => {
    item.addEventListener('toggle', () => {
      const details = item as HTMLDetailsElement;
      const question = details.querySelector('.brutal-faq__question')?.textContent?.trim() || '';
      trackEvent({
        event: 'faq_interaction',
        category: 'engagement',
        question,
        action: details.open ? 'open' : 'close',
        page: 'services',
      });
    });
  });
</script>
