---
/**
 * /hub/tools/tech-debt-calculator/ in every locale. Rendered by
 * src/pages/hub/tools/tech-debt-calculator/index.astro (English) and by
 * src/pages/[locale]/[...route].astro. A Tier B route (`TIER_B_ROUTES`).
 *
 * Every user-visible string in the markup comes from the
 * `tech-debt-calculator` catalog; the strings the client script paints at
 * runtime travel in the `data-tech-debt-strings` island at the bottom. Hooks
 * (`id`, `class`, `data-*`, ARIA wiring) are untouched: the script and the E2E
 * suite read them.
 *
 * Literals that stay in this file are not language: slider bounds and starting
 * positions, currency codes, and the tool name. Deploy-frequency labels are the
 * engine's `DEPLOY_OPTIONS` (an MCP contract, English) translated here by index.
 * `knowsAbout` in the JSON-LD stays an English literal —
 * `tests/unit/hub-tool-schema.test.ts` parses it.
 *
 * Numbers are formatted with `locale.htmlLang`, the tag the client script reads
 * from `<html lang>`, so the first paint matches what the script repaints
 * (ADR-0030, the 2026-10-26 note in the 2026-10-24 amendment).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/hub/HubHeader.astro';
import PrintReportHeader from '../components/PrintReportHeader.astro';
import { DEPLOY_OPTIONS, DEFAULT_STATE } from '../utils/tech-debt-engine';
import { hubToolSchema } from '../utils/hub-tool-schema';
import { formatMoneyShort } from '../i18n/currency';
import { formatNumber } from '../i18n/formatters';
import { isDefaultLocale, type Locale } from '../i18n/locales';
import { localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';
import { SCRIPT_STRING_KEYS } from '../scripts/tech-debt-calculator/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, tHtml } = useTranslations(locale, 'tech-debt-calculator');

// Script strings and index-keyed labels are computed keys, so they are looked
// up through the untyped catalog view.
const tAny = t as (key: string, params?: Record<string, string | number>) => string;
const SCRIPT_STRINGS = Object.fromEntries(SCRIPT_STRING_KEYS.map((key) => [key, tAny(key)]));

const lang = locale.htmlLang;
const money = (n: number) => formatMoneyShort(n, 'USD', lang);
const pct = (n: number) => tAny('js.unit.pct', { n: formatNumber(n, lang) });
const pageHref = localizedHref('/hub/tools/tech-debt-calculator/', locale);
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  ogTitle={t('meta.ogTitle')}
  ogDescription={t('meta.ogDescription')}
  ogImage="/og-image.png"
  ogImageAlt={t('meta.ogImageAlt')}
  ogUrl={`https://globalstrategic.tech${pageHref}`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      hubToolSchema({
        name: 'Technical Debt Cost Calculator',
        description: t('jsonld.description'),
        datePublished: '2025-06-01',
        dateModified: '2026-10-26',
        inLanguage: locale.htmlLang,
        featureList: [
          t('jsonld.feature1'),
          t('jsonld.feature2'),
          t('jsonld.feature3'),
          t('jsonld.feature4'),
        ],
        knowsAbout: [
          'Technical Due Diligence',
          'Technical Debt Assessment',
          'M&A Tech Strategy',
          'DORA Metrics',
          'Software Engineering Economics',
        ],
      })
    )}
  />
  <section class="tdc-section">
    <div class="container">
      <HubHeader
        title="Tech Debt Cost Calculator"
        subtitle={t('header.subtitle')}
        locale={locale}
      />

      <PrintReportHeader title={t('print.title')} locale={locale} />

      <div data-calc class="brutal-tool-shell brutal-tool-shell--wide">
        <p class="brutal-tool-shell__authority tdc-authority">{t('authority')}</p>

        <!-- Shared-link range-adjustment notice (populated by decodeState on load) -->
        <p class="tdc-shared-notice" data-shared-notice role="status" aria-live="polite" hidden></p>

        <!-- ── Core inputs ─────────────────────────────────────────── -->
        <div class="inputs-section">
          <div class="brutal-tool-shell__section-label section-label">{t('section.teamCost')}</div>

          <div class="sliders-stack">
            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-team-size">
                  {t('label.teamSize')}
                </label>
                <span class="brutal-slider__value" data-display="team-size">
                  {DEFAULT_STATE.teamSize}
                </span>
              </div>
              <input
                id="input-team-size"
                type="range"
                min="0"
                max="100"
                step="0.1"
                class="brutal-slider__input"
                data-input="team-size"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="14"
                aria-valuetext={tAny('js.aria.engineers', { n: DEFAULT_STATE.teamSize })}
              />
              <div class="brutal-slider__hints">
                <input
                  type="number"
                  class="brutal-slider__direct"
                  data-direct="team-size"
                  min="1"
                  max="500"
                  step="1"
                  value="8"
                  aria-label={t('aria.teamSize')}
                />
              </div>
              <span
                class="brutal-slider__clamp-msg brutal-text-tiny"
                data-clamp-msg="team-size"
                role="status"
                aria-live="polite"
                style="display:none"
              ></span>
            </div>

            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-salary">
                  {t('label.salary')}
                </label>
                <span class="brutal-slider__value" data-display="salary">
                  {money(DEFAULT_STATE.salary)}
                </span>
              </div>
              <input
                id="input-salary"
                type="range"
                min="0"
                max="100"
                step="0.1"
                class="brutal-slider__input"
                data-input="salary"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="31"
                aria-valuetext={money(DEFAULT_STATE.salary)}
              />
              <div class="brutal-slider__hints">
                <input
                  type="text"
                  class="brutal-slider__direct"
                  data-direct="salary"
                  value="150000"
                  aria-label={t('aria.salary')}
                />
              </div>
              <span
                class="brutal-slider__clamp-msg brutal-text-tiny"
                data-clamp-msg="salary"
                role="status"
                aria-live="polite"
                style="display:none"
              ></span>
            </div>

            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-maint-pct">
                  {t('label.maintPct')}
                </label>
                <span class="brutal-slider__value" data-display="maint-pct">
                  {pct(DEFAULT_STATE.maintPct)}
                </span>
              </div>
              <input
                id="input-maint-pct"
                type="range"
                min="0"
                max="100"
                step="1"
                class="brutal-slider__input"
                data-input="maint-pct"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="25"
                aria-valuetext={pct(DEFAULT_STATE.maintPct)}
              />
              <div class="brutal-slider__hints">
                <input
                  type="number"
                  class="brutal-slider__direct"
                  data-direct="maint-pct"
                  min="0"
                  max="100"
                  step="1"
                  value="25"
                  aria-label={t('aria.maintPct')}
                />
              </div>
              <span
                class="brutal-slider__clamp-msg brutal-text-tiny"
                data-clamp-msg="maint-pct"
                role="status"
                aria-live="polite"
                style="display:none"
              ></span>
              <div class="slider-benchmark">{t('help.maint')}</div>
              <div class="slider-benchmark">{t('help.maintBands')}</div>
            </div>
          </div>
        </div>

        <!-- ── Advanced inputs (collapsible) ──────────────────────── -->
        <div class="advanced-section">
          <button data-advanced-toggle type="button" class="advanced-toggle" aria-expanded="false">
            <span data-toggle-label>{t('js.advanced.show')}</span>
            <span class="toggle-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M4 6l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
          </button>

          <div data-advanced-panel class="advanced-panel is-hidden">
            <div class="brutal-tool-shell__section-label section-label">
              {t('section.delivery')}
            </div>
            <div class="sliders-grid-2">
              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-incidents">
                    {t('label.incidents')}
                  </label>
                  <span class="brutal-slider__value" data-display="incidents">
                    {DEFAULT_STATE.incidents}
                  </span>
                </div>
                <input
                  id="input-incidents"
                  type="range"
                  min="0"
                  max="20"
                  step="1"
                  class="brutal-slider__input"
                  data-input="incidents"
                  aria-valuemin="0"
                  aria-valuemax="20"
                  aria-valuenow="3"
                  aria-valuetext={tAny('js.aria.perMonth', { n: DEFAULT_STATE.incidents })}
                />
                <div class="brutal-slider__hints">
                  <input
                    type="number"
                    class="brutal-slider__direct"
                    data-direct="incidents"
                    min="0"
                    max="20"
                    step="1"
                    value="3"
                    aria-label={t('aria.incidents')}
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="incidents"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>

              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-mttr">
                    {t('label.mttr')}
                  </label>
                  <span class="brutal-slider__value" data-display="mttr">
                    {tAny('js.unit.hours', { n: DEFAULT_STATE.mttr })}
                  </span>
                </div>
                <input
                  id="input-mttr"
                  type="range"
                  min="1"
                  max="48"
                  step="1"
                  class="brutal-slider__input"
                  data-input="mttr"
                  aria-valuemin="1"
                  aria-valuemax="48"
                  aria-valuenow="4"
                  aria-valuetext={tAny('js.aria.hours', { n: DEFAULT_STATE.mttr })}
                />
                <div class="brutal-slider__hints">
                  <input
                    type="number"
                    class="brutal-slider__direct"
                    data-direct="mttr"
                    min="1"
                    max="48"
                    step="1"
                    value="4"
                    aria-label={t('aria.mttr')}
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="mttr"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>
            </div>

            <div class="context-switch-toggle">
              <label class="brutal-toggle">
                <input type="checkbox" id="input-context-switch" data-input="context-switch" />
                <span class="brutal-toggle__label">{t('toggle.contextSwitch')}</span>
              </label>
              <span class="brutal-toggle__hint">{t('toggle.contextSwitchHint')}</span>
            </div>

            <div class="brutal-tool-shell__section-label section-label section-label--spaced">
              {t('section.deploy')}
            </div>
            <div class="deploy-grid">
              {DEPLOY_OPTIONS.map((_opt, i) => (
                <button
                  data-deploy-btn={i}
                  class={`deploy-btn${i === DEFAULT_STATE.deployIdx ? ' active' : ''}`}
                  type="button"
                  aria-pressed={i === DEFAULT_STATE.deployIdx ? 'true' : 'false'}
                >
                  {tAny(`deploy.${i}`)}
                </button>
              ))}
            </div>
            <div data-dora-message class="dora-message"></div>

            <div class="brutal-tool-shell__section-label section-label section-label--spaced">
              {t('section.roi')}
            </div>
            <div class="sliders-grid-2">
              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-arr">
                    {t('label.arr')}
                  </label>
                  <span class="brutal-slider__value" data-display="arr">
                    {money(DEFAULT_STATE.arr)}
                  </span>
                </div>
                <input
                  id="input-arr"
                  type="range"
                  min="0"
                  max="100"
                  step="0.1"
                  class="brutal-slider__input"
                  data-input="arr"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="37"
                  aria-valuetext={money(DEFAULT_STATE.arr)}
                />
                <div class="brutal-slider__hints">
                  <input
                    type="text"
                    class="brutal-slider__direct"
                    data-direct="arr"
                    value="10000000"
                    aria-label={t('aria.arr')}
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="arr"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>

              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-budget">
                    {t('label.budget')}
                  </label>
                  <span class="brutal-slider__value" data-display="budget">
                    {money(DEFAULT_STATE.remediationBudget)}
                  </span>
                </div>
                <input
                  id="input-budget"
                  type="range"
                  min="0"
                  max="100"
                  step="0.1"
                  class="brutal-slider__input"
                  data-input="budget"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="33"
                  aria-valuetext={money(DEFAULT_STATE.remediationBudget)}
                />
                <div class="brutal-slider__hints">
                  <input
                    type="text"
                    class="brutal-slider__direct"
                    data-direct="budget"
                    value="500000"
                    aria-label={t('aria.budget')}
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="budget"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>
            </div>

            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-remediation">
                  {t('label.remediation')}
                </label>
                <span class="brutal-slider__value" data-display="remediation">
                  {pct(DEFAULT_STATE.remediationPct)}
                </span>
              </div>
              <input
                id="input-remediation"
                type="range"
                min="0"
                max="100"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="70"
                aria-valuetext={pct(DEFAULT_STATE.remediationPct)}
                step="1"
                value="70"
                class="brutal-slider__input"
                data-input="remediation"
              />
              <div class="brutal-slider__hints">
                <span>{pct(0)}</span>
                <span>{pct(100)}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Results panel ───────────────────────────────────────── -->
        <div class="results-section" role="status" aria-live="polite" aria-atomic="false">
          <div class="brutal-tool-shell__section-label section-label">{t('section.results')}</div>

          <!-- Primary figure -->
          <div class="result-primary">
            <div>
              <div class="result-cost-label">{t('results.annualCost')}</div>
              <div class="result-cost-value" data-metric="annual-cost">
                —
              </div>
              <div class="result-cost-sub">
                <span data-metric="per-month">—</span>
                {t('results.perMonthSuffix')}
              </div>
            </div>
          </div>

          <!-- Core metrics grid -->
          <div class="result-grid">
            <div class="result-stat">
              <div class="result-stat-label">{t('results.hrsLost')}</div>
              <div class="result-stat-value" data-metric="hrs-lost">
                —
              </div>
            </div>
            <div class="result-stat">
              <div class="result-stat-label">{t('results.costPerEng')}</div>
              <div class="result-stat-value" data-metric="cost-per-eng">
                —
              </div>
            </div>
            <div class="result-stat">
              <div class="result-stat-label">{t('results.ftesLost')}</div>
              <div class="result-stat-value" id="ctx-engs-lost">
                —
              </div>
            </div>
            <div class="result-stat">
              <div class="result-stat-label">{t('results.burdenLevel')}</div>
              <div class="result-stat-value" id="ctx-burden-label">
                —
              </div>
              <div class="result-stat-range" id="ctx-burden-range"></div>
            </div>
          </div>

          <!-- Advanced metrics — only visible when advanced is open -->
          <div data-adv-results class="adv-results is-hidden">
            <div class="adv-results__grid">
              <div class="result-stat">
                <div class="result-stat-label">{t('results.directLabor')}</div>
                <div class="result-stat-value" data-metric="direct-labor">
                  —
                </div>
              </div>
              <div class="result-stat" id="ctx-switch-stat" style="display:none;">
                <div class="result-stat-label">{t('results.contextSwitch')}</div>
                <div class="result-stat-value" data-metric="context-switch">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">{t('results.incidentLabor')}</div>
                <div class="result-stat-value" data-metric="incident-labor">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">{t('results.velocity')}</div>
                <div class="result-stat-value" data-metric="velocity">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">{t('results.debtPctArr')}</div>
                <div class="result-stat-value" data-metric="debt-pct-arr">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">{t('results.breakEven')}</div>
                <div class="result-stat-value" id="payback-breakeven">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">{t('results.monthlySavings')}</div>
                <div class="result-stat-value result-stat-value--teal" id="payback-savings">
                  —
                </div>
              </div>
            </div>
            <div class="payback-disclaimer" id="payback-disclaimer"></div>
          </div>

          <!-- Contextual note -->
          <p class="result-note" id="ctx-note"></p>
        </div>

        <!-- ── Methodology ─────────────────────────────────────────── -->
        <details class="tool-methodology">
          <summary class="tool-methodology__trigger">{t('method.summary')}</summary>
          <div class="tool-methodology__body">
            <h4 class="tool-methodology__heading">{t('method.cost.heading')}</h4>
            <p>{t('method.cost.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.dora.heading')}</h4>
            <p set:html={tHtml('method.dora.body')} />

            <h4 class="tool-methodology__heading">{t('method.burden.heading')}</h4>
            <p>{t('method.burden.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.payback.heading')}</h4>
            <p>{t('method.payback.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.limits.heading')}</h4>
            <p>{t('method.limits.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.currency.heading')}</h4>
            <p>{t('method.currency.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.privacy.heading')}</h4>
            <p
              set:html={tHtml('method.privacy.body', {
                privacyHref: localizedHref('/privacy/', locale),
              })}
            />

            <p class="tool-methodology__updated">{t('method.updated')}</p>
          </div>
        </details>

        <!-- ── Footer ──────────────────────────────────────────────── -->
        <div class="calc-footer">
          <div class="calc-footer__controls tool-action-bar">
            <select
              id="currency-select"
              class="currency-select"
              aria-label={t('actions.currencyAria')}
            >
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
              <option value="GBP">GBP</option>
              <option value="BRL">BRL</option>
              <option value="CAD">CAD</option>
              <option value="AUD">AUD</option>
            </select>
            <button
              id="export-pdf-btn"
              type="button"
              class="brutal-btn brutal-btn--secondary copy-link-btn"
              aria-label={t('actions.exportPdfAria')}
            >
              {t('actions.exportPdf')}
            </button>
            <button
              id="copy-summary-btn"
              type="button"
              class="brutal-btn brutal-btn--secondary copy-link-btn"
              aria-label={t('actions.copySummaryAria')}
            >
              {t('actions.copySummary')}
            </button>
            <button
              id="copy-link-btn"
              type="button"
              class="brutal-btn brutal-btn--secondary copy-link-btn"
              aria-label={t('actions.copyLinkAria')}
            >
              {t('actions.copyLink')}
            </button>
          </div>
        </div>

        <!-- Print-only footer (hidden on screen) -->
        <div class="print-report-footer" aria-hidden="true">
          <p>{t('print.footer', { url: `globalstrategic.tech${pageHref}` })}</p>
          <p>{t('print.disclaimer')}</p>
        </div>
      </div>

      <a href={localizedHref('/hub/tools/', locale)} class="cta-button back-link">
        {t('nav.back')}
      </a>
    </div>
  </section>
  {/* English needs no island: strings.ts falls back to the English catalog. */}
  {!isDefaultLocale(locale) && (
    <script
      is:inline
      type="application/json"
      data-tech-debt-strings
      set:html={JSON.stringify(SCRIPT_STRINGS).replace(/</g, '\\u003c')}
    />
  )}
</BaseLayout>

<style>
  /* ── Page wrapper ─────────────────────────────────────────────────────── */
  .tdc-section {
    padding-bottom: var(--spacing-3xl);
  }

  /* ── Calculator shell — base styles provided by global .tool-shell + .tool-shell--wide ── */

  /* ── Authority line ────────────────────────────────────────────────────── */
  .tdc-authority {
    padding: var(--spacing-sm) var(--spacing-2xl);
  }

  /* ── Shared-link range-adjustment notice ───────────────────────────────── */
  .tdc-shared-notice {
    margin: 0 var(--spacing-2xl) var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    border-left: 3px solid var(--color-secondary);
    background: color-mix(in srgb, var(--color-secondary) 8%, transparent);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-primary);
  }

  .tdc-shared-notice[hidden] {
    display: none;
  }

  /* ── Shared section padding ───────────────────────────────────────────── */
  .inputs-section,
  .results-section {
