---
/**
 * /hub/tools/infrastructure-cost-governance/ in every locale. Rendered by
 * src/pages/hub/tools/infrastructure-cost-governance/index.astro (English) and
 * by src/pages/[locale]/[...route].astro. A Tier B route (`TIER_B_ROUTES`).
 *
 * Every user-visible string comes from the `infrastructure-cost-governance`
 * catalog. The client script renders the wizard and results, so the domain,
 * question and recommendation text it needs travels in the
 * `data-icg-strings` island at the bottom, translated by id; the engine keeps
 * the English the MCP server emits. Hooks (`id`, `class`, `data-*`) are
 * untouched: the script and the E2E suite read them.
 *
 * Literals that stay: the tool name (also in the print header CSS), the
 * author's name and LinkedIn. The stages and their ranges come from the
 * engine's `BENCHMARK_RANGES`. `knowsAbout` in the JSON-LD
 * stays an English literal — `tests/unit/hub-tool-schema.test.ts` parses it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/hub/HubHeader.astro';
import { DOMAINS, TOTAL_QUESTIONS } from '../data/infrastructure-cost-governance/domains';
import { hubToolSchema } from '../utils/hub-tool-schema';
import { BENCHMARK_RANGES } from '../utils/icg-engine';
import { isDefaultLocale, type Locale } from '../i18n/locales';
import { localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';
import { SCRIPT_STRING_KEYS } from '../scripts/infrastructure-cost-governance/strings';
// The wizard's .brutal-progress-bar__track/__fill/__label rules are page-split
// into progress.css; without this import the bar rendered unstyled (BL-116).
import '../styles/components/progress.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, tHtml } = useTranslations(locale, 'infrastructure-cost-governance');

// Script strings and id-keyed labels are computed keys, so they are looked up
// through the untyped catalog view.
const tAny = t as (key: string, params?: Record<string, string | number>) => string;
const SCRIPT_STRINGS = Object.fromEntries(SCRIPT_STRING_KEYS.map((key) => [key, tAny(key)]));

const domainCount = DOMAINS.length;
// Stages and their ranges are the engine's (the MCP contract cites the same table).
const STAGES = BENCHMARK_RANGES.map((r) => ({ key: r.stageKey, range: `${r.low}-${r.high}` }));
// The methodology names the answer labels, maturity levels and foundational
// domains; they come from the same keys as the buttons and badges.
const terms = {
  a0: tAny('answer.0'),
  a1: tAny('answer.1'),
  a2: tAny('answer.2'),
  a3: tAny('answer.3'),
  d1: tAny('domain.d1.name'),
  d2: tAny('domain.d2.name'),
  reactive: tAny('maturity.Reactive'),
  aware: tAny('maturity.Aware'),
  optimizing: tAny('maturity.Optimizing'),
  strategic: tAny('maturity.Strategic'),
};
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  ogTitle={t('meta.ogTitle')}
  ogDescription={t('meta.ogDescription')}
  ogImage="/og-image.png"
  ogImageAlt={t('meta.ogImageAlt')}
  ogUrl={`https://globalstrategic.tech${localizedHref('/hub/tools/infrastructure-cost-governance/', locale)}`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      hubToolSchema({
        name: 'Infrastructure Cost Governance',
        description: t('jsonld.description'),
        datePublished: '2026-03-01',
        dateModified: '2026-10-26',
        inLanguage: locale.htmlLang,
        featureList: [
          t('jsonld.feature1'),
          t('jsonld.feature2'),
          t('jsonld.feature3'),
          t('jsonld.feature4'),
        ],
        knowsAbout: [
          'Cloud Cost Optimization',
          'Infrastructure Governance',
          'FinOps',
          'Technical Due Diligence',
          'M&A Tech Strategy',
        ],
      })
    )}
  />
  <section class="icg-section">
    <div class="container">
      <HubHeader
        title="Infrastructure Cost Governance"
        subtitle={t('header.subtitle')}
        locale={locale}
      />

      <div data-icg class="brutal-tool-shell brutal-tool-shell--narrow icg-shell">
        <!-- ── Landing view (step 0) ─────────────────────────────── -->
        <div data-view="landing">
          <div class="landing-content">
            <div class="brutal-callout landing-callout">
              <span class="brutal-callout__title">{t('landing.whoTitle')}</span>
              {t('landing.whoBody')}
            </div>

            <div class="stats-row">
              <div class="brutal-stat-tile">
                <div class="brutal-stat-tile__value">{domainCount}</div>
                <div class="brutal-stat-tile__label">{t('landing.statDomains')}</div>
              </div>
              <div class="brutal-stat-tile">
                <div class="brutal-stat-tile__value">{TOTAL_QUESTIONS}</div>
                <div class="brutal-stat-tile__label">{t('landing.statQuestions')}</div>
              </div>
              <div class="brutal-stat-tile">
                <div class="brutal-stat-tile__value">{t('landing.statTime')}</div>
                <div class="brutal-stat-tile__label">{t('landing.statTimeLabel')}</div>
              </div>
            </div>

            <div class="icg-stage-selector">
              <span class="icg-stage-selector__label brutal-label">
                {t('landing.stageLabel')}
                <span class="icg-stage-optional brutal-text-tiny">
                  {t('landing.stageOptional')}
                </span>
              </span>
              <div class="icg-stage-grid" data-stage-grid>
                {STAGES.map(({ key }) => (
                  <button
                    class="brutal-option-card brutal-option-card--compact"
                    data-stage={key}
                    type="button"
                  >
                    {tAny(`stage.${key}`)}
                  </button>
                ))}
              </div>
              <div class="icg-stage-hint brutal-text-tiny">{t('landing.stageHint')}</div>
            </div>

            <div data-resume-prompt class="brutal-callout icg-resume-prompt is-hidden">
              <p class="brutal-text-small icg-resume-prompt__text">{t('landing.resumeText')}</p>
              <div class="icg-resume-actions">
                <button data-action="resume" type="button" class="brutal-btn brutal-btn--secondary">
                  {t('landing.resume')}
                </button>
                <button
                  data-action="discard"
                  type="button"
                  class="brutal-btn brutal-btn--secondary"
                >
                  {t('landing.startFresh')}
                </button>
              </div>
            </div>

            <button
              data-action="start"
              type="button"
              class="brutal-btn brutal-btn--primary brutal-btn--full"
            >
              {t('landing.begin')}
            </button>

            <div class="tool-action-bar tool-action-bar--center">
              <button
                data-action="landing-copy"
                type="button"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.copyLinkLandingTitle')}
              >
                {t('actions.copyLink')}
              </button>
              <a
                data-action="landing-email"
                href="#"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.sendToLeadLandingTitle')}
              >
                {t('actions.sendToLead')}
              </a>
            </div>
          </div>
        </div>

        <!-- ── Wizard view (steps 1-6) ───────────────────────────── -->
        <div data-view="wizard" class="is-hidden">
          <div class="wizard-content">
            <!-- Progress bar -->
            <div class="brutal-progress-bar" style="margin-bottom: var(--spacing-xl)">
              <div class="brutal-progress-bar__track">
                <div class="brutal-progress-bar__fill" data-progress-fill></div>
              </div>
              <span class="brutal-progress-bar__label" data-progress-label></span>
            </div>

            <!-- Domain header -->
            <div class="icg-domain-header">
              <div class="icg-domain-header__meta">
                <span class="brutal-label icg-domain-label" data-domain-label></span>
                <span class="icg-foundational-badge is-hidden" data-foundational-badge>
                  {t('wizard.foundationalBadge')}
                </span>
              </div>
              <h2 class="brutal-heading-md icg-domain-name" data-domain-name></h2>
              <p class="brutal-text-small icg-domain-desc" data-domain-desc></p>
              <p class="brutal-text-small icg-foundational-note is-hidden" data-foundational-note>
                {t('wizard.foundationalNote')}
              </p>
            </div>

            <!-- Questions container -->
            <div data-questions-container class="icg-questions"></div>

            <!-- Navigation -->
            <div class="icg-wizard-nav">
              <button data-action="back" type="button" class="brutal-btn brutal-btn--secondary">
                {tAny('js.nav.backToIntro')}
              </button>
              <button
                data-action="next"
                type="button"
                class="brutal-btn brutal-btn--primary"
                disabled
              >
                {tAny('js.nav.nextDomain')}
              </button>
            </div>
          </div>
        </div>

        <!-- ── Results view (step 7) ─────────────────────────────── -->
        <div data-view="results" class="is-hidden">
          <div class="results-content">
            <!-- Maturity score -->
            <div class="icg-score-display" data-score-display>
              <div data-gauge-container class="icg-gauge"></div>
              <div class="icg-score-level brutal-heading-md" data-score-level></div>
              <div class="icg-score-desc brutal-text-small" data-score-desc></div>
              <div class="icg-stage-context brutal-text-small is-hidden" data-stage-context></div>
              <div class="icg-skipped-note brutal-text-tiny is-hidden" data-skipped-note></div>
            </div>

            <!-- Foundational flag (conditional) -->
            <div
              class="brutal-callout brutal-callout--warning icg-foundational-warning is-hidden"
              data-foundational-warning
            >
              <div class="brutal-callout__title" data-foundational-warning-title></div>
              <div
                class="icg-foundational-warning__text brutal-text-small"
                data-foundational-warning-text
              ></div>
            </div>

            <!-- Quick wins -->
            <div data-quick-wins class="brutal-callout icg-quick-wins is-hidden"></div>

            <!-- Radar chart -->
            <div class="icg-card">
              <div class="brutal-tool-shell__section-label">{t('results.domainProfile')}</div>
              <div data-radar-chart class="icg-radar"></div>
            </div>

            <!-- Domain breakdown -->
            <div class="icg-card">
              <div class="brutal-tool-shell__section-label">{t('results.domainBreakdown')}</div>
              <div data-domain-bars class="icg-domain-bars"></div>
            </div>

            <!-- Benchmark reference -->
            <div class="icg-card">
              <div class="brutal-tool-shell__section-label">{t('results.benchmark')}</div>
              <table class="brutal-bench-table">
                <tbody data-benchmark-body>
                  {STAGES.map(({ key, range }) => (
                    <tr data-stage-row={key}>
                      <td>{tAny(`stageRow.${key}`)}</td>
                      <td data-bench={range}>{range}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div class="tool-bench-note brutal-text-tiny">{t('results.benchNote')}</div>
            </div>

            <!-- Cost context -->
            <div class="brutal-callout icg-cost-context">
              <div class="brutal-text-small" set:html={tHtml('results.costContext')} />
            </div>

            <!-- Recommendations -->
            <div data-recs-container class="icg-recs"></div>

            <!-- Actions row -->
            <div class="tool-action-bar tool-action-bar--center tool-action-bar--bordered tool-action-bar--stack">
              <button
                data-action="copy-summary"
                type="button"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.copySummaryTitle')}
              >
                {t('actions.copySummary')}
              </button>
              <button
                data-action="copy"
                type="button"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.copyLinkTitle')}
              >
                {t('actions.copyLink')}
              </button>
              <button
                data-action="export-json"
                type="button"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.downloadJsonTitle')}
              >
                {t('actions.downloadJson')}
              </button>
              <button
                data-action="print"
                type="button"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.printTitle')}
              >
                {t('actions.print')}
              </button>
              <a
                data-action="email"
                href="#"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.sendToLeadTitle')}
              >
                {t('actions.sendToLead')}
              </a>
              <button
                data-action="compare"
                type="button"
                class="brutal-btn brutal-btn--secondary is-hidden"
                title={t('actions.compareTitle')}
              >
                {t('actions.compare')}
              </button>
              <button
                data-action="review"
                type="button"
                class="brutal-btn brutal-btn--secondary"
                title={t('actions.reviewTitle')}
              >
                {t('actions.review')}
              </button>
              <button data-action="reset" type="button" class="brutal-btn brutal-btn--secondary">
                {t('actions.startOver')}
              </button>
            </div>

            <!-- Snapshot save -->
            <div class="icg-snapshot-save-row">
              <input
                data-snapshot-label
                type="text"
                class="brutal-input icg-snapshot-label-input"
                placeholder={t('snapshots.labelPlaceholder')}
                maxlength="60"
              />
              <button
                data-action="save-snapshot"
                type="button"
                class="brutal-btn brutal-btn--secondary"
              >
                {tAny('js.saveSnapshot')}
              </button>
            </div>

            <!-- Snapshot manager -->
            <div data-snapshot-manager class="icg-snapshot-manager is-hidden">
              <div class="brutal-tool-shell__section-label">{t('snapshots.heading')}</div>
              <div data-snapshot-list class="icg-snapshot-list-items"></div>
              <button
                data-action="clear-snapshots"
                type="button"
                class="brutal-btn brutal-btn--secondary icg-snapshot-clear"
              >
                {t('snapshots.clearAll')}
              </button>
            </div>
          </div>
        </div>

        <!-- ── Comparison view ────────────────────────────────────── -->
        <div data-view="comparison" class="is-hidden">
          <div class="comparison-content">
            <div class="brutal-tool-shell__section-label">{t('comparison.heading')}</div>
            <div data-comparison-body></div>
            <div class="icg-comparison-actions">
              <button
                data-action="back-to-results"
                type="button"
                class="brutal-btn brutal-btn--secondary"
              >
                {t('comparison.back')}
              </button>
            </div>
          </div>
        </div>

        <!-- ── Methodology ─────────────────────────────────────────── -->
        <details class="tool-methodology tool-methodology--delta">
          <summary class="tool-methodology__trigger">{t('method.summary')}</summary>
          <div class="tool-methodology__body">
            <h4 class="tool-methodology__heading">{t('method.scoring.heading')}</h4>
            <p>{t('method.scoring.body', terms)}</p>

            <h4 class="tool-methodology__heading">{t('method.weighting.heading')}</h4>
            <p>{t('method.weighting.body', terms)}</p>

            <h4 class="tool-methodology__heading">{t('method.levels.heading')}</h4>
            <p>{t('method.levels.body', terms)}</p>

            <h4 class="tool-methodology__heading">{t('method.finops.heading')}</h4>
            <p set:html={tHtml('method.finops.body', terms)} />

            <h4 class="tool-methodology__heading">{t('method.flag.heading')}</h4>
            <p>{t('method.flag.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.recs.heading')}</h4>
            <p>{t('method.recs.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.bench.heading')}</h4>
            <p>{t('method.bench.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.snapshots.heading')}</h4>
            <p>{t('method.snapshots.body')}</p>

            <h4 class="tool-methodology__heading">{t('method.privacy.heading')}</h4>
            <p
              set:html={tHtml('method.privacy.body', {
                privacyHref: localizedHref('/privacy/', locale),
              })}
            />

            <p class="tool-methodology__updated">{t('method.updated')}</p>

            <div class="tool-methodology__author">
              <span class="tool-methodology__author-name">Reid Peryam</span>
              <span class="tool-methodology__author-sep">&middot;</span>
              <span>{t('method.authorRole')}</span>
              <span class="tool-methodology__author-sep">&middot;</span>
              <span>{t('method.authorCredential')}</span>
              <span class="tool-methodology__author-sep">&middot;</span>
              <a
                href="https://www.linkedin.com/in/reidperyam/"
                target="_blank"
                rel="noopener noreferrer"
                class="tool-methodology__author-link"
              >
                LinkedIn
              </a>
            </div>
          </div>
        </details>
      </div>

      <a
        href={localizedHref('/hub/tools/', locale)}
        class="brutal-btn brutal-btn--secondary icg-back-link"
      >
        {t('nav.back')}
      </a>
    </div>
  </section>
  {/* English needs no island: strings.ts falls back to the English catalog. */}
  {!isDefaultLocale(locale) && (
    <script
      is:inline
      type="application/json"
      data-icg-strings
      set:html={JSON.stringify(SCRIPT_STRINGS).replace(/</g, '\\u003c')}
    />
  )}
</BaseLayout>

<style>
  /* ── Page wrapper ─────────────────────────────────────────────────────── */
  .icg-section {
    padding-bottom: var(--spacing-3xl);
  }

  /* ── Tool shell — base styles provided by global .tool-shell + .tool-shell--narrow ── */

  /* .icg-shell retained for ICG-specific overrides only */

  /* ── View toggling ────────────────────────────────────────────────────── */
  .is-hidden {
    display: none;
  }

  /* ── Landing view ─────────────────────────────────────────────────────── */
  .landing-content {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .wizard-content {
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .results-content {
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .comparison-content {
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  /* .landing-callout — layout overrides only; visual treatment from .brutal-callout */
  .landing-callout {
    margin-bottom: var(--spacing-xl);
  }

  .landing-content > .tool-action-bar {
    margin-top: var(--spacing-md);
    gap: var(--spacing-md);
  }

  /* ── Resume prompt — layout overrides only; visual treatment from .brutal-callout ── */
  .icg-resume-prompt {
    margin-bottom: var(--spacing-lg);
  }

  .icg-resume-prompt__text {
    margin-bottom: var(--spacing-md);
  }

  .icg-resume-actions {
    display: flex;
    gap: var(--spacing-sm);
  }

  .icg-resume-actions .brutal-btn {
    flex: 1;
  }

  .stats-row {
    display: flex;
    gap: var(--gap-normal);
    margin-bottom: var(--spacing-xl);
  }

  /* stat-tile — visual treatment from global .brutal-stat-tile; no scoped overrides needed */

  /* ── Domain header ────────────────────────────────────────────────────── */
  .icg-domain-header {
    margin-bottom: var(--spacing-xl);
  }

  .icg-domain-header__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .icg-domain-label {
    color: var(--color-primary);
  }

  .icg-foundational-badge {
    font-size: var(--text-3xs);
    font-weight: var(--font-weight-bold);
    font-family: var(--font-family-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1px var(--spacing-sm);
    border: 1px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
  }

  .icg-domain-name {
    margin-bottom: var(--spacing-xs);
  }

  .icg-domain-desc {
    color: var(--text-secondary);
  }

  .icg-foundational-note {
    color: var(--text-muted);
    font-style: italic;
    margin-top: var(--spacing-sm);
  }

  /* ── Question cards (injected via innerHTML — must use :global) ────── */
  .icg-questions {
    display: flex;
    flex-direction: column;
    gap: var(--gap-normal);
  }

  :global(.icg-question-card) {
    padding: var(--spacing-md) var(--spacing-lg);
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    background: transparent;
  }

  :global(.icg-question-text) {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-normal);
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    line-height: 1.6;
  }

  :global(.icg-question-num) {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-bold);
    margin-right: var(--spacing-xs);
  }

  :global(.icg-options-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xs);
  }

  /* ── Question rationale ────────────────────────────────────────────────── */
  :global(.icg-rationale) {
    margin-top: var(--spacing-sm);
  }

  :global(.icg-rationale__trigger) {
    font-size: var(--text-xs);
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
    transition: color var(--transition-fast);
  }

  :global(.icg-rationale__trigger::-webkit-details-marker) {
    display: none;
  }

  :global(.icg-rationale__trigger::before) {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: var(--spacing-xs);
    background-color: var(--color-primary);
    mask-image: url('/images/logo/gst-delta-icon-teal-stroke-thick.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    transition: transform var(--transition-fast);
  }

  :global(.icg-rationale[open] > .icg-rationale__trigger::before) {
    transform: rotate(180deg);
  }

  :global(.icg-rationale__trigger:hover) {
    color: var(--text-secondary);
  }

  :global(.icg-rationale__text) {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: var(--spacing-xs);
    padding-left: var(--spacing-sm);
    border-left: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  :global(.brutal-choice-btn--unsure) {
    grid-column: 1 / -1;
  }

  /* ── Wizard navigation ────────────────────────────────────────────────── */
  .icg-wizard-nav {
    display: flex;
    gap: var(--gap-normal);
    margin-top: var(--spacing-xl);
    padding: var(--spacing-md) 0;
    border-top: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  .icg-wizard-nav .brutal-btn--primary {
    flex: 1;
  }

  /* ── Results: Score display ────────────────────────────────────────────── */
  .icg-score-display {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .icg-gauge {
    margin-bottom: var(--spacing-xs);
  }

  .icg-score-level {
    margin-top: var(--spacing-xs);
