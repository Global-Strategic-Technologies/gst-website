---
/**
 * / in every locale. Rendered by src/pages/index.astro (English) and by
 * src/pages/[locale]/[...route].astro. Section copy lives in the `home`
 * namespace; the three section components take `locale` and read it too.
 *
 * The announcement sash renders on the ENGLISH home only: announcement copy
 * (src/data/announcements.ts) is not catalog-driven, so an English sash on
 * /es/ would be a Tier C surface leaking into a Tier A page. Localizing the
 * sash is a follow-up if an announcement ever targets a non-English audience.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhoWeSupport from '../components/WhoWeSupport.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import WhyClientsTrustUs from '../components/WhyClientsTrustUs.astro';
import CTASection from '../components/CTASection.astro';
import Sash from '../components/Sash.astro';
import { getActiveAnnouncement } from '../data/announcements';
import { isDefaultLocale, type Locale } from '../i18n/locales';
import { localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale, 'home');

// Null unless an announcement's window is open and lists this route — see
// src/data/announcements.ts. Nothing renders when it is null, and the nav's
// corner reservation switches itself off via :has().
const announcement = isDefaultLocale(locale) ? getActiveAnnouncement(Astro.url.pathname) : null;
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  ogTitle={t('meta.ogTitle')}
  ogDescription={t('meta.ogDescription')}
  ogImage="https://globalstrategic.tech/og-image.png"
  ogImageAlt={t('meta.ogImageAlt')}
  ogUrl={`https://globalstrategic.tech${localizedHref('/', locale)}`}
>
  {announcement && <Sash slot="sash" {...announcement} />}

  <Hero
    description={t('hero.description')}
    primaryCTA={{
      text: t('hero.primaryCta'),
      href: 'https://calendarbridge.com/book/globalstrategictech/',
    }}
    secondaryCTA={{
      text: t('hero.secondaryCta'),
      href: localizedHref('/services/', locale),
    }}
    trustLine={t('hero.trustLine')}
    locale={locale}
  />

  <WhoWeSupport locale={locale} />

  <WhatWeDo locale={locale} />

  <WhyClientsTrustUs locale={locale} />

  <CTASection
    title={t('cta.title')}
    description={t('cta.description')}
    buttonText={t('cta.button')}
    bookingUrl="https://calendarbridge.com/book/globalstrategictech/"
    emailAddress="contact@globalstrategic.tech"
    locale={locale}
  />
</BaseLayout>
