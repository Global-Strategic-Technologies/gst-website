                  <tr data-bench-row="pe" data-bench="25-40">
                    <td>{t('stage.pe.label')}</td>
                    <td>25&ndash;40%</td>
                  </tr>
                  <tr data-bench-row="enterprise" data-bench="18-32">
                    <td>{t('stage.enterprise.label')}</td>
                    <td>18&ndash;32%</td>
                  </tr>
                </tbody>
              </table>
              <div class="tool-bench-note brutal-text-tiny">{t('bench.sources')}</div>
              <div class="tool-bench-note brutal-text-tiny" data-industry-disc>
