---
/**
 * /hub/tools/techpar/ in every locale. Rendered by
 * src/pages/hub/tools/techpar/index.astro (English) and by
 * src/pages/[locale]/[...route].astro. A Tier B route (`TIER_B_ROUTES`).
 *
 * Every user-visible string in the markup comes from the `techpar` catalog;
 * the strings the client script paints at runtime travel in the
 * `data-techpar-strings` island at the bottom. Hooks (`id`, `class`,
 * `data-*`, ARIA wiring) are untouched: the scripts and the E2E suite read them.
 *
 * Literals that stay in this file are not language: benchmark ranges, preset
 * chip values (repainted by the script in the display currency), the `$`
 * prefix, currency codes, and the tool name. `knowsAbout` in the JSON-LD stays
 * an English literal — `tests/unit/hub-tool-schema.test.ts` parses it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/hub/HubHeader.astro';
import DeltaIcon from '../components/DeltaIcon.astro';
import PresetInput from '../components/techpar/PresetInput.astro';
import { hubToolSchema } from '../utils/hub-tool-schema';
import { isDefaultLocale, type Locale } from '../i18n/locales';
import { localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';
import { SCRIPT_STRING_KEYS } from '../scripts/techpar/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, tHtml } = useTranslations(locale, 'techpar');

// The strings the client script paints at runtime, in this page's locale
// (LOCALIZATION.md § Tool scripts). `t` is typed by key; the island list is
// computed, so it is looked up through the untyped catalog view.
const tAny = t as (key: string) => string;
const SCRIPT_STRINGS = Object.fromEntries(SCRIPT_STRING_KEYS.map((key) => [key, tAny(key)]));
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  ogTitle={t('meta.ogTitle')}
  ogDescription={t('meta.ogDescription')}
  ogImage="/og-image.png"
  ogImageAlt={t('meta.ogImageAlt')}
  ogUrl={`https://globalstrategic.tech${localizedHref('/hub/tools/techpar/', locale)}`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      hubToolSchema({
        name: 'TechPar',
        description: t('jsonld.description'),
        datePublished: '2026-02-01',
        dateModified: '2026-10-24',
        inLanguage: locale.htmlLang,
        featureList: [
          t('jsonld.feature1'),
          t('jsonld.feature2'),
          t('jsonld.feature3'),
          t('jsonld.feature4'),
        ],
        knowsAbout: [
          'Technology Cost Benchmarking',
          'SaaS Metrics',
          'Technical Due Diligence',
          'M&A Tech Strategy',
          'Infrastructure Cost Analysis',
        ],
      })
    )}
  />
  <section class="techpar-section">
    <div class="container">
      <HubHeader title="TechPar" subtitle={t('header.subtitle')} locale={locale} />

      <div
        data-techpar
        class="brutal-tool-shell--fluid"
        data-print-title={t('print.title')}
        data-print-footer={t('print.footer', {
          url: `globalstrategic.tech${localizedHref('/hub/tools/techpar/', locale)}`,
        })}
      >
        <!-- Tab bar -->
        <div class="tool-tab-bar" data-tab-bar role="tablist" aria-label={t('tabs.ariaLabel')}>
          <button
            class="tool-tab tool-tab--active"
            data-tab="profile"
            type="button"
            id="tab-profile"
            role="tab"
            aria-selected="true"
            aria-controls="panel-profile"
          >
            <svg
              class="tool-tab__icon"
              width="16"
              height="16"
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              stroke-width="6"
              stroke-linejoin="miter"
              aria-hidden="true"
            >
              <rect x="12" y="12" width="40" height="40"></rect>
            </svg>
            <span class="tool-tab__label">{t('tabs.profile')}</span>
          </button>
          <button
            class="tool-tab"
            data-tab="costs"
            type="button"
            id="tab-costs"
            role="tab"
            aria-selected="false"
            aria-controls="panel-costs"
          >
            <svg
              class="tool-tab__icon"
              width="16"
              height="16"
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              stroke-width="6"
              stroke-linejoin="miter"
              aria-hidden="true"
            >
              <circle cx="32" cy="32" r="20"></circle>
            </svg>
            <span class="tool-tab__label">{t('tabs.costs')}</span>
          </button>
          <button
            class="tool-tab"
            data-tab="analysis"
            type="button"
            id="tab-analysis"
            role="tab"
            aria-selected="false"
            aria-controls="panel-analysis"
          >
            <svg
              class="tool-tab__icon"
              width="16"
              height="16"
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              stroke-width="6"
              stroke-linejoin="miter"
              aria-hidden="true"
            >
              <path d="M12 52 L32 12 L52 52" fill="none"></path>
            </svg>
            <span class="tool-tab__label">{t('tabs.analysis')}</span>
          </button>
          <button
            class="tool-tab"
            data-tab="trajectory"
            type="button"
            id="tab-trajectory"
            role="tab"
            aria-selected="false"
            aria-controls="panel-trajectory"
          >
            <svg
              class="tool-tab__icon"
              width="16"
              height="16"
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              stroke-width="6"
              stroke-linejoin="miter"
              aria-hidden="true"
            >
              <path d="M32 12 L52 52 L12 52 Z"></path>
            </svg>
            <span class="tool-tab__label">{t('tabs.trajectory')}</span>
          </button>
        </div>
        <div class="tp-toolbar">
          <button class="tp-toolbar__reset" data-action="reset" type="button">
            {t('toolbar.reset')}
          </button>
        </div>

        <!-- ── TAB: PROFILE ──────────────────────────────────── -->
        <div
          class="tp-panel tp-panel--active"
          data-panel="profile"
          id="panel-profile"
          role="tabpanel"
          aria-labelledby="tab-profile"
        >
          <details class="tp-onboarding" data-onboarding open>
            <summary class="tp-onboarding__trigger brutal-label-small">
              {t('onboarding.summary')}
            </summary>
            <div class="tp-onboarding__body brutal-text-tiny">
              <p set:html={tHtml('onboarding.p1')} />
              <p set:html={tHtml('onboarding.p2')} />
              <p set:html={tHtml('onboarding.p3')} />
              <p set:html={tHtml('onboarding.p4')} />
            </div>
          </details>

          <div class="tp-panel__header">
            <span class="tp-step brutal-label-small">{t('tabs.step', { n: 1, total: 4 })}</span>
            <h2 class="tp-panel__title brutal-heading-md">{t('profile.title')}</h2>
            <p class="tp-panel__sub brutal-text-small">{t('profile.sub')}</p>
          </div>

          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label">
              {t('profile.stageLabel')}
              <span class="brutal-field__req">{t('profile.required')}</span>
            </span>
            <div
              class="tp-stage-grid"
              data-stage-grid
              role="radiogroup"
              aria-label={t('profile.stageLabel')}
            >
              <button
                class="brutal-option-card brutal-option-card--compact"
                data-stage="seed"
                type="button"
                role="radio"
                aria-checked="false"
              >
                <span class="brutal-option-card__label">{t('stage.seed.label')}</span>
                <span class="brutal-option-card__description">60&ndash;100%</span>
              </button>
              <button
                class="brutal-option-card brutal-option-card--compact"
                data-stage="series_a"
                type="button"
                role="radio"
                aria-checked="false"
              >
                <span class="brutal-option-card__label">{t('stage.series_a.label')}</span>
                <span class="brutal-option-card__description">45&ndash;75%</span>
              </button>
              <button
                class="brutal-option-card brutal-option-card--compact"
                data-stage="series_bc"
                type="button"
                role="radio"
                aria-checked="false"
              >
                <span class="brutal-option-card__label">{t('stage.series_bc.label')}</span>
                <span class="brutal-option-card__description">35&ndash;55%</span>
              </button>
              <button
                class="brutal-option-card brutal-option-card--compact"
                data-stage="pe"
                type="button"
                role="radio"
                aria-checked="false"
              >
                <span class="brutal-option-card__label">{t('stage.pe.label')}</span>
                <span class="brutal-option-card__description">25&ndash;40%</span>
              </button>
              <button
                class="brutal-option-card brutal-option-card--compact"
                data-stage="enterprise"
                type="button"
                role="radio"
                aria-checked="false"
              >
                <span class="brutal-option-card__label">{t('stage.enterprise.label')}</span>
                <span class="brutal-option-card__description">18&ndash;32%</span>
              </button>
            </div>
            <div class="brutal-field__hint brutal-text-tiny">{t('profile.stageHint')}</div>
          </div>

          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label">{t('industry.label')}</span>
            <div
              class="tp-seg tp-seg--wide"
              data-seg="industry"
              role="radiogroup"
              aria-label={t('industry.label')}
            >
              <button
                class="tp-seg__btn tp-seg__btn--active"
                data-industry="saas"
                type="button"
                role="radio"
                aria-checked="true"
              >
                {t('industry.saas.name')}
              </button>
              <button
                class="tp-seg__btn"
                data-industry="fintech"
                type="button"
                role="radio"
                aria-checked="false"
              >
                {t('industry.fintech.name')}
              </button>
              <button
                class="tp-seg__btn"
                data-industry="marketplace"
                type="button"
                role="radio"
                aria-checked="false"
              >
                {t('industry.marketplace.name')}
              </button>
              <button
                class="tp-seg__btn"
                data-industry="infra_hw"
                type="button"
                role="radio"
                aria-checked="false"
              >
                {t('industry.infra_hw.name')}
              </button>
              <button
                class="tp-seg__btn"
                data-industry="other"
                type="button"
                role="radio"
                aria-checked="false"
              >
                {t('industry.other.name')}
              </button>
            </div>
            <div class="brutal-field__hint brutal-text-tiny">{t('industry.hint')}</div>
          </div>

          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label">{t('currency.label')}</span>
            <div
              class="tp-seg tp-seg--wide"
              data-seg="currency"
              role="radiogroup"
              aria-label={t('currency.label')}
            >
              <button
                class="tp-seg__btn tp-seg__btn--active"
                data-currency="USD"
                type="button"
                role="radio"
                aria-checked="true"
              >
                USD
              </button>
              <button
                class="tp-seg__btn"
                data-currency="EUR"
                type="button"
                role="radio"
                aria-checked="false"
              >
                EUR
              </button>
              <button
                class="tp-seg__btn"
                data-currency="GBP"
                type="button"
                role="radio"
                aria-checked="false"
              >
                GBP
              </button>
              <button
                class="tp-seg__btn"
                data-currency="BRL"
                type="button"
                role="radio"
                aria-checked="false"
              >
                BRL
              </button>
              <button
                class="tp-seg__btn"
                data-currency="CAD"
                type="button"
                role="radio"
                aria-checked="false"
              >
                CAD
              </button>
              <button
                class="tp-seg__btn"
                data-currency="AUD"
                type="button"
                role="radio"
                aria-checked="false"
              >
                AUD
              </button>
            </div>
            <div class="brutal-field__hint brutal-text-tiny">{t('currency.hint')}</div>
          </div>

          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label">
              {t('arr.sectionLabel')}
            </span>
            <div class="brutal-field">
              <label class="brutal-field__label brutal-text-small" for="tp-arr">
                {t('arr.label')} <span class="brutal-field__req">{t('profile.required')}</span>
              </label>
              <div class="tp-arr-quick" data-arr-quick>
                <button
                  class="tp-arr-chip"
                  aria-pressed="false"
                  data-money
                  data-arr-val="10000000"
                  type="button"
                >
                  $10M
                </button>
                <button
                  class="tp-arr-chip"
                  aria-pressed="false"
                  data-money
                  data-arr-val="25000000"
                  type="button"
                >
                  $25M
                </button>
                <button
                  class="tp-arr-chip"
                  aria-pressed="false"
                  data-money
                  data-arr-val="50000000"
                  type="button"
                >
                  $50M
                </button>
                <button
                  class="tp-arr-chip"
                  aria-pressed="false"
                  data-money
                  data-arr-val="100000000"
                  type="button"
                >
                  $100M
                </button>
                <button
                  class="tp-arr-chip"
                  aria-pressed="false"
                  data-money
                  data-arr-val="250000000"
                  type="button"
                >
                  $250M
                </button>
              </div>
              <div class="brutal-field__input-wrap">
                <span class="brutal-field__prefix">$</span>
                <input
                  type="text"
                  id="tp-arr"
                  data-input="arr"
                  data-arr-display
                  inputmode="numeric"
                  placeholder={t('arr.placeholder')}
                  autocomplete="off"
                />
              </div>
              <div class="brutal-field__hint brutal-text-tiny">{t('arr.hint')}</div>
            </div>
          </div>

          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label">{t('growth.label')}</span>
            <div class="tp-seg-row">
              <div
                class="tp-seg"
                data-seg="growth"
                role="radiogroup"
                aria-label={t('growth.ariaLabel')}
              >
                <button
                  class="tp-seg__btn"
                  data-growth="10"
                  type="button"
                  role="radio"
                  aria-checked="false"
                >
                  10%
                </button>
                <button
                  class="tp-seg__btn"
                  data-growth="20"
                  type="button"
                  role="radio"
                  aria-checked="false"
                >
                  20%
                </button>
                <button
                  class="tp-seg__btn"
                  data-growth="30"
                  type="button"
                  role="radio"
                  aria-checked="false"
                >
                  30%
                </button>
                <button
                  class="tp-seg__btn"
                  data-growth="50"
                  type="button"
                  role="radio"
                  aria-checked="false"
                >
                  50%
                </button>
              </div>
            </div>
            <div class="brutal-field__input-wrap">
              <input
                type="number"
                id="tp-growth-custom"
                data-input="growthCustom"
                min="1"
                max="500"
                placeholder={t('growth.customPlaceholder')}
                aria-label={t('growth.customAriaLabel')}
                class="brutal-field__input--no-prefix brutal-field__input--has-suffix"
              />
              <span class="brutal-field__suffix">%</span>
            </div>
            <div class="brutal-field__hint brutal-text-tiny">{t('growth.hint')}</div>
            <div
              class="brutal-field__hint brutal-field__hint--warn brutal-text-tiny"
              data-growth-warn
              style="display:none"
            >
              {t('growth.warn')}
            </div>
          </div>

          <div class="brutal-field tp-exit-field" data-exit-field>
            <label class="brutal-field__label brutal-text-small" for="tp-exit-mult">
              {t('exit.label')}
            </label>
            <PresetInput
              inputName="exitMult"
              inputId="tp-exit-mult"
              presets={[
                { value: 6, label: '6×' },
                { value: 10, label: '10×' },
                { value: 12, label: '12×' },
                { value: 15, label: '15×' },
                { value: 20, label: '20×' },
              ]}
              suffix="×"
              inputClasses="brutal-field__input--no-prefix brutal-field__input--has-suffix"
              min={1}
              max={30}
              initialValue={12}
            />
            <div class="brutal-field__hint brutal-text-tiny">{t('exit.hint')}</div>
          </div>

          <details class="tp-historical" data-historical>
            <summary class="tp-historical__trigger brutal-label-small">
              {t('historical.summary')}
            </summary>
            <div class="tp-historical__body">
              <p class="brutal-field__hint brutal-text-tiny">{t('historical.hint')}</p>
              <div data-hist-rows></div>
              <button class="tp-hist-add" data-hist-add type="button">
                {t('historical.add')}
              </button>
            </div>
          </details>

          <div class="tp-nav-row">
            <button
              class="brutal-btn brutal-btn--primary tp-btn-next"
              data-action="go-costs"
              type="button"
            >
              {t('actions.toCosts')}
            </button>
          </div>
        </div>

        <!-- ── TAB: COSTS ────────────────────────────────────── -->
        <div
          class="tp-panel"
          data-panel="costs"
          id="panel-costs"
          role="tabpanel"
          aria-labelledby="tab-costs"
        >
          <div class="tp-panel__header">
            <span class="tp-step brutal-label-small">{t('tabs.step', { n: 2, total: 4 })}</span>
            <h2 class="tp-panel__title brutal-heading-md">{t('costs.title')}</h2>
            <p class="tp-panel__sub brutal-text-small">{t('costs.sub')}</p>
          </div>

          <!-- Mode toggle -->
          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label">
              {t('costs.modeLabel')}
            </span>
            <div
              class="tp-seg"
              data-seg="mode"
              role="radiogroup"
              aria-label={t('costs.modeAriaLabel')}
            >
              <button
                class="tp-seg__btn tp-seg__btn--active"
                data-mode="quick"
                type="button"
                role="radio"
                aria-checked="true"
              >
                {t('costs.modeQuick')}
              </button>
              <button
                class="tp-seg__btn"
                data-mode="deepdive"
                type="button"
                role="radio"
                aria-checked="false"
              >
                {t('costs.modeDeep')}
              </button>
            </div>
            <div class="brutal-field__hint brutal-text-tiny">{t('costs.modeHint')}</div>
          </div>

          <!-- CapEx toggle -->
          <label class="tp-capex-row" data-capex-row>
            <input type="checkbox" data-input="gaapChk" />
            <span class="brutal-text-small">{t('costs.gaap')}</span>
          </label>

          <!-- Infrastructure hosting -->
          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label tp-sec-label--cat">
              <span class="tp-cat-dot tp-cat-dot--infra"></span>
              {t('costs.infra.title')}
            </span>
            <div class="brutal-field">
              <label class="brutal-field__label brutal-text-small" for="tp-infra">
                <span data-infra-label>{t('costs.infra.labelMonthly')}</span>
                <span class="brutal-field__req">{t('costs.required')}</span>
              </label>
              <div
                class="tp-seg tp-seg--sm"
                data-seg="infra-period"
                role="radiogroup"
                aria-label={t('costs.infra.periodAriaLabel')}
              >
                <button
                  class="tp-seg__btn tp-seg__btn--active"
                  data-infra-period="monthly"
                  type="button"
                  role="radio"
                  aria-checked="true"
                >
                  {t('costs.infra.monthly')}
                </button>
                <button
                  class="tp-seg__btn"
                  data-infra-period="annual"
                  type="button"
                  role="radio"
                  aria-checked="false"
                >
                  {t('costs.infra.annual')}
                </button>
              </div>
              {/* Annual chipsOnly companion renders BEFORE the monthly+input pair
                  so the visible chip group sits above the input in both modes.
                  syncInfraPeriodUI() toggles by data attribute, not DOM order. */}
              <PresetInput
                money
                inputName="infra"
                chipsOnly
                chipGroupAttr="data-infra-chips-annual"
                containerStyle="display:none"
                presets={[
                  { value: 50000, label: '$50K' },
                  { value: 200000, label: '$200K' },
                  { value: 500000, label: '$500K' },
                  { value: 2000000, label: '$2M' },
                  { value: 5000000, label: '$5M' },
                ]}
              />
              <PresetInput
                money
                inputName="infra"
                inputId="tp-infra"
                presets={[
                  { value: 5000, label: '$5K' },
                  { value: 15000, label: '$15K' },
                  { value: 50000, label: '$50K' },
                  { value: 150000, label: '$150K' },
                  { value: 500000, label: '$500K' },
                ]}
                prefix="$"
                suffix={t('costs.infra.suffixMonthly')}
                suffixAttr="data-infra-suf"
                chipGroupAttr="data-infra-chips-monthly"
                min={0}
                step={1000}
                placeholder="0"
              />
              <div class="brutal-field__hint brutal-text-tiny" data-infra-hint>
                {t('costs.infra.hint')}
              </div>
              <div
                class="tp-infra-annual brutal-text-tiny"
                data-infra-annual
                style="display:none"
              ></div>
              <div
                class="brutal-field__hint brutal-field__hint--warn brutal-text-tiny"
                data-infra-warn
                style="display:none"
              ></div>
            </div>
          </div>

          <!-- Infrastructure personnel -->
          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label tp-sec-label--cat">
              <span class="tp-cat-dot tp-cat-dot--pers"></span>
              {t('costs.pers.title')}
            </span>
            <div class="brutal-field">
              <label class="brutal-field__label brutal-text-small" for="tp-infra-pers">
                {t('costs.annualLoaded')}
              </label>
              <PresetInput
                money
                inputName="infraPers"
                inputId="tp-infra-pers"
                presets={[
                  { value: 250000, label: '$250K' },
                  { value: 500000, label: '$500K' },
                  { value: 1000000, label: '$1M' },
                  { value: 2000000, label: '$2M' },
                  { value: 5000000, label: '$5M' },
                ]}
                prefix="$"
                min={0}
                step={10000}
                placeholder="—"
              />
              <div class="brutal-field__hint brutal-text-tiny">{t('costs.pers.hint')}</div>
              <div
                class="brutal-field__hint brutal-field__hint--warn brutal-text-tiny"
                data-sanity-warn="infraPers"
                style="display:none"
              ></div>
            </div>
          </div>

          <!-- R&D OpEx -->
          <div class="tp-section">
            <span class="brutal-tool-shell__section-label tp-sec-label tp-sec-label--cat">
              <span class="tp-cat-dot tp-cat-dot--rd"></span>
