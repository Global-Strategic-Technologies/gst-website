---
/**
 * /hub/mcp/ in every locale. Rendered by src/pages/hub/mcp/index.astro
 * (English) and by src/pages/[locale]/[...route].astro.
 *
 * Published facts on this page are pinned by
 * `tests/integration/mcp-marketing-parity.test.ts`, which reads THIS file's
 * markup region against mcp-server source, inlining the English catalog into
 * every `{t('…')}` / `{num('…')}` expression first. Two rules keep that guard
 * meaningful across locales:
 *   - Wire identifiers (tool and prompt names, resource URI schemes, tier ids,
 *     hostnames, the `data-*` hooks) and the counts they are counted by stay
 *     LITERAL markup — the same in every language, and the guard compares them
 *     to the server registry by text.
 *   - Prose goes through `t()` / `tHtml()` with LITERAL params only (`{ count:
 *     16 }`, never a variable), so the guard can resolve them.
 * Tier ceilings are written as their English-formatted literals and passed
 * through `num()`, which reformats them for the page locale; the guard reads
 * the literal, so the numbers stay bound to `mcp-server/src/ratelimit/tiers`.
 *
 * Every link on this page but two leads to an English-only surface (tool pages,
 * the portfolio, the radar, the four guides), so those hrefs are literal; only
 * the lede's Tools link and the internal anchors go through localizedHref.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/hub/HubHeader.astro';
import DeltaIcon from '../components/DeltaIcon.astro';
import { mcpServerSchema } from '../utils/mcp-schema';
import type { Locale } from '../i18n/locales';
import { formatNumber } from '../i18n/formatters';
import { localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, tHtml } = useTranslations(locale, 'hub-mcp');

/** An English-formatted ceiling literal ("2,000"), re-formatted for the page locale. */
const num = (enFormatted: string) => formatNumber(Number(enFormatted.replace(/,/g, '')), locale);

const tierTableLabel = t('tiers.tableLabel', {
  pilot: t('tiers.pilot.name'),
  paid: t('tiers.paid.name'),
  enterprise: t('tiers.enterprise.name'),
});

const ACCESS_EMAIL = 'contact@globalstrategic.tech';
// Operator-inbox intake (PILOT_ONBOARDING.md § 0). English in every locale: the
// recipient is GST's operator, not the visitor.
const ACCESS_BODY = [
  'Name:',
  'Firm:',
  'Intended use case:',
  'Tools of interest:',
  'Expected monthly volume:',
  '',
].join('\n');

/** Prefilled operator-inbox intake — see PILOT_ONBOARDING.md § 0. */
function accessHref(tier?: string) {
  const subject = tier
    ? `GST MCP Server access request (${tier})`
    : 'GST MCP Server access request';
  return `mailto:${ACCESS_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(ACCESS_BODY)}`;
}
