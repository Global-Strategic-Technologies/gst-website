    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    /* Fixed label column so both URLs share a left edge; "Endpoint" and
       "Status" differ in width, so the rows would otherwise start at
       different x. */
    min-width: 5rem;
  }

  /* `.brutal-btn` brings its own sizing and the `--touch-target-min` floor.
     `min-width` is sized for the longer "Copied" label so the swap cannot widen
