     facts are reference material rather than the page's argument. */
  .mcp-facts li {
    font-family: inherit;
    font-size: var(--text-sm);
  }

  .mcp-facts code {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }

  /* The spec links, and the only inline-link family left on the page: the access
     facts stopped carrying one when the status URL moved into "For your
     engineers" as a copyable value. Plain `a` selectors precede every `a:hover`
     one, which is what stylelint's `no-descending-specificity` asks for. */
  .mcp-primitive__def a {
    color: light-dark(var(--color-tertiary-dark), var(--color-primary));
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom var(--transition-fast);
    /* Spec links read as identifiers and should not break across lines. */
    font-family: var(--font-family-mono);
    white-space: nowrap;
  }

  .mcp-primitive__def a:hover,
  .mcp-catalog__try:hover {
    border-bottom-color: currentColor;
