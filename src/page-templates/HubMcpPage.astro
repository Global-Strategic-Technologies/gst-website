              <td role="cell" data-tier={t('tiers.enterprise.name')}>{num('120')}</td>
            </tr>
            <tr role="row">
              <th scope="row" role="rowheader">{t('tiers.row.perDay')}</th>
              <td role="cell" data-tier={t('tiers.pilot.name')}>{num('300')}</td>
              <td role="cell" data-tier={t('tiers.paid.name')}>{num('2,000')}</td>
