  @media (prefers-reduced-motion: reduce) {
    .mcp-disclosure {
      transition: none;
    }
  }

  /* Inset so the card grid reads as nested under its primitive's heading and
     definition rather than as a peer block starting at the same left edge.
     Dropped at 768 where the grid is already one column and the width matters
     more than the hierarchy cue. */
  /* `minmax(0, 1fr)`, not `1fr`. A bare `1fr` is `minmax(auto, 1fr)`, and that
