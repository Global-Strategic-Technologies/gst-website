    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  /* Indented so the identifiers read as subordinate to the group's heading and
     gloss rather than as a third peer paragraph. Entries stay tightly set; the
     blank row goes AFTER the last one, via the footer padding below. */
  .mcp-catalog__group ul {
    padding-left: var(--spacing-lg);
  }

  .mcp-catalog__group li,
  .mcp-facts li {
