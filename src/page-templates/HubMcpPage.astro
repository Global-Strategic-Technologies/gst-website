<script>
  import { trackCTA } from '../utils/analytics';
  import { copyWithFeedback } from '../utils/copy-feedback';

  // Each button copies the `<code>` in its own row. Read from the DOM rather
  // than repeated here: those `<code>` values are what the parity guard pins, so
  // a copy in script would be a second thing to keep in sync. Row-scoped rather
  // than id-matched so adding another endpoint row needs no script change.
  // The "Copied" label is read from the button too, so it follows the page locale.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-endpoint]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.closest('.mcp-endpoint')?.querySelector('code')?.textContent?.trim() ?? '';
      void copyWithFeedback(value, btn, {
        label: btn.dataset.copiedLabel || 'Copied',
        copiedClass: 'brutal-btn--copied',
        // Swap only the visible word, leaving the `.sr-only` suffix in place.
        // That suffix is what distinguishes the two buttons ("Copy endpoint URL"
        // vs "Copy status page URL") without an `aria-label` — a label would
        // override the name and stop `aria-live` announcing the change to
        // "Copied", which is the confirmation a screen-reader user gets.
        feedbackTarget: btn.querySelector<HTMLElement>('[data-copy-label]') ?? btn,
      });
    });
  });
  // TODO(phase-3): replace with proper ambient `Window` type declaration.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  (window as any).trackCTA = trackCTA;
</script>

<style>
  .mcp-section {
    /* The page's prose measure. Named because several things must share it by
       definition rather than by five copies of the same literal agreeing: the
       lede, the notes, each primitive's heading rule and definition, the fact
       lists, and the collapsed width of the disclosure controls. */
    --mcp-measure: 800px;

    padding-bottom: var(--spacing-3xl);
  }

  /* No `scroll-margin-top` here, deliberately. Three of these blocks are
     deep-link targets (#what-it-does and #tiers from the announcement sash,
     #request-access from the guides), and the reflex is to offset them for the
     sticky header — but this is a hub SUB-page, and BaseLayout renders those
     with `staticHeader` (Header.astro's .site-header--static), so the header
     scrolls away and there is nothing to clear. Measured 2026-08-29: both
     fragments land at viewport top with the header already 280px above it.
     `.guide-section` (mcp-guide.css) does carry an 80px offset — but those
     routes are hub sub-pages too and get the same static header, so whatever
     that offset is for, it is not the site header and it is not a precedent
     for adding one here. */
  .mcp-block {
    margin-bottom: var(--spacing-3xl);
  }

  .mcp-block h2 {
    margin-bottom: var(--spacing-lg);
  }

  .mcp-lede {
    max-width: var(--mcp-measure);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-2xl);
  }

  /* Three counts, on the section that explains what they are counts OF, capped
     to the prose measure so they read as a summary of the paragraph above
     rather than as a headline of their own. */
  .mcp-primitive-summary {
    display: grid;

    /* auto-fit against the longest label's intrinsic width, not a fixed three:
       RESOURCES is 9 tracked uppercase characters — 76px of ink plus the tile's
       24px of padding, so 6.5rem is the smallest a tile can be and still hold
       it. Three fixed columns put that label 19px outside its tile at 375px
       (true before the pin too, just 6px less of it); with a real floor the row
       drops to two tiles instead. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 6.5rem), 1fr));
    gap: var(--spacing-md);
    max-width: var(--mcp-measure);
    margin-bottom: var(--spacing-2xl);
  }

  .mcp-note {
    max-width: var(--mcp-measure);
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-lg);
  }

  /* Closes the page for the engineer who has to configure the thing, below the
     argument rather than above it: nothing here is usable until a client record
     exists, so an endpoint above the fold promised self-serve. */
  .mcp-block--engineers {
    padding-top: var(--spacing-2xl);
    border-top: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  /* `.brutal-heading-md` rather than the `-lg` every section above uses, so the
     block reads as a footnote for the engineer wiring it up; a smaller heading
     takes a tighter gap to its one line of prose. */
  .mcp-block--engineers h2 {
    margin-bottom: var(--spacing-sm);
  }

  .mcp-engineers__lede {
    max-width: var(--mcp-measure);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-xl);
  }

  /* A shared three-column grid rather than two independent flex rows: the rows
     must align on all three columns, and with flex the copy buttons landed at
     different x because the two URLs differ in length. `display: contents` on
     each row promotes its label/URL/button into this grid so one column
     definition governs both. */
  .mcp-endpoints {
    display: grid;
    grid-template-columns: max-content max-content max-content;
    align-items: center;
    gap: var(--spacing-sm) var(--spacing-md);
  }

  .mcp-endpoint {
    display: contents;
  }

  .mcp-endpoint a {
    text-decoration: none;
