        {
          /* The tier headers and the ceilings table are one comparison object
          split across two elements, so they must share a column split exactly:
          four equal tracks here (no column gap) against `table-layout: fixed`
          below, both resolving to 25%, with the same horizontal padding on the
          cells. That is what puts each tier above its own numbers, and
          `hub-mcp-page.test.ts` measures it rather than trusting it. */
        }
        <div class="mcp-tiers">
          <div class="mcp-tier">
            <div class="mcp-tier__head">
              <h3 class="mcp-tier__name">{t('tiers.pilot.name')}</h3>
