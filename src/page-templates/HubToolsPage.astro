---
/**
 * /hub/tools/ in every locale. Rendered by src/pages/hub/tools/index.astro
 * (English) and by src/pages/[locale]/[...route].astro.
 *
 * Every tool page is Tier B (English only), so the cards keep their English
 * hrefs and a non-English page carries one `common.notice.contentInEnglish`
 * line under the header rather than seven identical footnotes. The ItemList
 * JSON-LD keeps the English tool names for the same reason — the items ARE
 * English pages; only the list's own name/description follow the locale.
 * `tests/unit/hub-tool-schema.test.ts` reads this file for the ItemList.
 *
 * The dev-only "Planned" cards stay literal: they never ship and exist to
 * sketch the roadmap in a local build, so a catalog entry would be noise.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/hub/HubHeader.astro';
import DeltaIcon from '../components/DeltaIcon.astro';
import { isDefaultLocale, type Locale } from '../i18n/locales';
import { localizedHref } from '../i18n/routes';
import { useTranslations } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale, 'hub-tools');
const common = useTranslations(locale, 'common');
const isDev = import.meta.env.DEV;

const TOOL_IDS = [
  'regulatory-map',
  'diligence-machine',
  'tech-debt-calculator',
  'infrastructure-cost-governance',
  'techpar',
  'information-request-list-generator',
  'information-request-list-extractor',
] as const;

// English names for the ItemList: the tool pages are English, so their listed
// names are too, in every locale.
const EN_TOOL_NAMES: Record<(typeof TOOL_IDS)[number], string> = {
  'regulatory-map': 'Regulatory Map',
  'diligence-machine': 'The Diligence Machine',
  'tech-debt-calculator': 'Technical Debt Cost Calculator',
  'infrastructure-cost-governance': 'Infrastructure Cost Governance',
  techpar: 'TechPar',
  'information-request-list-generator': 'Information Request List Generator',
  'information-request-list-extractor': 'Information Request List Extractor',
};

const tools = TOOL_IDS.map((id) => ({
  id,
  href: `/hub/tools/${id}/`,
  title: t(`tools.${id}.title`),
  features: ([1, 2, 3] as const).map((n) => t(`tools.${id}.f${n}`)),
}));
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  ogTitle={t('meta.ogTitle')}
  ogDescription={t('meta.ogDescription')}
  ogImage="/og-image.png"
  ogImageAlt={t('meta.ogImageAlt')}
  ogUrl={`https://globalstrategic.tech${localizedHref('/hub/tools/', locale)}`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: t('itemList.name'),
      description: t('itemList.description'),
      numberOfItems: TOOL_IDS.length,
      itemListElement: TOOL_IDS.map((id, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: EN_TOOL_NAMES[id],
        url: `https://globalstrategic.tech/hub/tools/${id}/`,
      })),
    })}
  />

  <section class="tools-section">
    <div class="container">
      <HubHeader title={t('header.title')} subtitle={t('header.subtitle')} locale={locale} />

      {
        !isDefaultLocale(locale) && (
          <p class="tools-notice">{common.t('notice.contentInEnglish')}</p>
        )
      }

      <div class="brutal-gateway-grid">
        {
          tools.map((tool) => (
            <article class="brutal-gateway-card brutal-frosted">
              <div class="brutal-gateway-card__header">
                <h2>{tool.title}</h2>
              </div>
              <ul class="brutal-gateway-card__features">
                {tool.features.map((feature) => (
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    {feature}
                  </li>
                ))}
              </ul>
              <a href={tool.href} class="cta-button brutal-gateway-card__cta" hreflang="en">
                {t('launch')}
              </a>
            </article>
          ))
        }

        {
          isDev && (
            <>
              <article class="brutal-gateway-card">
                <div class="brutal-gateway-card__header">
                  <h2>Acquisition Integration Priority Matrix</h2>
                </div>
                <ul class="brutal-gateway-card__features">
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Map tech stacks of two merging companies via drag-and-drop
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Red-Yellow-Green compatibility report identifies friction points
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Reveals Day 2 integration challenges before deal close
                  </li>
                </ul>
                <span class="brutal-gateway-card__badge">Planned</span>
              </article>

              <article class="brutal-gateway-card">
                <div class="brutal-gateway-card__header">
                  <h2>The AI Readiness Assessment</h2>
                </div>
                <ul class="brutal-gateway-card__features">
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Evaluates documentation, test coverage, and architectural modularity
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    "Vibe-Ready" score determines AI-agent refactoring feasibility
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Signals expertise in modern AI-augmented development workflows
                  </li>
                </ul>
                <span class="brutal-gateway-card__badge">Planned</span>
              </article>

              <article class="brutal-gateway-card">
                <div class="brutal-gateway-card__header">
                  <h2>Security & Compliance "Gap Finder"</h2>
                </div>
                <ul class="brutal-gateway-card__features">
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Industry-tailored checklist: SOC2, HIPAA, GDPR, PCI-DSS
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Radar chart visualizes security and compliance gaps
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    De-risks exits and funding rounds with compliance readiness
                  </li>
                </ul>
                <span class="brutal-gateway-card__badge">Planned</span>
              </article>

              <article class="brutal-gateway-card">
                <div class="brutal-gateway-card__header">
                  <h2>Technical Diligence Questionnaire</h2>
                </div>
                <ul class="brutal-gateway-card__features">
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Structured questionnaire covering architecture, security, operations, and team
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Tailored to target profile: stage, industry, and deal context
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Exportable questionnaire package for target company distribution
                  </li>
                </ul>
                <span class="brutal-gateway-card__badge">Planned</span>
              </article>

              <article class="brutal-gateway-card">
                <div class="brutal-gateway-card__header">
                  <h2>Diligence Discovery Agenda Creator</h2>
                </div>
                <ul class="brutal-gateway-card__features">
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Transforms Diligence Machine output into a structured meeting agenda
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Time-boxed sessions with assigned topics, owners, and key questions
                  </li>
                  <li>
                    <DeltaIcon class="bullet-icon" />
                    Exportable agenda for distribution to deal teams and target management
                  </li>
                </ul>
                <span class="brutal-gateway-card__badge">Planned</span>
              </article>
            </>
          )
        }
      </div>

      <a href={localizedHref('/hub/', locale)} class="cta-button">{t('return')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .tools-section {
    padding-bottom: var(--spacing-3xl);
  }

  /* Tier C/B notice (BL-153): every tool below is English-only. */
  .tools-notice {
    font-size: var(--text-sm);
    font-family: var(--font-family-mono);
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: var(--spacing-xl);
  }
</style>
