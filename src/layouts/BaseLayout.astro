---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import SEO from '../components/SEO.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import PalettePanel from '../components/brand/PalettePanel.astro';
import AmbientPage from '../components/AmbientPage.astro';
import LanguageBand from '../components/LanguageBand.astro';
import { localeFromPath, resolveLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/t';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showPalettePanel?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  /** Open Graph object type. Defaults to `website`; guides and articles pass `article`. */
  ogType?: string;
  // Enhanced social media meta tags
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  twitterSite?: string;
  faqItems?: Array<{ question: string; answer: string }>;
  /** Emit `noindex, follow` instead of `index, follow`. See SEO.astro. */
  noindex?: boolean;
}

const isProduction = import.meta.env.PROD;
const {
  title,
  description = 'Global Strategic Technologies - Technology Advisory & Execution',
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  ogType,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  twitterSite,
  faqItems,
  showPalettePanel,
  noindex,
} = Astro.props;

// Page locale (BL-153). `Astro.currentLocale` is the locale CODE (`pt-BR`) on a
// page under a locale prefix and `undefined` on a root page; the resolver maps
// both onto the registry (`undefined` → English). Everything that varies by
// language — `<html lang>`, chrome copy, hreflang, the breadcrumb names — flows
// from this one object.
const locale = resolveLocale(Astro.currentLocale);
const { t } = useTranslations(locale, 'common');

const currentPath = Astro.url.pathname;
// Prefix-insensitive: `/pt/hub/tools/` is a hub sub-page too.
const { routePath } = localeFromPath(currentPath);
const isHubSubPage = routePath.startsWith('/hub/') && routePath !== '/hub/';
const isHomepage = routePath === '/' || routePath === '';
---

<!doctype html>
<html lang={locale.htmlLang} data-palette-always={showPalettePanel || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- SEO Component (JSON-LD, Open Graph, Meta Tags) -->
    <SEO
      title={title}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      ogUrl={ogUrl}
      ogType={ogType}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      twitterSite={twitterSite}
      faqItems={faqItems}
      noindex={noindex}
      locale={locale}
    />

    <!--
      BL-144: the pinned brand mono. Above the fold on every page — the header
      wordmark, the nav and every heading resolve to it — so this is a genuine
      preload, not a speculative one. Exactly one: the two fallback faces behind
      it are `local()` and have nothing to fetch. `crossorigin` is required even
      same-origin, because font fetches are always CORS-mode; without it the
      preload is discarded and the font is fetched a second time.
    -->
    <link
      rel="preload"
      href="/fonts/gst-mono-var-latin-v1.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Favicons and Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme Colors -->
    <meta name="theme-color" content="#05cd99" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#05cd99" media="(prefers-color-scheme: dark)" />

    <!-- Preconnect to third-party origins to reduce critical path latency -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://calendarbridge.com" />

    <!-- Initialize theme synchronously to prevent FOUC and race conditions in E2E tests -->
    <script is:inline>
      try {
        // Mirrors src/scripts/theme-state.ts (ADR-0038) — this inline script
        // cannot import it; tests/unit/theme-state.test.ts pins the literals.
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'dim-dark') {
          document.documentElement.classList.add('dark-theme');
        }
        if (theme === 'dim-light' || theme === 'dim-dark') {
          document.documentElement.classList.add('theme-dim');
        }
      } catch {
        // localStorage not available (e.g., private browsing)
        // Default to light theme silently
      }
      // Initialize palette synchronously to prevent color flash
      try {
        const p = localStorage.getItem('palette');
        if (p && p !== '0') document.documentElement.classList.add('palette-' + p);
        if (localStorage.getItem('palette-popped-out') === 'true')
          document.documentElement.classList.add('palette-popped-out');
      } catch {
        // localStorage not available — palette init silently skipped
      }
      // Re-apply palette-editor colour edits (palette-manager.ts § Persisted
      // colour edits) before first paint, so they survive navigation. Only
      // custom properties are applied; they are cleared on a palette change.
      try {
        const edits = JSON.parse(localStorage.getItem('palette-overrides') || '{}');
        for (const name in edits) {
          if (name.startsWith('--') && typeof edits[name] === 'string') {
            document.documentElement.style.setProperty(name, edits[name]);
          }
        }
      } catch {
        // Missing or malformed — no edits to restore
      }
      // Hero ambient motion (BL-035, ADR-0039) — mirrors applySettings() in
      // src/scripts/ambient-motion.ts, which this script cannot import;
      // tests/unit/ambient-motion.test.ts pins the key, ids, ranges and the
      // default list. Numbers are clamped here too: an invalid custom property
      // would make `opacity` fall back to 1, i.e. full strength.
      try {
        const ids = ['grid', 'glow', 'scan', 'rails', 'deltas', 'arrows'];
        const strengthDefaults = {
          grid: 45,
          glow: 35,
          scan: 40,
          rails: 50,
          deltas: 30,
          arrows: 45,
        };
        const defaultOn = [];
        const scopes = ['hero', 'page', 'site'];
        let saved = null;
        try {
          saved = JSON.parse(localStorage.getItem('ambient-motion') || 'null');
        } catch {
          saved = null;
        }
        if (!saved || typeof saved !== 'object' || Array.isArray(saved)) saved = {};
        const wanted = Array.isArray(saved.on) ? saved.on : defaultOn;
        const on = ids.filter((id) => wanted.includes(id));
        if (on.length) {
          const clamp = (v, min, max, step, fallback) =>
            typeof v === 'number' && isFinite(v)
              ? Math.min(max, Math.max(min, Math.round(v / step) * step))
              : fallback;
          const strength =
            saved.strength && typeof saved.strength === 'object' ? saved.strength : {};
          const root = document.documentElement;
          root.setAttribute('data-ambient', on.join(' '));
          if (on.length > 1) root.setAttribute('data-ambient-layered', '');
          root.setAttribute(
            'data-ambient-scope',
            scopes.includes(saved.scope) ? saved.scope : scopes[0]
          );
          for (const id of ids) {
            const pct = clamp(strength[id], 0, 100, 5, strengthDefaults[id]);
            root.style.setProperty('--ambient-' + id, String(pct / 100));
          }
          root.style.setProperty(
            '--ambient-pace',
            String(clamp(saved.pace, 50, 150, 10, 100) / 100)
          );
        }
      } catch {
        // Ambient motion is decoration — never let it block the page
      }
    </script>

    <GoogleAnalytics />
  </head>
  <body>
    <a href="#main-content" class="skip-nav">{t('skipNav')}</a>
    {
      /* Announcement sash (Sash.astro), placed by the PAGE, not by this layout —
         which pages carry one is the registry's decision (src/data/announcements.ts),
         and /hub/mcp/ must never carry it. The slot exists because the corner box
         is absolutely positioned against <body> and has to clear the sticky
         header: the default slot renders inside <main>, which starts below the
         header and opens its own stacking context at z-index 1, so a sash there
         could neither reach the corner nor rise above the header. */
    }
    <slot name="sash" />
    <Header currentPath={currentPath} staticHeader={isHubSubPage} locale={locale} />
    {
      /* First-visit language suggestion (BL-153): in flow directly under the
         header, in the suggested language, once. Renders nothing until two
         locales are live. The sash corner above the header stays free. */
    }
    <LanguageBand locale={locale} currentPath={currentPath} />
    <main id="main-content" role="main">
      {
        /* Page-wide / site-wide ambient motion (BL-035) — behind every section,
           shown only in those scopes. First child so it spans all of <main>. */
      }
      <AmbientPage home={isHomepage} />
      {
        !isHomepage && (
          <div class="container">
            <Breadcrumb locale={locale} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer locale={locale} />
    <PalettePanel />
    {isProduction && <SpeedInsights />}
  </body>
</html>
