---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ErrorLocaleHint from '../components/ErrorLocaleHint.astro';
// English chrome by design: Vercel serves ONE static 404 for every URL, so the
// page cannot know a locale (ADR-0030 § 11). ErrorLocaleHint adds a line per
// live locale instead; it renders nothing until a translation is live.
---

<BaseLayout
  title="404 | Page Not Found"
  description="The page you're looking for doesn't exist or has been moved."
  noindex
>
  <Hero
    title="404"
    subtitle="Page Not Found"
    description="The page you're looking for doesn't exist or has been moved. Navigate back to explore what GST has to offer."
    primaryCTA={{ text: 'Return Home', href: '/' }}
    secondaryCTA={{ text: 'View Services', href: '/services/' }}
  />
  <ErrorLocaleHint />
</BaseLayout>
