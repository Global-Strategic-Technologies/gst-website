---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BrandIdentity from '../components/brand/BrandIdentity.astro';
import BrandColors from '../components/brand/BrandColors.astro';
import BrandTypography from '../components/brand/BrandTypography.astro';
import BrandComponents from '../components/brand/BrandComponents.astro';
import BrandAccessibility from '../components/brand/BrandAccessibility.astro';
import BrandUILibrary from '../components/brand/BrandUILibrary.astro';

/* Page-specific component CSS. These four are deliberately code-split out of
 * global.css (see the note there) and imported only by the pages that use them,
 * so they do NOT load site-wide. The brand page renders specimens for all of
 * them, and without these imports those specimens render as unstyled markup —
 * which is worse than no specimen, since a reader concludes the class is broken.
 * This page is the design-system reference, so it needs the full set; the
 * page-weight argument for splitting does not apply to a documentation surface. */
import '../styles/components/filter.css';
import '../styles/components/map.css';
import '../styles/components/portfolio.css';
import '../styles/components/progress.css';
---

<BaseLayout
  title="Brand Style Reference | GST"
  description="GST visual identity reference — colors, typography, spacing, and component patterns rendered live from the design system."
  showPalettePanel
  noindex
>
  <div class="container">
    <h1 class="brutal-heading-lg brand-page__title">Brand Style Reference</h1>
  </div>

  <div class="brand-layout">
    <TableOfContents
      testId="brand-toc"
      collapsible={true}
      scrollSpy={true}
      separatorBefore={[6, 10]}
      items={[
        {
          href: '#identity',
          label: 'Brand Identity',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'identity' },
          dataAttrs: { section: 'identity' },
        },
        {
          href: '#colors',
          label: 'Color Palette',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'colors' },
          dataAttrs: { section: 'colors' },
        },
        {
          href: '#typography',
          label: 'Typography',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'typography' },
          dataAttrs: { section: 'typography' },
        },
        {
          href: '#spacing',
          label: 'Spacing Scale',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'spacing' },
          dataAttrs: { section: 'spacing' },
        },
        { href: '#shadows', label: 'Shadows' },
        { href: '#transitions', label: 'Transitions' },
        {
          href: '#components',
          label: 'Components',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'components' },
          dataAttrs: { section: 'components' },
        },
        {
          href: '#component-states',
          label: 'Component States',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'component-states' },
          dataAttrs: { section: 'component-states' },
        },
        {
          href: '#accessibility',
          label: 'Accessibility',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'accessibility' },
          dataAttrs: { section: 'accessibility' },
        },
        {
          href: '#responsive-demos',
          label: 'Responsive Behavior',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'responsive-demos' },
          dataAttrs: { section: 'responsive-demos' },
        },
        {
          href: '#ui-library',
          label: 'UI Component Library',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'ui-library' },
          dataAttrs: { section: 'ui-library' },
        },
        {
          href: '#toc-component',
          label: 'Table of Contents',
          isLayer: true,
          sublistSource: { mode: 'query', scopeId: 'toc-component' },
          dataAttrs: { section: 'toc-component' },
        },
      ]}
    />

    <div class="brand-content palette-scope" id="palette-scope">
      <BrandIdentity />
      <BrandColors />
      <BrandTypography />
      <BrandComponents />
      <BrandAccessibility />
      <BrandUILibrary />
    </div><!-- .brand-content .palette-scope -->
  </div><!-- .brand-layout -->
</BaseLayout>

<!-- REPLACED: ~3,980 lines of inline HTML moved to 6 components in src/components/brand/ -->
<!-- Sections: BrandIdentity, BrandColors, BrandTypography, BrandComponents, BrandAccessibility, BrandUILibrary -->

<style is:global>
  /* Brand Page Title */
  .brand-page__title {
    padding-top: var(--spacing-2xl);
    margin-bottom: 0;
  }

  /* Brand Page Layout */
  .brand-section {
    padding: var(--spacing-3xl) 0;
    border-bottom: 1px solid var(--border-light);
  }

  .brand-section:last-child {
    border-bottom: none;
  }

  .brand-section__title {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-primary);
  }

  .brand-section__note--mobile {
    display: none;
  }

  .brand-section__note {
    margin-bottom: var(--spacing-xl);
    color: var(--text-muted);
  }

  .brand-group-title {
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-lg);
  }

  .brand-group-title:first-of-type {
    margin-top: 0;
  }

  .brand-subgroup-title {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-sm);
  }

  /* Brand Identity */
  .brand-identity-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--spacing-2xl);
    align-items: start;
  }

  .brand-identity-logos {
    display: flex;
    gap: var(--spacing-xl);
    align-items: flex-end;
  }

  .brand-logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .brand-logo-item img,
  .brand-logo-item .brand-logo-composite {
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: var(--spacing-md);
    background: var(--bg-light-alt);
  }

  .brand-logo-item .brand-logo-delta,
  .brand-logo-item .brand-logo-composite {
    color: var(--color-primary);
  }

  .brand-identity-info h3 {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-xs);
  }

  .brand-identity-info h3:first-child {
    margin-top: 0;
  }

  .brand-identity-info p {
    margin-bottom: var(--spacing-sm);
  }

  /* Color Swatches */
  .brand-swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--gap-normal);
  }

  .brand-swatch__color {
    aspect-ratio: 1;
    border-radius: 6px;
    border: 1px solid var(--border-light);
    margin-bottom: var(--spacing-xs);
  }

  .brand-swatch__color--checker {
    background-image:
      linear-gradient(45deg, var(--checkerboard-line) 25%, transparent 25%),
      linear-gradient(-45deg, var(--checkerboard-line) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--checkerboard-line) 75%),
      linear-gradient(-45deg, transparent 75%, var(--checkerboard-line) 75%);
    background-size: 10px 10px;
    background-position:
      0 0,
      0 5px,
      5px -5px,
      -5px 0;
  }

  .brand-swatch__label {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
    word-break: break-all;
  }

  .brand-swatch__value {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    color: var(--text-muted);
    min-height: 1.2em;
  }

  .brand-swatch__usage {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    line-height: 1.3;
  }

  /* Typography Specimens */
  .brand-type-specimens {
    display: flex;
    flex-direction: column;
  }

  .brand-type-specimen {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-lg);
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--border-light);
  }

  .brand-type-specimen > span:first-child {
    flex: 1;
    min-width: 0;
  }

  .brand-type-meta,
  .brand-type-value {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .brand-code {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    color: var(--text-muted);
    background: var(--accent-subtle-bg);
    padding: 2px 6px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .brand-font-stack {
    font-family: var(--font-family-mono);
    color: var(--text-secondary);
  }

  /* Spacing Scale */
  .brand-spacing-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .brand-spacing-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .brand-spacing-name {
    width: 160px;
    flex-shrink: 0;
  }

  .brand-spacing-bar {
    height: 12px;
    background: var(--color-primary);
    border-radius: 2px;
    min-width: 4px;
  }

  .brand-spacing-value {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Shadows */
  .brand-shadow-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-wide);
  }

  /* Transitions */
  .brand-transition-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-wide);
  }

  .brand-transition-value {
    font-size: var(--text-xs);
    font-family: var(--font-family-mono);
    color: var(--text-muted);
  }

  /* Components */
  .brand-component-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-wide);
    align-items: flex-start;
    margin-bottom: var(--spacing-lg);
  }

  .brand-component-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    align-items: flex-start;
  }

  .brand-component-item--full {
    width: 100%;
  }

  /* ── Announcement sash specimens ──
     The sash positions itself against the nearest positioned ancestor and is
     clipped by its own corner box, so a specimen needs a relative frame. 190px
     is the handoff's frame height and is deliberately shorter than the 200px
     corner: the band is what the specimen documents, and it sits in the top
     ~120px. The card frame mirrors a .hub-card — position + overflow are what
     let the 104px band sit in a card corner. */
  .brand-sash-frame {
    position: relative;
    width: 320px;
    height: 190px;
    background: var(--bg-light-alt);
    border: 2px solid var(--border-hairline);
    overflow: hidden;
  }

  .brand-sash-frame--card {
    width: 240px;
    height: 150px;
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    border-top: 3px solid var(--color-primary);
  }

  /* ── Hover specimens ──
     Cards whose documented behaviour IS the hover transition (trust card,
     step card, service card, hub gateway card — the project card left this
     family in the BL-095 closeout, since the real .project-card hover now
     renders natively via cards.css). The rule below is the real mechanism —
     never simulate it with inline onmouseenter handlers, which freeze the
     value against theme and palette and teach the wrong pattern to anyone
     copying this page. */
  .brand-hover-card {
    padding: var(--spacing-xl);
    border: 2px solid var(--border-light);
    transition: border-color var(--transition-normal);
    cursor: default;
  }

  .brand-hover-card:hover {
    border-color: var(--color-primary);
  }

  /* Top-accent variant — the primary top border persists through hover */
  .brand-hover-card--top-accent {
    border-top: 3px solid var(--color-primary);
  }

  .brand-skeleton-demo {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding: var(--spacing-lg);
    background: var(--bg-light);
    border-radius: 6px;
    border: 1px solid var(--border-light);
    max-width: 400px;
  }

  /* Wizard progress demos use shared .tool-wizard-progress classes from progress.css */

  /* Card grid */
  .brand-card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-extra-wide);
    margin-bottom: var(--spacing-lg);
  }

  /* The gateway grid ships a `margin-bottom: var(--spacing-3xl)` for the hub index
     pages, where a "Return to Hub" link follows it. On /brand that 48px orphans the
     specimen's <code> caption — it lands closer to the NEXT subgroup heading than to
     the specimen it describes. Collapsed to the 4px every other specimen uses.
     A `.brand-component-item` wrapper is not an option: `align-items: flex-start`
     would make the grid's inline size indefinite and collapse auto-fill to one
     max-content track (see the comment on the specimen itself). */
  .brand-content .brutal-gateway-grid {
    margin-bottom: var(--spacing-xs);
  }

  .brand-card-grid--single {
    grid-template-columns: 1fr;
    max-width: 400px;
  }

  /* Details/Summary */
  .brand-details {
    border: 1px solid var(--border-light);
    border-radius: 6px;
  }

  .brand-details__summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-lg);
    cursor: pointer;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    list-style: none;
    transition: color var(--transition-fast);
  }

  .brand-details__summary::-webkit-details-marker {
    display: none;
  }

  .brand-details__summary:hover {
    color: var(--text-primary);
  }

  .brand-details__toggle::before {
    content: '+';
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
    display: inline-block;
    width: 1em;
    text-align: center;
  }

  .brand-details[open] .brand-details__toggle::before {
    content: '−';
  }

  .brand-details__body {
    padding: 0 var(--spacing-lg) var(--spacing-lg);
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: var(--text-sm);
    border-top: 1px solid var(--border-light);
    padding-top: var(--spacing-md);
  }

  .brand-details__body p {
    margin: 0;
  }

  /* Container demo */
  .brand-container-demo {
    border: 1px dashed var(--color-primary);
    border-radius: 4px;
    padding: 2px;
  }

  .brand-container-inner {
    background: var(--accent-subtle-bg);
    padding: var(--spacing-lg) var(--spacing-2xl);
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-family: var(--font-family-mono);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .brand-section__note--desktop {
      display: none;
    }

    .brand-section__note--mobile {
      display: block;
    }

    .brand-section {
      padding: var(--spacing-2xl) 0;
    }

    .brand-identity-grid {
      grid-template-columns: 1fr;
    }

    .brand-swatch-grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }

    .brand-type-specimen {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .brand-shadow-grid,
    .brand-transition-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .brand-spacing-name {
      width: 130px;
    }

    .brand-card-grid {
      grid-template-columns: 1fr;
    }

    .brand-type-specimen > span:first-child {
      overflow-wrap: break-word;
    }

    .brand-component-item {
      max-width: 100%;
      overflow-x: auto;
    }

    .a11y-contrast-table,
    .a11y-kb-table {
      overflow-x: auto;
    }
  }

  @media (max-width: 480px) {
    .brand-section {
      padding: var(--spacing-xl) 0;
    }

    .brand-swatch-grid {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    }

    .brand-swatch__usage {
      display: none;
    }

    .brand-shadow-grid,
    .brand-transition-grid {
      grid-template-columns: 1fr;
    }

    .brand-spacing-row {
      flex-wrap: wrap;
    }

    .brand-spacing-name {
      width: 100%;
    }

    .brand-identity-logos {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ═══════════════════════════════════════════════════════════
     PALETTE EXPLORER — variables and scope overrides
     (migrated from colors.astro)
     ═══════════════════════════════════════════════════════════ */

  .colors-palette-concept {
    color: var(--text-secondary);
    max-width: 680px;
    height: 3.2em;
    overflow: hidden;
    margin-bottom: var(--spacing-xl);
  }

  /* palette-scope layout (palette CSS vars now in palettes.css) */
  .palette-scope {
    padding-bottom: var(--spacing-3xl);
  }

  /* ── REMOVED: :root alt-color definitions, dark-theme overrides,
       .palette-scope tool derivations, and the html.palette-0 …
       html.palette-5 override blocks — all moved to
       src/styles/palettes.css, where they hang off <html> (the palette
       class is applied to the root element, never to this wrapper) ── */

  /* ── Component State Demo Layout ── */
  .brand-state-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-wide);
    align-items: flex-start;
    margin-bottom: var(--spacing-lg);
  }

  .brand-state-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--gap-wide);
    margin-bottom: var(--spacing-lg);
  }

  .brand-state-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    align-items: flex-start;
  }

  .brand-state-item--wide {
    min-width: 240px;
  }

  /* ── Forced state: hover ── */
  .brutal-btn--primary[data-demo-state='hover'] {
    background: transparent;
    color: var(--color-primary);
  }

  .brutal-btn--secondary[data-demo-state='hover'] {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .brutal-option-card[data-demo-state='hover'] {
    border-color: var(--color-primary);
    background: var(--accent-subtle-bg);
  }

  .brutal-choice-btn[data-demo-state='hover'] {
    border-color: var(--color-primary);
    color: var(--text-primary);
  }

  /* ── Forced state: focus ── */
  .brutal-btn[data-demo-state='focus'] {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .brutal-field__input[data-demo-state='focus'] {
    border-color: var(--color-primary);
    border-style: solid;
  }

  .brutal-option-card[data-demo-state='focus'] {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .brutal-choice-btn[data-demo-state='focus'] {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ── Forced state: error ── */
  .brutal-field__input[data-demo-state='error'] {
    border-color: var(--color-error);
    border-style: solid;
  }

  /* ── Forced state: readonly ── */
  .brutal-field__input[data-demo-state='readonly'] {
    color: var(--text-muted);
    cursor: default;
  }

  /* ── Forced state: focus on link ── */
  .brutal-link-interactive[data-demo-state='focus'] {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ── Accessibility Section ── */
  .a11y-contrast-table {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
  }

  .a11y-contrast-row {
    display: grid;
    grid-template-columns: 24px 1fr auto auto;
    gap: var(--spacing-md);
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-sm);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    background: var(--bg-light-alt);
    border: 1px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  .a11y-swatch {
    width: 24px;
    height: 24px;
    border: 1px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  .a11y-var {
    color: var(--text-secondary);
  }

  .a11y-ratio {
    color: var(--text-muted);
    text-align: right;
  }

  /* Text is --text-primary, NOT the semantic token: at --text-2xs (10.4px) the
     semantic colours land at 3.90:1 on this row's --bg-light-alt surface. The border
     carries pass/fail instead. Deliberately not a filled badge with dark ink either —
     /brand is the one page with a runtime palette switcher, palettes override
     --color-error, and black on palette 4's #9f1239 is 2.5:1. axe only scans the
     default palette, so that regression would never have been caught. */
  .a11y-badge {
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px var(--spacing-xs);
    border: 1px solid;
    color: var(--text-primary);
  }

  .a11y-badge--pass {
    border-color: var(--color-success);
  }

  /* Currently unused — kept deliberately: the contrast tables need it the moment a
     token lands between the AA and AAA thresholds, or fails for normal text. */
  .a11y-badge--warn {
    border-color: var(--color-warning);
  }

  .a11y-badge--fail {
    border-color: var(--color-error);
  }

  .a11y-touch-demo {
    position: relative;
    display: inline-flex;
  }

  /* Empty by design: the box IS the 44x44 indicator. It previously carried a
     "44x44" caption that painted straight over the button's own label, leaving
     both unreadable — the dimension lives in the code caption underneath. */
  .a11y-touch-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: var(--touch-target-min);
    height: var(--touch-target-min);
    border: 2px dashed var(--color-primary);
    pointer-events: none;
    opacity: 0.7;
  }

  .a11y-kb-table {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
  }

  .a11y-kb-row {
    display: grid;
    grid-template-columns: 140px 120px 1fr;
    gap: var(--spacing-md);
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-sm);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    background: var(--bg-light-alt);
    border: 1px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  .a11y-kb-row--header {
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: transparent;
    border: none;
    color: var(--text-muted);
  }

  .a11y-kb-row kbd {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    padding: 2px var(--spacing-xs);
    border: 1px solid light-dark(var(--border-light), var(--border-dark-default));
    background: var(--surface-tint-bg);
    color: var(--text-primary);
  }

  .a11y-code-block {
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
  }

  .a11y-code-block pre {
    background: var(--bg-light-alt);
    border: 1px solid light-dark(var(--border-light), var(--border-dark-default));
