    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* ── Responsive Demo Frames ── */
  .responsive-demo-row {
    display: flex;
    gap: var(--gap-wide);
    align-items: flex-start;
    margin-bottom: var(--spacing-2xl);
    overflow-x: auto;
  }

  .responsive-demo-frame {
    flex-shrink: 0;
    position: relative;
    border: 1px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  .responsive-demo-frame iframe {
    display: block;
    border: none;
    height: 200px;
    background: var(--bg-light);
    overflow: hidden;
  }

  .responsive-demo-frame--desktop iframe {
    width: 600px;
  }

  .responsive-demo-frame--tablet iframe {
    width: 384px;
    height: 350px;
  }

  .responsive-demo-frame--mobile iframe {
    width: 240px;
    height: 400px;
  }

  .responsive-demo-label {
