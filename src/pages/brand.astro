    font-family: var(--font-family-mono);
    font-size: 0.6rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 2px var(--spacing-xs);
    border-bottom: 1px solid light-dark(var(--border-light), var(--border-dark-default));
    background: var(--bg-light-alt);
  }

  /* TOC specimen — prevent sticky positioning inside demo */
  .brand-toc-specimen .toc {
    position: static;
    max-height: none;
    overflow-y: visible;
  }

  @media (max-width: 768px) {
    .responsive-demo-row {
      flex-direction: column;
    }

    .responsive-demo-frame--desktop iframe {
      width: 100%;
      min-width: 0;
    }

    .responsive-demo-frame--tablet iframe {
      width: 100%;
      min-width: 0;
    }

    .responsive-demo-frame--mobile iframe {
      width: 240px;
    }
  }

  /* ── Brand TOC (matches Hub Library article pattern) ── */
  .brand-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--spacing-2xl);
    max-width: 1400px;
    margin: 0 auto;
    align-items: start;
  }

  .brand-content {
    min-width: 0;
    overflow: hidden;
  }

  /* Layout positioning for shared TOC component */
  .brand-layout .toc {
    position: sticky;
    top: var(--spacing-xl);
    max-height: calc(100vh - var(--spacing-2xl));
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .brand-layout {
      display: block;
    }

    .brand-layout .toc {
      position: static;
      max-height: none;
      overflow-y: visible;
      margin-bottom: var(--spacing-lg);
    }
  }

  /* ═══════════════════════════════════════════════════════════
     Brand-page specimen styles — demo production components.
     Moved from global.css to keep them colocated with the page
     that uses them. Uses is:global so selectors remain unscoped.
     ═══════════════════════════════════════════════════════════ */

  /* ── Search Input ──────────────────────────────────── */
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
    width: 18px;
    height: 18px;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 0.75rem 0.75rem 2.5rem;
    background: var(--search-input-bg, rgba(26, 26, 26, 0.02));
    border: 1px solid var(--search-input-border, rgba(26, 26, 26, 0.1));
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-family: var(--font-family);
    transition: all var(--transition-fast);
    border-radius: 0;
  }

  .search-input:focus {
    outline: none;
    background: var(--bg-light);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--search-input-focus-shadow, var(--color-primary-10));
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  /* ── Filter Button + Badge ─────────────────────────── */
  .filter-button {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    cursor: pointer;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-weight: 700;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--spacing-sm);
    position: relative;
    font-family: var(--font-family);
    transition: color var(--transition-fast);
  }

  .filter-button:hover {
    color: var(--color-primary);
  }

  .filter-badge {
    background: var(--color-primary);
    color: var(--bg-light);
    font-size: var(--text-2xs);
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 50%;
    min-width: 18px;
    text-align: center;
    line-height: 1.2;
  }

  /* ── Modal ─────────────────────────────────────────── */
  .modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 700px;
    width: 90%;
    max-height: 85vh;
    padding: 2rem;
    /* Mirrors .project-modal (ProjectModal.astro) exactly — opaque, no backdrop blur */
    background: light-dark(var(--bg-light), var(--bg-dark-secondary));
    border: 1px solid light-dark(var(--border-light), var(--border-dark));
    border-radius: 0;
    clip-path: polygon(
      2.5% 0%,
      97.5% 0%,
      100% 2.5%,
      100% 97.5%,
      97.5% 100%,
      2.5% 100%,
      0% 97.5%,
      0% 2.5%
    );
    z-index: var(--z-modal);
    box-shadow: 0 20px 60px var(--scrim-30);
    overflow-y: auto;
  }

  .modal::backdrop {
    background: var(--scrim-50);
  }

  /* Positioning context for .modal__close (mirrors .modal-content in ProjectModal.astro) */
  .modal__content {
    position: relative;
  }

  .modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: 2px solid transparent;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-target-min);
    min-height: var(--touch-target-min);
    transition: all 0.2s;
  }

  .modal__close:hover {
    color: var(--color-primary);
    background: var(--accent-light-bg);
  }

  .modal__header {
    margin-bottom: 1.5rem;
  }

  .modal__title {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin: 0 0 0.25rem;
    letter-spacing: -0.01em;
  }

  .modal__industry {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .modal__metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-light);
  }

  .modal__section {
    margin-bottom: 1.5rem;
  }

  .modal__section-title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }

  .modal__tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── Portfolio specimen replicas ───────────────────
     The production originals (.metric-label, .metric-value, .tag, .tech-tag,
     .year-badge) live in Astro-scoped \3c style> blocks inside PortfolioGrid.astro
     and ProjectModal.astro, so they are unreachable from /brand. These .brand-*
     replicas mirror those declarations so the specimens render truthfully. */
  .brand-metric {
    display: flex;
    flex-direction: column;
  }

  .brand-metric__label {
    font-family: var(--font-family-mono);
    font-size: var(--text-2xs);
    color: light-dark(var(--text-muted), var(--text-dark-muted));
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .brand-metric__value {
    font-family: var(--font-family-mono);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .brand-metric__value--arr {
    color: var(--color-tertiary);
    font-size: var(--text-lg);
  }

  /* Responsive counterparts of PortfolioGrid's scoped 480px metric-value
     overrides — this replica half pairs with the `.project-card__*` half in
     cards.css, whose comment carries the full keep-in-sync ruling. */
  @media (max-width: 480px) {
    .brand-metric__value {
      font-size: var(--text-sm);
    }

    .brand-metric__value--arr {
      font-size: var(--text-base);
    }
  }

  /* ProjectModal.astro styles its metrics differently from the card — smaller,
     wider tracking, secondary colour. The modal specimen uses these so it does
     not borrow the card's treatment and misrepresent the dialog. */
  .brand-modal-metric__label {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: light-dark(var(--text-secondary), var(--text-muted));
    margin: 0 0 var(--spacing-sm);
  }

  .brand-modal-metric__value {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* --color-tertiary, matching .brand-tag--theme below, which already measures
     ~5.2:1 on a tinted surface. The base variant used --color-primary at ~1.95:1. */
  .brand-tag {
    font-family: var(--font-family-mono);
    background: var(--accent-dark-bg);
    color: var(--color-tertiary);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .brand-tag--theme {
    background: var(--accent-light-bg-hover);
    color: var(--color-tertiary);
  }

  .brand-tech-tag {
    background: light-dark(var(--filter-chip-bg-hover), var(--accent-dark-bg));
    color: var(--text-secondary);
    padding: 0.35rem 0.65rem;
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .brand-year-badge {
    font-family: var(--font-family-mono);
    background: light-dark(var(--filter-chip-bg), var(--accent-dark-bg));
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    border-radius: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  /* ── Stats Bar specimen ───────────────────────────── */
  /* The specimen renders the real <StatsBar>, whose own scoped styles apply.
     This only neutralises the `.container` it wraps its grid in, which would
     otherwise inset the specimen inside the brand column. */
  .brand-statsbar-specimen .container {
    max-width: none;
    padding: 0;
  }

  /* The CTA Box specimen renders the real CTABox.astro (BL-095 AC-2) — the
     replica CSS that lived here is gone with it. This wrapper only gives the
     box a definite containing block: `.brand-component-item` is a flex column
     with align-items:flex-start, so without it the 800px reading measure
     would shrink to fit (same indefinite-inline-size trap as the gateway
     grid, documented above). It targets itself, never `.cta-box`, so it
     cannot tie with the component's scoped rule. */
  .brand-cta-specimen {
    width: 100%;
  }

  /* ADAPTATION: left-align specimens (override global margin: 0 auto) */
  .brand-component-item .brutal-tool-shell {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  /* Responsive overrides for specimen components.
     The `.stats-grid` / `.stat-value` rules that used to live here went with the
     StatsBar replica — the real component ships its own 768px and 480px rules. */
  @media (max-width: 768px) {
    .modal__metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .modal__metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Delta chevron toggle demo
    const toggle = document.getElementById('chevron-toggle');
    const demo = document.getElementById('chevron-demo');
    if (toggle && demo) {
      toggle.addEventListener('click', () => {
        demo.classList.toggle('is-collapsed');
      });
    }

    // Modal demo
    const modalOpen = document.getElementById('demo-modal-open');
    const modal = document.getElementById('demo-modal') as HTMLDialogElement;
    const modalClose = document.getElementById('demo-modal-close');
    if (modalOpen && modal && modalClose) {
      modalOpen.addEventListener('click', () => modal.showModal());
      modalClose.addEventListener('click', () => modal.close());
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.close();
      });
    }

    // Brutalist slider demo — sync range, number input, and display value
    const sliderBrutal = document.getElementById('demo-slider-brutal') as HTMLInputElement;
    const sliderBrutalDirect = document.getElementById(
      'demo-slider-brutal-direct'
    ) as HTMLInputElement;
    const sliderBrutalValue = document.getElementById('demo-slider-brutal-value');
    if (sliderBrutal && sliderBrutalDirect && sliderBrutalValue) {
      sliderBrutal.addEventListener('input', () => {
        sliderBrutalValue.textContent = sliderBrutal.value;
        sliderBrutalDirect.value = sliderBrutal.value;
      });
      sliderBrutalDirect.addEventListener('input', () => {
        const v = Math.min(Math.max(parseInt(sliderBrutalDirect.value) || 1, 1), 50);
        sliderBrutal.value = String(v);
        sliderBrutalValue.textContent = String(v);
      });
    }

    // Option card single-select demo (current)
    document.querySelectorAll<HTMLElement>('[data-demo-option]').forEach((card) => {
      card.addEventListener('click', () => {
        document
          .querySelectorAll<HTMLElement>('[data-demo-option]')
          .forEach((c) => c.classList.remove('option-card--selected'));
        card.classList.add('option-card--selected');
      });
    });

    // Option card single-select demo (brutalist)
    document.querySelectorAll<HTMLElement>('[data-demo-option-brutal]').forEach((card) => {
      card.addEventListener('click', () => {
        document
          .querySelectorAll<HTMLElement>('[data-demo-option-brutal]')
          .forEach((c) => c.classList.remove('option-card-brutal--selected'));
        card.classList.add('option-card-brutal--selected');
      });
    });

    // Filter chip toggle demo (brutalist)
    document.querySelectorAll<HTMLElement>('[data-demo-chip-brutal]').forEach((chip) => {
      chip.addEventListener('click', () => {
        chip.classList.toggle('brand-chip-brutal--active');
      });
    });

    // Slider demo — sync range, number input, and display value
    const slider = document.getElementById('demo-slider') as HTMLInputElement;
    const sliderDirect = document.getElementById('demo-slider-direct') as HTMLInputElement;
    const sliderValue = document.getElementById('demo-slider-value');
    if (slider && sliderDirect && sliderValue) {
      slider.addEventListener('input', () => {
        sliderValue.textContent = slider.value;
        sliderDirect.value = slider.value;
      });
      sliderDirect.addEventListener('input', () => {
        const v = Math.min(Math.max(parseInt(sliderDirect.value) || 1, 1), 50);
        slider.value = String(v);
        sliderValue.textContent = String(v);
      });
    }

    // Brutalist recommendation card — collapse toggle and N/A dismiss
    const recBrutal = document.getElementById('demo-rec-brutal');
    const recBrutalNa = document.getElementById('demo-rec-brutal-na');
    if (recBrutal) {
      recBrutal.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.brutal-rec-card__na')) return;
        recBrutal.classList.toggle('is-collapsed');
      });
    }
    if (recBrutalNa && recBrutal) {
      recBrutalNa.addEventListener('click', () => {
        recBrutal.classList.toggle('is-dismissed');
      });
    }

    // Brutalist attention card — collapse toggle and N/A dismiss
    const attBrutal = document.getElementById('demo-attention-brutal');
    const attBrutalNa = document.getElementById('demo-attention-brutal-na');
    if (attBrutal) {
      attBrutal.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.brutal-na-btn')) return;
        attBrutal.classList.toggle('is-collapsed');
      });
    }
    if (attBrutalNa && attBrutal) {
      attBrutalNa.addEventListener('click', () => {
        attBrutal.classList.toggle('is-dismissed');
      });
    }

    // Responsive demo: sync theme to iframes
    const syncThemeToFrames = () => {
      const isDark = document.documentElement.classList.contains('dark-theme');
      document.querySelectorAll<HTMLIFrameElement>('.responsive-demo-frame iframe').forEach((f) => {
        // Same-origin target: the receiver validates e.origin, so the sender
        // pins targetOrigin rather than broadcasting to whatever holds the frame.
        f.contentWindow?.postMessage({ type: 'theme-sync', dark: isDark }, window.location.origin);
      });
    };
    // Observe theme class changes on <html>
    const themeObserver = new MutationObserver(syncThemeToFrames);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
    // Initial sync after iframes load
    document.querySelectorAll<HTMLIFrameElement>('.responsive-demo-frame iframe').forEach((f) => {
      f.addEventListener('load', syncThemeToFrames);
    });
  });
</script>
