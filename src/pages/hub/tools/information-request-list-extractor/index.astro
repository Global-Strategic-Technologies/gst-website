---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HubHeader from '../../../../components/hub/HubHeader.astro';
import DeltaIcon from '../../../../components/DeltaIcon.astro';
import { hubToolSchema } from '../../../../utils/hub-tool-schema';
---

<BaseLayout
  title="Information Request List Extractor | GST"
  description="Convert a filled Information Request List (.xlsx) into canonical markdown in your browser. The workbook is never uploaded."
  ogTitle="Information Request List Extractor | GST"
  ogDescription="Turn a filled IRL workbook into the canonical markdown gst_irl_sweep expects, deterministically and entirely in the browser."
  ogImage="/og-image.png"
  ogImageAlt="GST Information Request List Extractor"
  ogUrl="https://globalstrategic.tech/hub/tools/information-request-list-extractor/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      hubToolSchema({
        name: 'Information Request List Extractor',
        description:
          'Convert a filled Information Request List workbook into the canonical markdown body, deterministically and entirely in the browser',
        datePublished: '2026-08-30',
        dateModified: '2026-08-30',
        featureList: [
          'Filled .xlsx converted to canonical markdown client-side',
          'Byte-identical to the operator extractor for the same workbook',
          'Answered rows carried across verbatim with status and sourcing',
          'Workbook never leaves the browser',
        ],
        knowsAbout: [
          'Technical Due Diligence',
          'Information Request Lists',
          'Virtual Data Room Structure',
          'M&A Tech Strategy',
        ],
      })
    )}
  />

  <section class="irl-ext">
    <div class="container">
      <HubHeader
        title="Information Request List Extractor"
        subtitle="Turn a filled IRL workbook into the canonical markdown the sweep expects. Same bytes in, same text out, every time."
      />

      <div class="irl-ext__intro">
        <p>
          A filled <strong>.xlsx</strong> has to become text before <a
            href="/hub/mcp/docs/#cap-gst_irl_sweep"><code>gst_irl_sweep</code></a
          > can read it. This page does that in your browser, carrying every answered row across exactly
          as written with its status and any sourcing. Need the blank workbook first? Use the <a
            href="/hub/tools/information-request-list-generator/"
            >Information Request List Generator</a
          >.
        </p>
      </div>

      <div class="irl-ext__shell">
        <!-- ── 01 pick ─────────────────────────────────────────────── -->
        <div class="irl-ext__panel irl-ext__panel--pick">
          <div class="irl-ext__step">
            <span class="irl-ext__label">01 / Choose the workbook</span>
            <span class="irl-ext__hint">Any filled Information Request List (.xlsx)</span>
          </div>

          <div class="irl-ext__dropwrap">
            <input
              type="file"
              id="irl-ext-file"
              class="irl-ext__input"
              accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            />
            <label class="irl-ext__drop" id="irl-ext-drop" for="irl-ext-file">
              <DeltaIcon size={120} class="irl-ext__drop-icon" />
              <span class="irl-ext__drop-text">Drop a workbook here, or <span>browse</span></span>
              <span class="irl-ext__drop-note">Stays on your machine</span>
            </label>
          </div>

          <div class="irl-ext__diag" id="irl-ext-diag" data-empty="true">
            <span class="irl-ext__label">What came back</span>
            <dl class="irl-ext__diag-list">
              <div class="irl-ext__diag-row">
                <dt>Requests extracted</dt>
                <dd id="diag-bullets">&middot;</dd>
              </div>
              <div class="irl-ext__diag-row">
                <dt>Sections seen</dt>
                <dd id="diag-sections">&middot;</dd>
              </div>
              <div class="irl-ext__diag-row">
                <dt>Body size</dt>
                <dd id="diag-bytes">&middot;</dd>
              </div>
              <div class="irl-ext__diag-row">
                <dt>Answers taken from Comments</dt>
                <dd id="diag-comments">&middot;</dd>
              </div>
              <div class="irl-ext__diag-row">
                <dt>Status contradictions</dt>
                <dd id="diag-contradictions">&middot;</dd>
              </div>
            </dl>
            <p class="irl-ext__advisory" id="irl-ext-advisory" hidden></p>
          </div>
        </div>

        <!-- ── 02 output ───────────────────────────────────────────── -->
        <div class="irl-ext__panel irl-ext__panel--out">
          <div class="irl-ext__outhead">
            <div class="irl-ext__step">
              <span class="irl-ext__label">02 / Canonical markdown</span>
              <span class="irl-ext__status" id="irl-ext-status" role="status" aria-live="polite"
                >Waiting for a workbook</span
              >
            </div>
            <div class="irl-ext__actions" id="irl-ext-actions" data-enabled="false">
              <button type="button" class="brutal-btn brutal-btn--secondary" id="irl-ext-copy"
                >Copy markdown</button
              >
              <button type="button" class="brutal-btn brutal-btn--secondary" id="irl-ext-download"
                >Download .md</button
              >
            </div>
          </div>

          <div class="irl-ext__body">
            <div class="irl-ext__idle" id="irl-ext-idle">
              <p class="irl-ext__idle-text">
                Pick a workbook and its canonical markdown appears here, ready to paste into the
                sweep's <code>filledIrl</code> argument.
              </p>
            </div>
            <div class="irl-ext__error" id="irl-ext-error" hidden>
              <span class="irl-ext__error-title">Nothing to extract</span>
              <p class="irl-ext__error-body" id="irl-ext-error-body"></p>
              <p class="irl-ext__error-hint" id="irl-ext-error-hint"></p>
            </div>
            <!-- `tabindex="0"` is load-bearing, not decoration: a converted body is
                 routinely taller than this box, and without a tab stop a keyboard-only
                 user cannot scroll to the rest of it. axe rates that
                 `scrollable-region-focusable` (WCAG 2.1.1 Keyboard, Level A) at serious,
                 a severity this repo carries none of. Same fix, same reasoning, as the
                 timeline on `/hub/tools/regulatory-map/`; the role and label give the
                 stop an announceable identity instead of a bare unnamed group.

                 The attribute list is too long for one line, so the formatter breaks
                 the tag and puts the closing tag on a line of its own — and `pre` is
                 whitespace-significant, so this element's initial text content is a
                 newline plus the indent rather than nothing. It is inert: the element
                 is hidden until the first conversion, which replaces the content
                 outright. Left as the formatter writes it deliberately. A
                 prettier-ignore directive was tried and the Astro plugin mangled the
                 surrounding markup, twice, which is a worse trade than an inert
                 whitespace node. -->
            <pre
              class="irl-ext__md"
              id="irl-ext-md"
              tabindex="0"
              role="region"
              aria-label="Canonical markdown output, scrollable"
              hidden>
            </pre>
          </div>
        </div>
      </div>

      <div class="irl-ext__cards">
        <!-- Each item's prose is wrapped in a single span on purpose. The `li`
             is a flex container, so every bare text node and every inline
             `code`/`a` inside it would otherwise become its own flex item and
             be laid out (and wrapped) independently — which is exactly how the
             first bullet came to render as "Paste it into" beside a gap beside
             the rest of the sentence. One span keeps the sentence one run of
             inline text next to the icon. -->
        <div class="irl-ext__card">
          <h2>The file never leaves your machine</h2>
          <ul class="irl-ext__card-list">
            <li>
              <DeltaIcon class="bullet-icon" />
              <span>Your browser reads the workbook and converts it locally</span>
            </li>
            <li>
              <DeltaIcon class="bullet-icon" />
              <span>Nothing is uploaded, nothing is stored, and no account is involved</span>
            </li>
            <li>
              <DeltaIcon class="bullet-icon" />
              <span>Close the tab and it is gone</span>
            </li>
          </ul>
        </div>
        <div class="irl-ext__card">
          <h2>What to do with the markdown</h2>
          <ul class="irl-ext__card-list">
            <li>
              <DeltaIcon class="bullet-icon" />
              <span
                >Paste it into <code>gst_irl_sweep</code>'s <code>filledIrl</code> argument to get the
                dossier back. The <a
                  class="irl-ext__card-link"
                  href="/hub/mcp/docs/#cap-gst_irl_sweep">sweep contract</a
                > lists everything that comes back.</span
              >
            </li>
            <li>
              <DeltaIcon class="bullet-icon" />
              <span
                >Every row reading <code>&lt;NO RESPONSE&gt;</code> is a request the target did not answer.
                Those are the questions still outstanding, so read them before you pass the markdown on.</span
              >
            </li>
          </ul>
        </div>
      </div>

      <a href="/hub/tools/" class="cta-button irl-ext__back">Back to Tools</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Namespace import, matching `src/utils/irl/generate-xlsx.ts` — this is the
  // form proven to work through Vite in the browser. The operator CLI needs
  // the DEFAULT import instead (raw Node's CJS interop); the two differ on
  // purpose and are commented at both sites.
  import * as XLSX from 'xlsx-js-style';
  import {
    PRIMARY_SHEET_NAME,
    extractIrlMarkdownFromRows,
  } from '../../../../utils/irl/extract-markdown.mjs';
  import { copyWithFeedback } from '../../../../utils/copy-feedback';

  /**
   * The claude.ai web prompt-argument ceiling. Above this the body still
   * converts and is still valid — only the web client refuses to carry it as
   * a prompt arg, and Desktop does not. Advisory, never an error: the CLI
   * treats it the same way.
   */
  const WEB_PROMPT_ARG_CEILING = 57_000;

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const fileInput = el<HTMLInputElement>('irl-ext-file');
  const drop = el<HTMLLabelElement>('irl-ext-drop');
  const statusEl = el<HTMLSpanElement>('irl-ext-status');
  const idleEl = el<HTMLDivElement>('irl-ext-idle');
  const errorEl = el<HTMLDivElement>('irl-ext-error');
  const errorBody = el<HTMLParagraphElement>('irl-ext-error-body');
  const errorHint = el<HTMLParagraphElement>('irl-ext-error-hint');
  const mdEl = el<HTMLPreElement>('irl-ext-md');
  const actions = el<HTMLDivElement>('irl-ext-actions');
  const copyBtn = el<HTMLButtonElement>('irl-ext-copy');
  const downloadBtn = el<HTMLButtonElement>('irl-ext-download');
  const diag = el<HTMLDivElement>('irl-ext-diag');
  const advisory = el<HTMLParagraphElement>('irl-ext-advisory');

  /** Last successful extraction, held for the copy/download actions. */
  let current: { markdown: string; filename: string } | null = null;

  const DOT = '·';

  function setDiag(values: {
    bullets: string;
    sections: string;
    bytes: string;
    comments: string;
    contradictions: string;
  }) {
    const set = (id: string, v: string) => {
      const node = el<HTMLElement>(id);
      if (node) node.textContent = v;
    };
    set('diag-bullets', values.bullets);
    set('diag-sections', values.sections);
    set('diag-bytes', values.bytes);
    set('diag-comments', values.comments);
    set('diag-contradictions', values.contradictions);
  }

  function resetDiag() {
    setDiag({
      bullets: DOT,
      sections: DOT,
      bytes: DOT,
      comments: DOT,
      contradictions: DOT,
    });
    diag?.setAttribute('data-empty', 'true');
    if (advisory) advisory.hidden = true;
  }

  /** Show exactly one of the three body states. */
  function showState(state: 'idle' | 'error' | 'ok') {
    if (idleEl) idleEl.hidden = state !== 'idle';
    if (errorEl) errorEl.hidden = state !== 'error';
    if (mdEl) mdEl.hidden = state !== 'ok';
    actions?.setAttribute('data-enabled', String(state === 'ok'));
    if (copyBtn) copyBtn.disabled = state !== 'ok';
    if (downloadBtn) downloadBtn.disabled = state !== 'ok';
  }

  /**
   * The zero-row path. Reached only when the sheet holds no request rows at
   * all — i.e. the file is not an IRL. An unfilled TEMPLATE does not land
   * here: its rows are present, so it converts successfully into a body of
   * `<NO RESPONSE>` lines, exactly as the CLI does. That case is surfaced by
   * `noteUnanswered()` instead of being mislabelled as a failure.
   */
  function fail(sheetName: string) {
    current = null;
    if (statusEl) statusEl.textContent = `Read “${sheetName}”: 0 requests`;
    if (errorBody) {
      errorBody.textContent = `No request rows were found in “${sheetName}”, so there is nothing to convert.`;
    }
    if (errorHint) {
      errorHint.textContent = `This does not look like an Information Request List. “${sheetName}” is the sheet that was read.`;
    }
    setDiag({
      bullets: '0',
      sections: 'none',
      bytes: DOT,
      comments: DOT,
      contradictions: DOT,
    });
    diag?.setAttribute('data-empty', 'false');
    if (advisory) advisory.hidden = true;
    showState('error');
  }

  async function handleFile(file: File) {
    if (statusEl) statusEl.textContent = `Reading “${file.name}”…`;

    let workbook: XLSX.WorkBook;
    try {
      // The browser half of the read. The operator CLI does the same thing
      // with `readFileSync` + `{ type: 'buffer' }`; from the rows onward the
      // two paths run identical shared code.
      const buf = await file.arrayBuffer();
      workbook = XLSX.read(new Uint8Array(buf), { type: 'array' });
    } catch {
      current = null;
      if (statusEl) statusEl.textContent = 'Could not read that file';
      if (errorBody) {
        errorBody.textContent = `“${file.name}” could not be opened as a spreadsheet.`;
      }
      if (errorHint) {
        errorHint.textContent = 'Export it as .xlsx and try again.';
      }
      resetDiag();
      showState('error');
      return;
    }

    // Fall back to the first sheet, exactly as the CLI does, so a workbook
    // that is not an IRL lands on the legible zero-row path rather than an
    // error about sheet names.
    const sheetName = workbook.SheetNames.includes(PRIMARY_SHEET_NAME)
      ? PRIMARY_SHEET_NAME
      : workbook.SheetNames[0];
    const sheet = sheetName ? workbook.Sheets[sheetName] : undefined;
    if (!sheet || !sheetName) {
      fail('(no sheet)');
      return;
    }

    const rows = XLSX.utils.sheet_to_json<Array<string | number>>(sheet, {
      header: 1,
      defval: '',
    });
    const result = extractIrlMarkdownFromRows(rows);

    if (result.bulletCount === 0) {
      fail(sheetName);
      return;
    }

    const byteLength = new TextEncoder().encode(result.markdown).length;
    const kb = Math.round((byteLength / 1024) * 10) / 10;

    current = {
      markdown: result.markdown,
      filename: file.name.replace(/\.xlsx$/i, '') + '.md',
    };

    if (mdEl) mdEl.textContent = result.markdown;
    if (statusEl) {
      statusEl.textContent =
        `Read “${sheetName}”: ${result.bulletCount} ` +
        `${result.bulletCount === 1 ? 'request' : 'requests'} across ` +
        `${result.sectionsSeen.length} ${result.sectionsSeen.length === 1 ? 'section' : 'sections'}`;
    }

    setDiag({
      bullets: String(result.bulletCount),
      sections: result.sectionsSeen.length ? result.sectionsSeen.join(' ') : 'none',
      bytes: `${kb} KB`,
      comments: String(result.commentsSourcedAnswers.length),
      contradictions: String(result.statusContradictions.length),
    });
    diag?.setAttribute('data-empty', 'false');

    // Two advisories, neither of them an error. An unfilled template converts
    // successfully into a body of `<NO RESPONSE>` rows — the CLI does the same
    // — so the honest signal is "nothing here is answered yet", not a failure.
    const unanswered = result.markdown.split('— <NO RESPONSE>').length - 1;
    if (advisory) {
      if (unanswered === result.bulletCount) {
        advisory.textContent =
          `All ${result.bulletCount} rows are unanswered, so this looks like a template that has ` +
          'not been filled in yet. It converted, but there is nothing in it to sweep.';
        advisory.hidden = false;
      } else if (byteLength > WEB_PROMPT_ARG_CEILING) {
        advisory.textContent =
          `${byteLength.toLocaleString()} bytes exceeds the ~57,000-byte ceiling for a ` +
          'claude.ai web prompt argument. The body is still valid; paste it in the desktop app.';
        advisory.hidden = false;
      } else {
        advisory.hidden = true;
      }
    }

    showState('ok');
  }

  if (fileInput) {
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) void handleFile(file);
    });
  }

  if (drop) {
    for (const evt of ['dragenter', 'dragover'] as const) {
      drop.addEventListener(evt, (e) => {
        e.preventDefault();
        drop.setAttribute('data-dragging', 'true');
      });
    }
    for (const evt of ['dragleave', 'dragend'] as const) {
      drop.addEventListener(evt, () => drop.removeAttribute('data-dragging'));
    }
    drop.addEventListener('drop', (e: DragEvent) => {
      e.preventDefault();
      drop.removeAttribute('data-dragging');
      const file = e.dataTransfer?.files?.[0];
      if (file) void handleFile(file);
    });
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      if (!current) return;
      // Shared helper rather than a hand-rolled swap: it locks the button's
      // min-width for the duration, which matters on a page whose whole
      // premise is that nothing moves when you interact with it.
      void copyWithFeedback(current.markdown, copyBtn, {
        label: 'Copied',
        copiedClass: 'brutal-btn--copied',
      });
    });
  }

  if (downloadBtn) {
    downloadBtn.addEventListener('click', () => {
      if (!current) return;
      const blob = new Blob([current.markdown], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = current.filename;
      document.body.appendChild(anchor);
      anchor.click();
      document.body.removeChild(anchor);
      URL.revokeObjectURL(url);
    });
  }

  showState('idle');
  resetDiag();
</script>

<style>
  /* No top padding of its own: `HubHeader` already contributes 3xl above the
     title, and stacking a second 3xl here pushed the tool most of a screen
     down for nothing. */
  .irl-ext {
    padding: 0 0 var(--spacing-3xl);
  }

  /* Left-aligned, NOT centred: every other block on this page starts at the
     container's left edge, so an auto-margined intro sat ~310px inboard of the
     title above it and the shell below it. 720px matches
     `.hub-header__subtitle`'s measure, which is the line it reads as a
     continuation of. */
  .irl-ext__intro {
    max-width: 720px;
    margin: 0 0 var(--spacing-2xl);
  }

  .irl-ext__intro p {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .irl-ext__intro a {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: color var(--transition-fast);
  }

  .irl-ext__intro a:hover {
    color: var(--color-primary-dark);
  }

  /* ── shell ──────────────────────────────────────────────────────── */

  .irl-ext__shell {
    /* One source for the panel height, consumed as a fixed `height` by the
       output panel and as a `min-height` by the pick panel below.

       The 680px FLOOR is measured, not chosen: it is the pick panel's own
       resting content height (677px — step, dropzone, and five stacked
       label/value pairs), rounded up. Below it the pick panel overshoots the
       output panel and the two stop reading as a pair, which is what happened
       when the diagnostics went from one line per row to two and the floor was
       still 600. It costs almost nothing in page height, because the taller of
       the two panels is what the grid row was already sized by. */
    --irl-ext-panel-h: clamp(680px, calc(100vh - 300px), 780px);

    display: grid;
    grid-template-columns: 420px minmax(0, 1fr);
    gap: var(--spacing-2xl);
    align-items: start;
    margin-bottom: var(--spacing-2xl);
  }

  /* The control frost triple — `--surface-subtle-bg`, a 2px blur, and the
     inset highlight + hairline edge. The edge treatment is not decoration: on
     this site's flat checkerboard ground it is the only part of the treatment
     that reads at all (STYLES_GUIDE § Frosted Glass). Written out rather than
     co-applying `.brutal-frosted`, which is the CONTAINER pair and would both
     double-blur and use the wrong tint. */
  .irl-ext__panel {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    padding: var(--spacing-xl);
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    background: var(--surface-subtle-bg);
    backdrop-filter: blur(2px);
    box-shadow:
      inset 0 1px 0 var(--frost-highlight),
      0 0 0 1px var(--frost-edge);
    box-sizing: border-box;
  }

  /* The OUTPUT panel is the one whose height must not move: it swaps between
     the idle, error and markdown states, and anything below it would jump on
     every conversion. Sized against the viewport rather than pinned at the
     900px it used to be — taller than the viewport it had to fit inside — but
     still FIXED at any given viewport, so the no-shift property holds. */
  .irl-ext__panel--out {
    height: var(--irl-ext-panel-h);
  }

  /* The PICK panel matches that height so the two read as a pair, but as a
     FLOOR rather than a ceiling. Its content is stable except for the advisory
     paragraph, which appears on some results and needs about 90px the floor
     does not have; letting this panel grow is what keeps all five diagnostic
     rows on screen instead of scrolling three of them away.

     Measured, so the trade is on the record rather than implied:

       1440x900   rest 680/680   advisory pick 767.36, out 680, shift 87.36px
       1920x1200  rest 780/780   advisory pick 780,    out 780, shift 0
       1920x1400  rest 780/780   advisory pick 780,    out 780, shift 0

     So: both panels equal in every resting state; at the FLOOR tier the pick
     panel grows, the out panel does not move, and the cards and Back link below
     the shell go down 87px; at the CAP tier the slack absorbs it and nothing
     moves at all. The shift is real, confined to the floor tier, and happens on
     a state the reader just triggered — which beats hiding the contradictions
     count.

     The cap is 780px for exactly this: at 760px the advisory overshot by ~7px
     and the cap tier moved too, which the numbers above are here to keep
     honest. Break-even is 768px. Re-measure this table if the diagnostics gain
     a row or the advisory copy grows. */
  .irl-ext__panel--pick {
    min-height: var(--irl-ext-panel-h);
  }

  .irl-ext__step {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .irl-ext__label {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .irl-ext__hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ── dropzone ───────────────────────────────────────────────────── */

  .irl-ext__dropwrap {
    position: relative;
    flex-shrink: 0;
  }

  /* Visually hidden but focusable, so the control stays keyboard-reachable
     and the label's :focus-within ring is the visible focus indicator. */
  .irl-ext__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .irl-ext__drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-xl);
    text-align: center;
    cursor: pointer;
    border: 3px dashed var(--color-primary);
    transition:
      border-style var(--transition-fast),
      background var(--transition-fast);
  }

  .irl-ext__drop:hover,
  .irl-ext__drop[data-dragging='true'] {
    border-style: solid;
    background: var(--accent-tint-bg);
  }

  .irl-ext__input:focus-visible + .irl-ext__drop {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .irl-ext__drop :global(.irl-ext__drop-icon) {
    color: var(--color-primary);
    display: block;
  }

  .irl-ext__drop-text {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    line-height: 1.5;
  }

