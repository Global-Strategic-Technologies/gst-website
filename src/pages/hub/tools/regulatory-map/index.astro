---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HubHeader from '../../../../components/hub/HubHeader.astro';
import MapVisualizer from '../../../../components/hub/tools/regulatory-map/MapVisualizer.astro';
import CompliancePanel from '../../../../components/hub/tools/regulatory-map/CompliancePanel.astro';
import PrintReportHeader from '../../../../components/PrintReportHeader.astro';
import '../../../../styles/components/filter.css';

const faqItems = [
  {
    question: 'Why does regulatory coverage matter for technology investments?',
    answer:
      'Data privacy, AI governance, cybersecurity, and industry compliance obligations are embedded in nearly every modern business. They shape product decisions, customer engagement, and revenue. When a company operates across jurisdictions without a clear understanding of its regulatory exposure across these domains, the result is unchecked risk: fines, forced operational changes, or deal-killing liabilities discovered during diligence. For investors, regulatory posture is a direct indicator of operational maturity and risk.',
  },
  {
    question: 'What regulations does the map cover?',
    answer:
      "The map covers four categories of regulation across 123 frameworks worldwide. Data privacy includes the EU's GDPR, California's CCPA/CPRA, Brazil's LGPD, Canada's PIPEDA, and dozens of other national and sub-national laws. AI governance covers the EU AI Act, China's algorithm and generative AI regulations, South Korea's AI Basic Act, and US state-level AI laws addressing algorithmic discrimination, transparency, and automated decision-making. Cybersecurity includes the EU's NIS2 Directive, the US CIRCIA and CMMC frameworks, Singapore's Cybersecurity Act, and national cyber strategies across the Middle East, Africa, and Asia-Pacific. Industry compliance covers frameworks like DORA for financial services, SOX, Basel III, HIPAA, and PCI DSS. Coverage is continually expanding as new frameworks are enacted worldwide.",
  },
  {
    question: 'How current is the regulatory data shown here?',
    answer:
      "Regulatory data is sourced from official government publications and authoritative legal databases. The dataset is updated periodically to reflect new legislation, amendments, and enforcement changes. For time-sensitive compliance decisions, we recommend validating against the relevant regulatory authority's most recent publications.",
  },
  {
    question: 'How should I use this tool during due diligence?',
    answer:
      "Start by identifying every jurisdiction where the target company operates, collects or processes data, deploys AI systems, or maintains critical infrastructure. Use the map to surface applicable regulations across data privacy, AI governance, cybersecurity, and industry compliance in those regions, then cross-reference the target's compliance posture against each framework's key requirements. This gives you a structured view of regulatory exposure across all four domains, highlighting gaps that could translate into remediation costs, integration delays, or post-close liabilities.",
  },
  {
    question: 'Does GST provide regulatory compliance advisory?',
    answer:
      "<p>Yes. The Regulatory Map is one component of GST's broader technology diligence capability. When regulatory exposure is identified during an engagement, whether in data privacy, AI governance, cybersecurity, or industry compliance, we assess the scope of non-compliance, estimate remediation costs, and build those findings into our overall risk analysis and integration roadmap.</p><p><a href='/services/'>Learn more about our advisory services</a> or <a href='https://calendarbridge.com/book/globalstrategictech/'>schedule a consultation</a>.</p>",
  },
];

import DeltaIcon from '../../../../components/DeltaIcon.astro';
import { hubToolSchema } from '../../../../utils/hub-tool-schema';
---

<BaseLayout
  title="Regulatory Map | GST"
  description="Interactive map of global data privacy and AI regulations. Explore GDPR, CCPA, the EU AI Act, and dozens of other frameworks across jurisdictions."
  ogTitle="Regulatory Map | GST"
  ogDescription="Explore data privacy and AI regulatory frameworks, including GDPR, CCPA, EU AI Act and more, across global jurisdictions."
  ogImage="/og-image.png"
  ogImageAlt="Global Data Privacy and AI Regulatory Map"
  ogUrl="https://globalstrategic.tech/hub/tools/regulatory-map/"
  faqItems={faqItems}
>
  {/* Preload geodata so downloads start during HTML parsing, before the D3 module executes */}
  <link rel="preload" href="/data/world-110m.json" as="fetch" crossorigin />
  <link rel="prefetch" href="/data/us-states-10m.json" as="fetch" crossorigin />
  <link rel="prefetch" href="/data/canada-provinces.json" as="fetch" crossorigin />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      hubToolSchema({
        name: 'Regulatory Map',
        description:
          'Interactive map of 123 global data privacy, AI governance, cybersecurity, and compliance regulations across jurisdictions',
        datePublished: '2026-01-15',
        dateModified: '2026-03-22',
        featureList: [
          '123 regulations across 4 categories',
          'Interactive D3 world map',
          'Jurisdiction-specific compliance details',
          'Data privacy, AI governance, cybersecurity, and industry compliance',
        ],
        knowsAbout: [
          'Regulatory Compliance',
          'Data Privacy',
          'AI Governance',
          'Technical Due Diligence',
          'M&A Tech Strategy',
        ],
      })
    )}
  />
  <section class="regulatory-map-section">
    <div class="container">
      <PrintReportHeader title="Regulatory Map" />

      <HubHeader
        title="Regulatory Map"
        subtitle="Data privacy and artificial intelligence are among the most actively regulated areas in technology. Understanding the frameworks governing how data can be collected, stored, and transferred, and how AI can be developed and deployed, across jurisdictions is imperative."
      />

      <div class="map-layout" id="mapLayout">
        <div class="map-wrapper">
          <MapVisualizer />
          <div class="brutal-legend map-legend-positioned">
            <div class="brutal-legend__item">
              <span
                class="brutal-legend__swatch brutal-legend__swatch--active"
                aria-hidden="true"
              ></span>
              <span class="brutal-legend__label">Regulation coverage</span>
            </div>
            <div class="brutal-legend__item">
              <span
                class="brutal-legend__swatch brutal-legend__swatch--neutral"
                aria-hidden="true"
              ></span>
              <span class="brutal-legend__label">No data</span>
            </div>
          </div>
          <div class="brutal-map-cta" id="mapCta">
            <svg
              class="brutal-map-cta__icon"
              width="20"
              height="20"
              viewBox="0 0 64 64"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M32 12 L52 52 L12 52 Z"
                stroke="currentColor"
                stroke-width="6"
                stroke-linejoin="miter"
              ></path>
            </svg>
            <span class="brutal-map-cta__text">
              Select a highlighted region to view regulatory details
            </span>
          </div>
        </div>
        <CompliancePanel />
        <div class="brutal-bottom-sheet__overlay" id="bottomSheetOverlay" hidden></div>
      </div>

      <div class="regulation-filters" role="toolbar" aria-label="Filter regulations by category">
        <div class="regulation-search" id="regulationSearch">
          <div class="brutal-search">
            <svg
              class="brutal-search__icon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"></circle>
              <path
                d="M10.5 10.5L14.5 14.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
            </svg>
            <input
              type="search"
              id="regulationSearchInput"
              class="brutal-search__input"
              placeholder="Search regulations..."
              aria-label="Search regulations by name or common short form"
              autocomplete="off"
            />
            <button
              id="searchClearBtn"
              class="brutal-search__clear"
              aria-label="Clear search"
              hidden
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path
                  d="M3 3l8 8M11 3l-8 8"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                ></path>
              </svg>
            </button>
          </div>
          <div
            class="brutal-search__results"
            id="searchResults"
            role="listbox"
            aria-label="Search results"
            hidden
          ></div>
        </div>
        <div class="brutal-filter-chips" id="regulation-filter-chips">
          <button
            class="brutal-filter-chip brutal-filter-chip--all brutal-filter-chip--active"
            data-category="all"
          >
            All
          </button>
          <button
            class="brutal-filter-chip brutal-filter-chip--privacy"
            data-category="data-privacy"
          >
            Data Privacy
          </button>
          <button class="brutal-filter-chip brutal-filter-chip--ai" data-category="ai-governance">
            AI Governance
          </button>
          <button
            class="brutal-filter-chip brutal-filter-chip--industry"
            data-category="industry-compliance"
          >
            Industry Compliance
          </button>
          <button
            class="brutal-filter-chip brutal-filter-chip--cyber"
            data-category="cybersecurity"
          >
            Cybersecurity
          </button>
        </div>
      </div>

      <div class="timeline-section" id="timelineSection">
        <h2 class="timeline-heading brutal-heading-md">Regulation Timeline</h2>
        <div class="timeline-legend">
          <span class="timeline-legend__item">
            <span
              class="brutal-timeline-dot brutal-timeline-dot--privacy"
              aria-hidden="true"
            ></span>{' '}
            Data Privacy
          </span>
          <span class="timeline-legend__item">
            <span class="brutal-timeline-dot brutal-timeline-dot--ai" aria-hidden="true"></span> AI
            Governance
          </span>
          <span class="timeline-legend__item">
            <span
              class="brutal-timeline-dot brutal-timeline-dot--industry"
              aria-hidden="true"
            ></span>{' '}
            Industry Compliance
          </span>
          <span class="timeline-legend__item">
            <span class="brutal-timeline-dot brutal-timeline-dot--cyber" aria-hidden="true"></span>{' '}
            Cybersecurity
          </span>
        </div>
        <!-- tabindex="0" is load-bearing, not decoration: this region scrolls
             horizontally and without it a keyboard user cannot reach the content that
             is off-screen. axe rates it `scrollable-region-focusable` (WCAG 2.1.1
             Keyboard, Level A). The role+label give the focus stop an announceable
             identity rather than a bare unnamed group.

             The entries inside are native <button>s (BL-104), so Tab reaches each one and
             Enter/Space opens it through the same delegated click handler. The region's
             own focus stop stays: when a filter leaves no entries it is the only one. -->
        <div
          class="timeline-scroll"
          id="timelineScroll"
          tabindex="0"
          role="region"
          aria-label="Regulation timeline, scrollable horizontally"
        >
          <div class="timeline-track" id="timelineTrack">
            <!-- Rendered by client JS -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2 class="brutal-heading-lg">Frequently Asked Questions</h2>
      <div class="brutal-faq brutal-faq--lg">
        {faqItems.map((item) => (
          <details class="brutal-faq__item">
            <summary class="brutal-faq__question">
              <span>{item.question}</span>
              <DeltaIcon class="delta-chevron" />
            </summary>
            <div class="brutal-faq__answer" set:html={item.answer} />
          </details>
        ))}
      </div>
      <div class="print-report-footer" aria-hidden="true">
        <p>Generated from globalstrategic.tech/hub/tools/regulatory-map</p>
        <p>
          Data is informational only and does not constitute legal advice. Verify all regulatory
          requirements with qualified counsel.
        </p>
      </div>
      <a href="/hub/tools/" class="cta-button back-link">
        Back to Tools
      </a>
    </div>
  </section>
  <link rel="preload" href="/data/reg-index.json" as="fetch" crossorigin />
</BaseLayout>

<script>
  import '../../../../scripts/regulatory-map';
</script>

<style>
  .regulatory-map-section {
    padding-bottom: var(--spacing-3xl);
  }

  /* Bottom sheet overlay (mobile) */
  .brutal-bottom-sheet__overlay {
    display: none;
  }

  @media (max-width: 1023px) {
    .brutal-bottom-sheet__overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: var(--scrim-40);
      z-index: 50;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-slow);
    }

    .brutal-bottom-sheet__overlay.visible {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .regulation-filters {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-sm);
  }

  @media (max-width: 1023px) {
    .regulation-filters {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--bg-light);
      padding: var(--spacing-sm) 0;
      border-bottom: 1px solid light-dark(var(--border-light), var(--border-dark));
    }
  }

  /* Search */
  .regulation-search {
    width: 100%;
    max-width: 480px;
    position: relative;
  }

  /* Search — uses global .brutal-search classes; scoped overrides only */

  @media (max-width: 1023px) {
    .regulation-search {
      max-width: none;
    }
  }

  @media (max-width: 767px) {
    :global(.brutal-search__results) {
      max-height: 50vh;
    }
  }

  /* Filter chips use global .brutal-filter-chip classes — see global.css */
  .brutal-filter-chips {
    justify-content: center;
    gap: var(--spacing-md);
  }

  .map-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    align-items: start;
    max-width: 960px;
    margin: 0 auto;
  }

  .map-wrapper {
    position: relative;
    overflow: hidden;
  }

  /* Legend & CTA — uses global .brutal-legend / .brutal-map-cta; scoped positioning only */
  .map-legend-positioned {
    position: absolute;
    bottom: var(--spacing-sm);
    left: var(--spacing-sm);
    flex-direction: row;
    gap: var(--spacing-md);
    z-index: 5;
  }

  .brutal-map-cta {
    position: absolute;
    bottom: var(--spacing-sm);
    right: var(--spacing-sm);
    z-index: 5;
    pointer-events: none;
  }

  .back-link {
    display: inline-block;
    margin-top: var(--spacing-2xl);
  }

  /* Mobile: legend static below map, hide CTA (tap bar covers this UX) */
  @media (max-width: 1023px) {
    .map-legend-positioned {
      position: static;
      background: transparent;
      border: none;
      justify-content: center;
      padding: var(--spacing-sm) 0;
      z-index: auto;
    }

    .brutal-map-cta {
      display: none;
    }
  }

  /* Responsive */
  @media (min-width: 1024px) {
    .map-layout:has(.brutal-panel:not([hidden])) {
      grid-template-columns: 1fr 380px;
      gap: var(--spacing-xl);
      max-width: none;
    }
  }

  /* FAQ Section */
  .faq-section {
    padding: var(--spacing-3xl) 0;
  }

  /* FAQ — uses global .brutal-faq classes; scoped layout only */
  .faq-section .brutal-heading-lg {
    margin-bottom: var(--spacing-2xl);
    text-align: center;
  }

  .brutal-faq {
    max-width: 800px;
    margin: 0 auto;
  }

  @media (max-width: 1023px) {
    .faq-section {
      position: relative;
      z-index: 0;
    }
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: var(--spacing-2xl) 0;
    }
  }

  /* Timeline — uses global .brutal-timeline-* classes; scoped layout for horizontal scroll */
  .timeline-section {
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-2xl);
    border-top: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  .timeline-heading {
    text-align: center;
    margin-bottom: var(--spacing-md);
  }

  /* Wraps for the same reason the footer link row does: four fixed-width items
     in a nowrap flex row cannot shrink, so at 320px the last one sat 8px off
     the right edge in WebKit and the page scrolled sideways. That 8px was
     measured under the flat 96px gutter; the ladder (global.css, 2026-09-01)
     has since given 320px 64px more room, so the wrap is now CONSERVATIVE
     RATHER THAN EXACT. Kept as the safety net — a nowrap row that cannot shrink
     is one label change away from overflowing again. */
  .timeline-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-lg);
    row-gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xl);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    color: light-dark(var(--text-secondary), var(--text-dark-muted));
  }

  .timeline-legend__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .timeline-scroll {
    min-height: 140px; /* Reserve space to prevent CLS when renderTimeline() injects content */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-top: 14px;
    padding-bottom: var(--spacing-sm);
    cursor: grab;
  }

  .timeline-scroll::-webkit-scrollbar {
    height: 6px;
  }

  .timeline-scroll::-webkit-scrollbar-track {
    background: var(--surface-tint-bg);
    border-radius: 0;
  }

  .timeline-scroll::-webkit-scrollbar-thumb {
    background: light-dark(rgba(26, 26, 26, 0.15), var(--border-dark-default));
    border-radius: 0;
  }

  :global(.timeline-track) {
    display: flex;
    align-items: flex-start;
    gap: 0;
    min-width: max-content;
    padding: var(--spacing-sm) var(--spacing-lg);
    position: relative;
  }

  :global(.timeline-track::before) {
    content: '';
    position: absolute;
    top: var(--spacing-1_75);
    left: var(--spacing-lg);
    right: var(--spacing-lg);
    height: 2px;
    background: light-dark(var(--border-light), var(--border-dark-default));
    z-index: 0;
  }

  /* Horizontal scroll overrides for .brutal-timeline-* base classes.
       Use .timeline-track parent to beat global.css specificity
       regardless of Astro's production CSS chunk load order. */
  :global(.timeline-track .brutal-timeline-entry) {
    position: relative;
    z-index: 1;
  }

  :global(.timeline-track .brutal-timeline-entry__name) {
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Today marker — absolute positioned in horizontal timeline */
  :global(.timeline-track .brutal-timeline-today) {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: absolute;
    top: -6px;
    transform: translateX(-50%);
    z-index: 2;
    pointer-events: none;
  }

  :global(.timeline-track .brutal-timeline-today::after) {
    content: '';
    width: 2px;
    flex: 1;
    min-height: 60px;
    background: var(--color-primary);
    opacity: 0.6;
  }

  :global(.timeline-track .brutal-timeline-today__label) {
    white-space: nowrap;
    margin-bottom: 2px;
  }

  /* Print-only footer (hidden on screen). The print header is the
     PrintReportHeader component, which hides and styles itself. */
  .print-report-footer {
    display: none;
  }

  @media print {
    /* Hide interactive chrome. The map controls, hint and sheet handle are
       rendered by MapVisualizer / CompliancePanel, and the breadcrumb by
       BaseLayout, so they need :global(). */
    :global(.site-header),
    :global(footer),
    .regulation-filters,
    :global(.map-controls),
    :global(.map-quick-zoom),
    .brutal-map-cta,
    :global(.brutal-map-hint),
    .brutal-bottom-sheet__overlay,
    :global(.brutal-bottom-sheet__handle),
    .back-link,
    :global(.breadcrumb) {
      display: none !important;
    }

    /* Show print footer */
    .print-report-footer {
      display: block !important;
      margin-top: var(--spacing-2xl);
      padding-top: var(--spacing-lg);
      border-top: 1px solid var(--border-light);
    }

    .print-report-footer p {
      font-family: var(--font-family-mono);
      font-size: 8pt;
      color: var(--text-muted);
      margin: 0 0 var(--spacing-xs);
      line-height: 1.4;
    }

    /* Map: static, bordered */
    .map-wrapper {
      page-break-inside: avoid;
    }

    :global(.brutal-map-container) {
      border: 1px solid var(--border-light) !important;
      overflow: visible;
    }

    /* Panel: static layout */
    :global(.brutal-panel) {
      position: static !important;
      max-height: none !important;
      overflow: visible !important;
      transform: none !important;
      transition: none !important;
      border: 1px solid var(--border-light) !important;
      border-top: 3px solid var(--color-primary) !important;
      page-break-inside: avoid;
    }

    :global(.brutal-reg-card) {
      border: 1px solid var(--border-light) !important;
      border-left: 3px solid var(--color-primary) !important;
      break-inside: avoid;
    }

    /* Timeline: no scroll, static */
    .timeline-scroll {
      overflow: visible;
      max-width: 100%;
    }

    :global(.timeline-track .brutal-timeline-entry) {
      color: var(--text-primary);
    }

    /* FAQ: readable, no collapse */
    :global(.brutal-faq__item) {
      border: 1px solid var(--border-light) !important;
      break-inside: avoid;
    }

    .map-layout {
      grid-template-columns: 1fr !important;
      max-width: 100%;
    }

    @page {
      margin: 1.5cm;
    }
  }
</style>
