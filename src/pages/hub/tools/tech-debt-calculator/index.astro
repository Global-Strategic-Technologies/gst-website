---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HubHeader from '../../../../components/hub/HubHeader.astro';
import PrintReportHeader from '../../../../components/PrintReportHeader.astro';
import { DEPLOY_OPTIONS, DEFAULT_STATE } from '../../../../utils/tech-debt-engine';
import { hubToolSchema } from '../../../../utils/hub-tool-schema';
---

<BaseLayout
  title="Technical Debt Cost Calculator | GST"
  description="Quantify the annual cost of technical debt. Built for PE diligence and portfolio executive conversations."
  ogTitle="Technical Debt Cost Calculator | GST"
  ogDescription="Quantify the annual carrying cost of technical debt. Input team size, salary, maintenance burden, and delivery metrics to produce defensible estimates."
  ogImage="/og-image.png"
  ogImageAlt="Technical Debt Cost Calculator for Engineering Teams"
  ogUrl="https://globalstrategic.tech/hub/tools/tech-debt-calculator/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      hubToolSchema({
        name: 'Technical Debt Cost Calculator',
        description:
          'Quantify the annual carrying cost of technical debt for PE diligence and portfolio executive conversations',
        datePublished: '2025-06-01',
        dateModified: '2026-03-20',
        featureList: [
          'Annual carrying cost quantification',
          'Team size and salary inputs',
          'Maintenance burden and delivery metrics',
          'Defensible estimates for PE conversations',
        ],
        knowsAbout: [
          'Technical Due Diligence',
          'Technical Debt Assessment',
          'M&A Tech Strategy',
          'DORA Metrics',
          'Software Engineering Economics',
        ],
      })
    )}
  />
  <section class="tdc-section">
    <div class="container">
      <HubHeader
        title="Tech Debt Cost Calculator"
        subtitle="Quantify the real cost of deferred technical investment. Built for PE diligence and portfolio executive conversations."
      />

      <PrintReportHeader title="Technical Debt Cost Report" />

      <div data-calc class="brutal-tool-shell brutal-tool-shell--wide">
        <p class="brutal-tool-shell__authority tdc-authority">
          Methodology built from 100+ PE technology diligence engagements
        </p>

        <!-- Shared-link range-adjustment notice (populated by decodeState on load) -->
        <p class="tdc-shared-notice" data-shared-notice role="status" aria-live="polite" hidden></p>

        <!-- ── Core inputs ─────────────────────────────────────────── -->
        <div class="inputs-section">
          <div class="brutal-tool-shell__section-label section-label">Team & Cost</div>

          <div class="sliders-stack">
            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-team-size">
                  Team Size
                </label>
                <span class="brutal-slider__value" data-display="team-size">
                  8
                </span>
              </div>
              <input
                id="input-team-size"
                type="range"
                min="0"
                max="100"
                step="0.1"
                class="brutal-slider__input"
                data-input="team-size"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="14"
                aria-valuetext="8 engineers"
              />
              <div class="brutal-slider__hints">
                <input
                  type="number"
                  class="brutal-slider__direct"
                  data-direct="team-size"
                  min="1"
                  max="500"
                  step="1"
                  value="8"
                  aria-label="Number of engineers"
                />
              </div>
              <span
                class="brutal-slider__clamp-msg brutal-text-tiny"
                data-clamp-msg="team-size"
                role="status"
                aria-live="polite"
                style="display:none"
              ></span>
            </div>

            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-salary">
                  Avg. Salary (all-in)
                </label>
                <span class="brutal-slider__value" data-display="salary">
                  $150K
                </span>
              </div>
              <input
                id="input-salary"
                type="range"
                min="0"
                max="100"
                step="0.1"
                class="brutal-slider__input"
                data-input="salary"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="31"
                aria-valuetext="$150K"
              />
              <div class="brutal-slider__hints">
                <input
                  type="text"
                  class="brutal-slider__direct"
                  data-direct="salary"
                  value="150000"
                  aria-label="Average all-in salary in dollars"
                />
              </div>
              <span
                class="brutal-slider__clamp-msg brutal-text-tiny"
                data-clamp-msg="salary"
                role="status"
                aria-live="polite"
                style="display:none"
              ></span>
            </div>

            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-maint-pct">
                  Maintenance Burden
                </label>
                <span class="brutal-slider__value" data-display="maint-pct">
                  25%
                </span>
              </div>
              <input
                id="input-maint-pct"
                type="range"
                min="0"
                max="100"
                step="1"
                class="brutal-slider__input"
                data-input="maint-pct"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="25"
                aria-valuetext="25%"
              />
              <div class="brutal-slider__hints">
                <input
                  type="number"
                  class="brutal-slider__direct"
                  data-direct="maint-pct"
                  min="0"
                  max="100"
                  step="1"
                  value="25"
                  aria-label="Maintenance burden percentage"
                />
              </div>
              <span
                class="brutal-slider__clamp-msg brutal-text-tiny"
                data-clamp-msg="maint-pct"
                role="status"
                aria-live="polite"
                style="display:none"
              ></span>
              <div class="slider-benchmark">
                Estimate: what % of engineering sprints go to bugs, maintenance, and
                keep-the-lights-on work? The complement of feature velocity.
              </div>
              <div class="slider-benchmark">
                &lt; 10% well-managed &nbsp;·&nbsp; 15%+ yellow flag &nbsp;·&nbsp; 25%+ red flag
              </div>
            </div>
          </div>
        </div>

        <!-- ── Advanced inputs (collapsible) ──────────────────────── -->
        <div class="advanced-section">
          <button data-advanced-toggle type="button" class="advanced-toggle" aria-expanded="false">
            <span data-toggle-label>Show Advanced Inputs</span>
            <span class="toggle-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M4 6l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
          </button>

          <div data-advanced-panel class="advanced-panel is-hidden">
            <div class="brutal-tool-shell__section-label section-label">Delivery & Incidents</div>
            <div class="sliders-grid-2">
              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-incidents">
                    Incidents / Mo
                  </label>
                  <span class="brutal-slider__value" data-display="incidents">
                    3
                  </span>
                </div>
                <input
                  id="input-incidents"
                  type="range"
                  min="0"
                  max="20"
                  step="1"
                  class="brutal-slider__input"
                  data-input="incidents"
                  aria-valuemin="0"
                  aria-valuemax="20"
                  aria-valuenow="3"
                  aria-valuetext="3 per month"
                />
                <div class="brutal-slider__hints">
                  <input
                    type="number"
                    class="brutal-slider__direct"
                    data-direct="incidents"
                    min="0"
                    max="20"
                    step="1"
                    value="3"
                    aria-label="Incidents per month"
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="incidents"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>

              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-mttr">
                    Avg. Time to Resolve
                  </label>
                  <span class="brutal-slider__value" data-display="mttr">
                    4h
                  </span>
                </div>
                <input
                  id="input-mttr"
                  type="range"
                  min="1"
                  max="48"
                  step="1"
                  class="brutal-slider__input"
                  data-input="mttr"
                  aria-valuemin="1"
                  aria-valuemax="48"
                  aria-valuenow="4"
                  aria-valuetext="4 hours"
                />
                <div class="brutal-slider__hints">
                  <input
                    type="number"
                    class="brutal-slider__direct"
                    data-direct="mttr"
                    min="1"
                    max="48"
                    step="1"
                    value="4"
                    aria-label="Average hours to resolve"
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="mttr"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>
            </div>

            <div class="context-switch-toggle">
              <label class="brutal-toggle">
                <input type="checkbox" id="input-context-switch" data-input="context-switch" />
                <span class="brutal-toggle__label">Include context-switch overhead (+23%)</span>
              </label>
              <span class="brutal-toggle__hint">
                Weinberg's research: each concurrent task adds ~23% cognitive overhead to direct
                labor
              </span>
            </div>

            <div class="brutal-tool-shell__section-label section-label section-label--spaced">
              Deployment Frequency
            </div>
            <div class="deploy-grid">
              {DEPLOY_OPTIONS.map((opt, i) => (
                <button
                  data-deploy-btn={i}
                  class={`deploy-btn${i === DEFAULT_STATE.deployIdx ? ' active' : ''}`}
                  type="button"
                  aria-pressed={i === DEFAULT_STATE.deployIdx ? 'true' : 'false'}
                >
                  {opt.label}
                </button>
              ))}
            </div>
            <div data-dora-message class="dora-message"></div>

            <div class="brutal-tool-shell__section-label section-label section-label--spaced">
              ROI Analysis
            </div>
            <div class="sliders-grid-2">
              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-arr">
                    Annual Recurring Revenue
                  </label>
                  <span class="brutal-slider__value" data-display="arr">
                    $10M
                  </span>
                </div>
                <input
                  id="input-arr"
                  type="range"
                  min="0"
                  max="100"
                  step="0.1"
                  class="brutal-slider__input"
                  data-input="arr"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="37"
                  aria-valuetext="$10M"
                />
                <div class="brutal-slider__hints">
                  <input
                    type="text"
                    class="brutal-slider__direct"
                    data-direct="arr"
                    value="10000000"
                    aria-label="Annual recurring revenue in dollars"
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="arr"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>

              <div class="brutal-slider">
                <div class="brutal-slider__header">
                  <label class="brutal-slider__label" for="input-budget">
                    Remediation Budget
                  </label>
                  <span class="brutal-slider__value" data-display="budget">
                    $500K
                  </span>
                </div>
                <input
                  id="input-budget"
                  type="range"
                  min="0"
                  max="100"
                  step="0.1"
                  class="brutal-slider__input"
                  data-input="budget"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="33"
                  aria-valuetext="$500K"
                />
                <div class="brutal-slider__hints">
                  <input
                    type="text"
                    class="brutal-slider__direct"
                    data-direct="budget"
                    value="500000"
                    aria-label="Remediation budget in dollars"
                  />
                </div>
                <span
                  class="brutal-slider__clamp-msg brutal-text-tiny"
                  data-clamp-msg="budget"
                  role="status"
                  aria-live="polite"
                  style="display:none"
                ></span>
              </div>
            </div>

            <div class="brutal-slider">
              <div class="brutal-slider__header">
                <label class="brutal-slider__label" for="input-remediation">
                  Remediation Efficiency
                </label>
                <span class="brutal-slider__value" data-display="remediation">
                  70%
                </span>
              </div>
              <input
                id="input-remediation"
                type="range"
                min="0"
                max="100"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="70"
                aria-valuetext="70%"
                step="1"
                value="70"
                class="brutal-slider__input"
                data-input="remediation"
              />
              <div class="brutal-slider__hints">
                <span>0%</span>
                <span>100%</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Results panel ───────────────────────────────────────── -->
        <div class="results-section" role="status" aria-live="polite" aria-atomic="false">
          <div class="brutal-tool-shell__section-label section-label">Results</div>

          <!-- Primary figure -->
          <div class="result-primary">
            <div>
              <div class="result-cost-label">Annual Cost of Debt</div>
              <div class="result-cost-value" data-metric="annual-cost">
                —
              </div>
              <div class="result-cost-sub">
                <span data-metric="per-month">—</span> / mo
              </div>
            </div>
          </div>

          <!-- Core metrics grid -->
          <div class="result-grid">
            <div class="result-stat">
              <div class="result-stat-label">Hrs lost / eng / wk</div>
              <div class="result-stat-value" data-metric="hrs-lost">
                —
              </div>
            </div>
            <div class="result-stat">
              <div class="result-stat-label">Cost / eng / mo</div>
              <div class="result-stat-value" data-metric="cost-per-eng">
                —
              </div>
            </div>
            <div class="result-stat">
              <div class="result-stat-label">FTEs lost to debt</div>
              <div class="result-stat-value" id="ctx-engs-lost">
                —
              </div>
            </div>
            <div class="result-stat">
              <div class="result-stat-label">Burden level</div>
              <div class="result-stat-value" id="ctx-burden-label">
                —
              </div>
              <div class="result-stat-range" id="ctx-burden-range"></div>
            </div>
          </div>

          <!-- Advanced metrics — only visible when advanced is open -->
          <div data-adv-results class="adv-results is-hidden">
            <div class="adv-results__grid">
              <div class="result-stat">
                <div class="result-stat-label">Direct Labor</div>
                <div class="result-stat-value" data-metric="direct-labor">
                  —
                </div>
              </div>
              <div class="result-stat" id="ctx-switch-stat" style="display:none;">
                <div class="result-stat-label">Context-Switch Cost</div>
                <div class="result-stat-value" data-metric="context-switch">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">Incident Labor</div>
                <div class="result-stat-value" data-metric="incident-labor">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">Velocity (V)</div>
                <div class="result-stat-value" data-metric="velocity">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">Debt % of ARR</div>
                <div class="result-stat-value" data-metric="debt-pct-arr">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">Break-even</div>
                <div class="result-stat-value" id="payback-breakeven">
                  —
                </div>
              </div>
              <div class="result-stat">
                <div class="result-stat-label">Est. Monthly Savings</div>
                <div class="result-stat-value result-stat-value--teal" id="payback-savings">
                  —
                </div>
              </div>
            </div>
            <div class="payback-disclaimer" id="payback-disclaimer"></div>
          </div>

          <!-- Contextual note -->
          <p class="result-note" id="ctx-note"></p>
        </div>

        <!-- ── Methodology ─────────────────────────────────────────── -->
        <details class="tool-methodology">
          <summary class="tool-methodology__trigger">How the calculator works</summary>
          <div class="tool-methodology__body">
            <h4 class="tool-methodology__heading">Cost model</h4>
            <p>
              The calculator estimates the annual carrying cost of technical debt by multiplying
              engineering labor cost by the maintenance burden percentage. Direct monthly cost =
              team size &times; (salary / 12) &times; (maintenance burden %) &times; velocity
              multiplier. When advanced mode is enabled, incident response cost (incidents &times;
              mean time to resolve &times; hourly rate) is added.
            </p>

            <h4 class="tool-methodology__heading">DORA velocity multiplier</h4>
            <p>
              Deployment frequency serves as a proxy for delivery friction. The multiplier
              (0.8&times;&ndash;2.4&times;) is applied to direct labor cost to reflect the
              productivity overhead associated with slower release cycles. Tiers follow the DORA
              State of DevOps classification: Elite (multiple/day&ndash;daily), High
              (weekly&ndash;biweekly), Medium (3-week&ndash;monthly), Low
              (quarterly&ndash;annually). Source: Forsgren, N., Humble, J., &amp; Kim, G.,{' '}
              <em>Accelerate</em> (2018); DORA State of DevOps Reports (2019&ndash;2023).
            </p>

            <h4 class="tool-methodology__heading">Maintenance burden benchmarks</h4>
            <p>
              Thresholds are calibrated for PE buy-side diligence where growth velocity is the
              priority. Below 10% is well-managed with capacity directed forward. 10&ndash;15% is
              acceptable but belongs on a 100-day remediation plan. 15&ndash;25% is a yellow flag
              that warrants investigation into SDLC maturity, architecture, test coverage, and
              deployment practices. 25&ndash;40% is a red flag signaling strategic liability: expect
              architectural problems, manual processes, and talent risk. Above 40% represents deal
              risk where the platform may require restructuring post-close. These thresholds are
              informed by GST&rsquo;s direct experience across 100+ technology diligence
              engagements.
            </p>

            <h4 class="tool-methodology__heading">Payback analysis</h4>
            <p>
              The break-even period divides the remediation budget by monthly savings (equal to
              total monthly debt cost). This assumes full resolution of identified debt, which is a
              simplification. Real remediation programs typically achieve 50&ndash;80% efficiency.
              The estimate should be treated as a lower bound.
            </p>

            <h4 class="tool-methodology__heading">Limitations</h4>
            <p>
              This model produces order-of-magnitude estimates, not precise valuations. It does not
              account for context-switching overhead, team ramp-up time, partial remediation
              efficiency, revenue impact of incidents, or the war-room effect (larger teams pull
              more responders per incident, which the single-responder model understates). Salary
              inputs are all-in (base + benefits + equity) and should reflect loaded cost. Results
              are most useful for framing diligence conversations and scoping remediation budgets,
              not for formal valuation adjustments.
            </p>

            <h4 class="tool-methodology__heading">Currency</h4>
            <p>
              Non-USD currencies use static mid-market approximations fixed at tool release, March
              2026 (EUR 0.92, GBP 0.79, CAD 1.36, AUD 1.53). For valuation work, apply current
              exchange rates to the USD figure.
            </p>

            <h4 class="tool-methodology__heading">Privacy</h4>
            <p>
              All calculations run entirely in your browser&mdash;no inputs are sent to our servers.
              Anonymous page-view and interaction analytics (Google Analytics 4) help us improve the
              tool. See our <a href="/privacy/">privacy policy</a> for details.
            </p>

            <p class="tool-methodology__updated">Methodology last updated March 2026</p>
          </div>
        </details>

        <!-- ── Footer ──────────────────────────────────────────────── -->
        <div class="calc-footer">
          <div class="calc-footer__controls tool-action-bar">
            <select id="currency-select" class="currency-select" aria-label="Display currency">
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
              <option value="GBP">GBP</option>
              <option value="CAD">CAD</option>
              <option value="AUD">AUD</option>
            </select>
            <span class="currency-disclaimer" id="currency-disclaimer"></span>
            <button
              id="export-pdf-btn"
              type="button"
              class="brutal-btn brutal-btn--secondary copy-link-btn"
              aria-label="Export as PDF via print dialog"
            >
              Export PDF
            </button>
            <button
              id="copy-summary-btn"
              type="button"
              class="brutal-btn brutal-btn--secondary copy-link-btn"
              aria-label="Copy results summary to clipboard"
            >
              Copy Summary
            </button>
            <button
              id="copy-link-btn"
              type="button"
              class="brutal-btn brutal-btn--secondary copy-link-btn"
              aria-label="Copy shareable link to clipboard"
            >
              Copy Link
            </button>
          </div>
        </div>

        <!-- Print-only footer (hidden on screen) -->
        <div class="print-report-footer" aria-hidden="true">
          <p>
            Generated by GST Tech Debt Cost Calculator ·
            globalstrategic.tech/hub/tools/tech-debt-calculator
          </p>
          <p>
            This report provides order-of-magnitude estimates for framing diligence conversations,
            not formal valuation adjustments.
          </p>
        </div>
      </div>

      <a href="/hub/tools/" class="cta-button back-link">
        Return to Tools
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Page wrapper ─────────────────────────────────────────────────────── */
  .tdc-section {
    padding-bottom: var(--spacing-3xl);
  }

  /* ── Calculator shell — base styles provided by global .tool-shell + .tool-shell--wide ── */

  /* ── Authority line ────────────────────────────────────────────────────── */
  .tdc-authority {
    padding: var(--spacing-sm) var(--spacing-2xl);
  }

  /* ── Shared-link range-adjustment notice ───────────────────────────────── */
  .tdc-shared-notice {
    margin: 0 var(--spacing-2xl) var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    border-left: 3px solid var(--color-secondary);
    background: color-mix(in srgb, var(--color-secondary) 8%, transparent);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-primary);
  }

  .tdc-shared-notice[hidden] {
    display: none;
  }

  /* ── Shared section padding ───────────────────────────────────────────── */
  .inputs-section,
  .results-section {
    padding: var(--spacing-xl) var(--spacing-2xl);
  }

  .inputs-section {
    border-bottom: 2px solid light-dark(var(--border-light), var(--border-dark-subtle));
  }

  /* ── Section label overrides (base from global .tool-section-label) ──── */
  .section-label {
    color: var(--text-muted);
  }

  .section-label--spaced {
    margin-top: var(--spacing-xl);
  }

  /* ── Slider layouts ───────────────────────────────────────────────────── */
  .sliders-stack {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .sliders-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg) var(--spacing-2xl);
  }

  /* ── Slider overrides — base styles from shared .brutal-slider in form.css ── */
  .brutal-slider__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brutal-slider__value {
    flex-shrink: 0;
  }

  .brutal-slider__hints {
    display: flex;
