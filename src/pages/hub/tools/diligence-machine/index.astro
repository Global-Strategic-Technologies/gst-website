---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HubHeader from '../../../../components/hub/HubHeader.astro';
import { WIZARD_STEPS } from '../../../../data/diligence-machine/wizard-config';
import DeltaIcon from '../../../../components/DeltaIcon.astro';
import '../../../../styles/components/progress.css';
import { hubToolSchema } from '../../../../utils/hub-tool-schema';
---

<BaseLayout
  title="The Diligence Machine | GST"
  description="Generate a simple technology due diligence agenda customized to your target's profile. 15-20 high-impact questions organized by topic."
  ogTitle="The Diligence Machine | GST"
  ogDescription="Customize a technology diligence checklist by target parameters. Priority-weighted, executive-ready."
  ogImage="/og-image.png"
  ogImageAlt="Diligence Machine - Customizable Technology Due Diligence Checklist"
  ogUrl="https://globalstrategic.tech/hub/tools/diligence-machine/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      hubToolSchema({
        name: 'The Diligence Machine',
        description:
          'Generate a customized technology due diligence agenda with 15-20 high-impact questions organized by topic',
        datePublished: '2025-06-01',
        dateModified: '2026-03-22',
        featureList: [
          '14-dimension conditional matching',
          '15-20 prioritized questions per agenda',
          'Client-side processing — no deal data transmitted',
          'Attention area risk flagging',
          'PDF export and clipboard copy',
        ],
        knowsAbout: [
          'Technical Due Diligence',
          'M&A Tech Strategy',
          'Technology Risk Assessment',
          'PE Portfolio Technology',
          'Software Architecture Evaluation',
        ],
      })
    )}
  />
  <section class="diligence-machine">
    <div class="container">
      <!-- Header -->
      <HubHeader
        title="The Diligence Machine"
        subtitle="Generate a customized, prescriptive technology discovery agenda."
      />

      <p class="brutal-tool-shell__authority dm-authority">
        Question bank built from patterns across 100+ PE technology diligence engagements
      </p>
      <p class="dm-privacy-note">
        Your selections stay in your browser. No deal data is transmitted.
      </p>

      <!-- Wizard Container -->
      <div class="wizard-container" id="wizardContainer" data-testid="wizard-container">
        <!-- Progress Bar -->
        <div
          class="tool-wizard-progress"
          role="progressbar"
          aria-valuemin="1"
          aria-valuemax={WIZARD_STEPS.length}
          aria-valuenow="1"
          aria-label="Wizard progress"
          data-testid="wizard-progress"
        >
          {WIZARD_STEPS.map((step, index) => (
            <div
              class={`tool-wizard-step ${index === 0 ? 'tool-wizard-step--active' : ''}`}
              data-step-indicator={index + 1}
              data-testid={`progress-segment-${index + 1}`}
            >
              <svg
                class="tool-wizard-step__icon"
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M32 12 L52 52 L12 52 Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="4"
                  stroke-linejoin="miter"
                />
                <text
                  x="32"
                  y="40"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  class="tool-wizard-step__number"
                >
                  {index + 1}
                </text>
              </svg>
              <span class="tool-wizard-step__label">{step.navLabel}</span>
            </div>
          ))}
        </div>

        <!-- Mobile Compact Progress -->
        <div class="tool-wizard-progress-mobile" aria-hidden="true">
          <span class="tool-wizard-progress-mobile__label">
            Step <span class="tool-wizard-progress-mobile__current">1</span> of{' '}
            {WIZARD_STEPS.length} —{' '}
            <span class="tool-wizard-progress-mobile__name">{WIZARD_STEPS[0].navLabel}</span>
          </span>
          <div class="tool-wizard-progress-mobile__dots">
            {WIZARD_STEPS.map((_, index) => (
              <button
                class={`tool-wizard-dot ${index === 0 ? 'tool-wizard-dot--active' : ''}`}
                data-dot-step={index + 1}
                aria-label={`Go to step ${index + 1}`}
              >
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M32 12 L52 52 L12 52 Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="6"
                    stroke-linejoin="miter"
                  />
                </svg>
              </button>
            ))}
          </div>
        </div>

        <!-- Steps -->
        <div>
          {WIZARD_STEPS.map((step, index) => (
            <div
              class={`wizard-step ${index === 0 ? 'active' : ''}`}
              data-step={index + 1}
              data-step-id={step.id}
              data-input-type={step.inputType}
              data-testid={`wizard-step-${index + 1}`}
            >
              <h2 class="step-title">{step.title}</h2>
              <p class="step-subtitle">{step.subtitle}</p>
              {step.id === 'tech-archetype' && (
                <p class="step-note">
                  Benchmark infrastructure costs against peers with{' '}
                  <a href="/hub/tools/techpar/" target="_blank" rel="noopener">
                    TechPar
                  </a>
                  .
                </p>
              )}
              {step.id === 'scale-intensity' && (
                <p class="step-note">
                  Evaluate cloud cost governance practices with the{' '}
                  <a
                    href="/hub/tools/infrastructure-cost-governance/"
                    target="_blank"
                    rel="noopener"
                  >
                    Infrastructure Cost Governance
                  </a>{' '}
                  tool.
                </p>
              )}
              {step.id === 'transformation-state' && (
                <p class="step-note">
                  Estimate technical debt remediation costs with the{' '}
                  <a href="/hub/tools/tech-debt-calculator/" target="_blank" rel="noopener">
                    Tech Debt Calculator
                  </a>
                  .
                </p>
              )}
              {step.id === 'data-sensitivity' && (
                <p class="step-note">
                  Explore jurisdiction-specific requirements in the{' '}
                  <a href="/hub/tools/regulatory-map/" target="_blank" rel="noopener">
                    Regulatory Map
                  </a>
                  .
                </p>
              )}

              {step.inputType === 'single-select' && step.options && (
                <div class="options-grid">
                  {step.options.map((option) => (
                    <button
                      class="brutal-option-card"
                      data-option-id={option.id}
                      data-step-id={step.id}
                      data-testid={`option-${step.id}-${option.id}`}
                      type="button"
                      aria-pressed="false"
                    >
                      <span class="brutal-option-card__label">
                        <DeltaIcon class="bullet-icon" />
                        {option.label}
                      </span>
                      {option.description && (
                        <span class="brutal-option-card__description">{option.description}</span>
                      )}
                    </button>
                  ))}
                  {/* BL-031.95 Phase 2.C: "Not sure" affordance — sets the
                        dimension to the 'unknown' sentinel; engine widens
                        triggers conservatively. Routes through the existing
                        handleOptionClick because the schema accepts 'unknown'
                        as a valid value (see UNKNOWN_INPUT in
                        src/schemas/diligence.ts). */}
                  <button
                    class="brutal-option-card brutal-option-card--unsure"
                    data-option-id="unknown"
                    data-step-id={step.id}
                    data-testid={`option-${step.id}-unknown`}
                    type="button"
                    aria-pressed="false"
                  >
                    <span class="brutal-option-card__label">
                      <DeltaIcon class="bullet-icon" />
                      Not sure
                    </span>
                  </button>
                </div>
              )}

              {step.inputType === 'multi-select' && step.options && (
                <div class="options-grid">
                  {step.options.map((option) => (
                    <button
                      class="brutal-option-card"
                      data-option-id={option.id}
                      data-step-id={step.id}
                      data-testid={`option-${step.id}-${option.id}`}
                      type="button"
                      aria-pressed="false"
                    >
                      <span class="brutal-option-card__label">
                        <DeltaIcon class="bullet-icon" />
                        {option.label}
                      </span>
                      {option.description && (
                        <span class="brutal-option-card__description">{option.description}</span>
                      )}
                    </button>
                  ))}
                  {/* BL-031.95 Phase 2.C: "Not sure" affordance for the
                        multi-select geography step. Click sets
                        inputs.geographies = ['unknown'] and clears all other
                        selections; clicking any specific region after
                        clears the 'unknown' state. Special case handled in
                        handleOptionClick. */}
                  <button
                    class="brutal-option-card brutal-option-card--unsure"
                    data-option-id="unknown"
                    data-step-id={step.id}
                    data-testid={`option-${step.id}-unknown`}
                    type="button"
                    aria-pressed="false"
                  >
                    <span class="brutal-option-card__label">
                      <DeltaIcon class="bullet-icon" />
                      Not sure
                    </span>
                  </button>
                </div>
              )}

              {step.inputType === 'compound' && step.fields && (
                <div class="compound-fields-grid">
                  {step.fields.map((field) => (
                    <div class="compound-field-section">
                      <h3 class="field-section-label">{field.label}</h3>
                      <div class="field-options-grid" data-field-id={field.id}>
                        {field.options.map((opt) => (
                          <button
                            class="brutal-option-card compound-option"
                            data-option-id={opt.id}
                            data-field-id={field.id}
                            data-step-id={step.id}
                            data-testid={`compound-${field.id}-${opt.id}`}
                            type="button"
                            aria-pressed="false"
                          >
                            <span class="brutal-option-card__label">
                              <DeltaIcon size={10} class="brutal-option-card__icon" />
                              {opt.label}
                            </span>
                          </button>
                        ))}
                        {/* BL-031.95 Phase 2.C: "Not sure" per compound
                              field. Each of the 4 compound fields
                              (headcount/revenueRange/growthStage/companyAge)
                              gets its own affordance — routes through
                              handleCompoundOptionClick because the schema
                              accepts 'unknown' on every dimension. */}
                        <button
                          class="brutal-option-card compound-option brutal-option-card--unsure"
                          data-option-id="unknown"
                          data-field-id={field.id}
                          data-step-id={step.id}
                          data-testid={`compound-${field.id}-unknown`}
                          type="button"
                          aria-pressed="false"
                        >
                          <span class="brutal-option-card__label">
                            <DeltaIcon size={10} class="brutal-option-card__icon" />
                            Not sure
                          </span>
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Navigation -->
        <div class="wizard-nav">
          <button
            class="brutal-btn brutal-btn--secondary"
            id="btnBack"
            data-testid="btn-back"
            type="button"
            disabled
          >
            Back
          </button>
          <button
            class="brutal-btn brutal-btn--primary"
            id="btnNext"
            data-testid="btn-next"
            type="button"
            disabled
          >
            Next
          </button>
          <button
            class="brutal-btn brutal-btn--primary"
            id="btnGenerate"
            data-testid="btn-generate"
            type="button"
            style="display:none;"
          >
            Generate Agenda
          </button>
        </div>
      </div>
      <!-- Output Container -->
      <div
        class="output-container brutal-tool-shell--document"
        id="outputContainer"
        data-testid="output-container"
        style="display:none;"
      >
        <!-- Floating Action Bar -->
        <div
          class="doc-action-bar tool-action-bar tool-action-bar--end tool-action-bar--frosted"
          id="docActionBar"
          data-testid="doc-action-bar"
        >
          <button
            class="brutal-btn brutal-btn--secondary doc-action-btn"
            id="btnGoBack"
            data-testid="btn-go-back"
            type="button"
            aria-label="Go back to wizard"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M10 3L5 8l5 5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            Back
          </button>
          <button
            class="brutal-btn brutal-btn--secondary doc-action-btn"
            id="btnCopy"
            data-testid="btn-copy"
            type="button"
            aria-label="Copy to clipboard"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect
                x="5"
                y="5"
                width="9"
                height="9"
                rx="1.5"
                stroke="currentColor"
                stroke-width="1.5"
              ></rect>
              <path
                d="M3 11V3a1.5 1.5 0 011.5-1.5H11"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
            </svg>
            <span id="btnCopyLabel">Copy</span>
          </button>
          <button
            class="brutal-btn brutal-btn--secondary doc-action-btn"
            id="btnPrint"
            data-testid="btn-print"
            type="button"
            aria-label="Export as PDF via print dialog"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M4 6V1h8v5M4 12H2V7h12v5h-2"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              ></path>
              <rect
                x="4"
                y="10"
                width="8"
                height="4"
                rx="0.5"
                stroke="currentColor"
                stroke-width="1.5"
              ></rect>
            </svg>
            Export PDF
          </button>
          <button
            class="brutal-btn brutal-btn--secondary doc-action-btn"
            id="btnRestart"
            data-testid="btn-restart"
            type="button"
            aria-label="Start over"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M2.5 2.5v4h4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
              <path
                d="M2.5 6.5A5.5 5.5 0 1 1 3 10"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
            </svg>
            Restart
          </button>
        </div>

        <!-- The Document -->
        <div class="doc-page" id="docPage" data-testid="doc-page">
          <!-- Document Header -->
          <header class="doc-header" data-testid="doc-header">
            <div class="doc-brand">
              <DeltaIcon size={20} class="doc-brand-icon" />
              <span class="doc-brand-name">GST</span>
            </div>
            <h1 class="doc-title">Overview and Agenda</h1>
            <p class="doc-generation-date" id="docDate"></p>
          </header>

          <hr class="doc-divider doc-divider--heavy" />

          <!-- Metadata Block -->
          <section
            class="doc-meta"
            id="docMeta"
            data-testid="doc-meta"
            aria-label="Input parameters"
          ></section>

          <hr class="doc-divider" />

          <!-- Table of Contents -->
          <section
            class="doc-toc"
            id="docToc"
            data-testid="doc-toc"
            aria-label="Table of contents"
          ></section>

          <hr class="doc-divider doc-divider--post-toc" />

          <!-- Attention Areas -->
          <section
            class="doc-attention-anchors"
            id="attentionAreasSection"
            data-testid="attention-areas-section"
            style="display:none;"
            aria-label="Attention areas"
          >
            <h2 class="doc-section-heading">
              <DeltaIcon class="bullet-icon" />
              Attention Areas
            </h2>
            <p class="doc-section-subtitle">
              Critical risk factors and complexity areas requiring focused investigation during
              diligence
            </p>
            <div class="doc-attention-grid" id="attentionAreasGrid"></div>
          </section>

          <!-- Topic Sections -->
          <div class="doc-topics" id="scriptTopics" data-testid="doc-topics"></div>

          <!-- Document Footer -->
          <footer class="doc-footer">
            <hr class="doc-divider" />
            <div class="doc-footer-brand">
              <DeltaIcon class="bullet-icon" />
              <span>https://globalstrategic.tech</span>
            </div>
            <p class="doc-footer-disclaimer">
              These perspectives are presented from recurrent technology patterns. Extend, revise
              and replace these with others gathered during your discovery process.
            </p>
          </footer>
        </div>
      </div>

      <details class="tool-methodology tool-methodology--delta">
        <summary class="tool-methodology__trigger">How the Diligence Machine works</summary>
        <div class="tool-methodology__body">
          <h4 class="tool-methodology__heading">Question bank</h4>
          <p>
            The engine draws from a bank of 68 due diligence questions organized into four topics:
            Architecture &amp; Scalability, Operations &amp; Delivery, Carve-out / Integration, and
            Security, Compliance &amp; Governance. Each question carries a priority level (high,
            medium, or standard), a rationale explaining why it matters, and conditional triggers
            that determine when it appears.
          </p>

          <h4 class="tool-methodology__heading">Conditional matching</h4>
          <p>
            Questions are filtered against your inputs using AND logic across 14 dimensions:
            transaction type, product type, tech stack archetype, headcount, revenue range, growth
            stage, company age, geography, business model, scale intensity, transformation state,
            data sensitivity, and operating model. A condition left undefined acts as a wildcard
            (matches everything). Ordinal fields&mdash;headcount, revenue, and company age&mdash;use
            &ldquo;at least&rdquo; comparison so that a threshold set at &ldquo;51&ndash;200
            employees&rdquo; also matches larger brackets.
          </p>

          <h4 class="tool-methodology__heading">Balancing algorithm</h4>
          <p>
            After filtering, the engine balances questions across topics. It reserves a minimum of
            three questions per topic (where available), then fills remaining slots by priority
            until the total reaches 15&ndash;20. This ensures every topic is represented while
            surfacing the highest-priority items first.
          </p>

          <h4 class="tool-methodology__heading">Attention areas</h4>
          <p>
            29 attention areas surface structural risk factors&mdash;such as hardware end-of-life
            exposure, key-person dependencies, or manual operations masking&mdash;triggered by
            specific input combinations. They are sorted by relevance (high, medium, low) and
            displayed before the question agenda.
          </p>

          <h4 class="tool-methodology__heading">Archetype pivot</h4>
          <p>
            When the target operates on-premise or self-managed infrastructure, questions that are
            exclusively relevant to cloud-native architectures are filtered out. Mixed-archetype
            questions are preserved.
          </p>

          <h4 class="tool-methodology__heading">Limitations</h4>
          <p>
            The generated agenda is a starting point, not a complete diligence program. Questions
            reflect common technology patterns and should be extended, revised, or replaced based on
            target-specific discovery. The tool does not assess financial, legal, or commercial
            diligence dimensions.
          </p>

          <h4 class="tool-methodology__heading">Privacy</h4>
          <p>
            All processing runs entirely in your browser&mdash;no deal data is transmitted to or
            stored on our servers. Anonymous page-view and interaction analytics (Google Analytics
            4) help us improve the tool. See our <a href="/privacy/">privacy policy</a> for details.
          </p>

          <p class="tool-methodology__updated">Methodology last updated March 2026</p>

          <div class="tool-methodology__author">
            <span class="tool-methodology__author-name">Reid Peryam</span>
            <span class="tool-methodology__author-sep">&middot;</span>
            <span>Strategic Technology Advisor</span>
            <span class="tool-methodology__author-sep">&middot;</span>
            <span>100+ PE technology diligence engagements</span>
            <span class="tool-methodology__author-sep">&middot;</span>
            <a
              href="https://www.linkedin.com/in/reidperyam/"
              target="_blank"
              rel="noopener noreferrer"
              class="tool-methodology__author-link"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </details>

      <a href="/hub/tools/" class="brutal-btn brutal-btn--secondary back-link" id="backToTools">
        <DeltaIcon class="bullet-icon" />
        Back to Tools
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../../../scripts/diligence-machine';
</script>

<style>
  /* ─── LAYOUT ───────────────────────────────────────────────────────── */

  /* No top padding: `HubHeader` already contributes 3xl above the title, and a
     second helping here started this page's title 40px lower than the other
     hub tools'. */
  .diligence-machine {
    padding: 0 0 var(--spacing-3xl);
    min-height: 80vh;
  }

  /* ─── AUTHORITY LINE ───────────────────────────────────────────────── */

  .dm-authority {
    padding: var(--spacing-sm) var(--spacing-lg);
  }

  .dm-privacy-note {
    padding: var(--spacing-xs) var(--spacing-lg);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
  }

  /* ─── WIZARD STEPS ─────────────────────────────────────────────────── */

  .wizard-step {
    display: none;
    max-width: 390px;
    margin: 0 auto;
  }

  .wizard-step.active {
    display: block;
  }

  .step-title {
    font-family: var(--font-family-mono);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    text-align: center;
    margin: 0 0 var(--spacing-sm) 0;
  }

  .step-subtitle {
    font-size: var(--text-base);
    color: var(--text-secondary);
    text-align: center;
    margin: 0 0 var(--spacing-2xl) 0;
    line-height: 1.6;
  }

  .step-note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-align: center;
    margin: calc(-1 * var(--spacing-xl)) 0 var(--spacing-2xl) 0;
    line-height: 1.6;
    font-style: italic;
  }

  /* ─── OPTION CARDS ─────────────────────────────────────────────────── */

  .options-grid {
    display: grid;
    gap: var(--spacing-md);
  }

  /* Single-column steps: constrain width to reduce whitespace */
  [data-step-id='transaction-type'] .options-grid,
  [data-step-id='product-type'] .options-grid,
  [data-step-id='tech-archetype'] .options-grid,
  [data-step-id='business-model'] .options-grid,
  [data-step-id='scale-intensity'] .options-grid,
  [data-step-id='transformation-state'] .options-grid,
  [data-step-id='data-sensitivity'] .options-grid,
  [data-step-id='operating-model'] .options-grid {
    max-width: 50%;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    [data-step-id='transaction-type'] .options-grid,
    [data-step-id='product-type'] .options-grid,
    [data-step-id='tech-archetype'] .options-grid,
    [data-step-id='business-model'] .options-grid,
    [data-step-id='scale-intensity'] .options-grid,
    [data-step-id='transformation-state'] .options-grid,
    [data-step-id='data-sensitivity'] .options-grid,
    [data-step-id='operating-model'] .options-grid {
      max-width: 100%;
    }
  }

  /* Geography step: two-column layout for efficient whitespace usage */
  [data-step-id='geography'] .options-grid {
    grid-template-columns: 1fr; /* Mobile: single column */
    max-width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 480px) {
    [data-step-id='geography'] .options-grid {
      grid-template-columns: repeat(2, 1fr); /* Two columns on tablets and up */
      max-width: 560px; /* ~80% of 700px step width */
      column-gap: var(--spacing-lg);
    }
  }

  @media (min-width: 768px) {
    [data-step-id='geography'] .options-grid {
      max-width: 580px; /* ~83% of 700px step width */
    }
  }

  @media (min-width: 1024px) {
    [data-step-id='geography'] .options-grid {
      max-width: 640px; /* ~80% of 800px desktop width */
    }
  }

  /* ─── COMPOUND FIELD SECTIONS ────────────────────────────────────────── */

  .compound-fields-grid {
    display: grid;
    gap: var(--spacing-3xl);
  }

  .compound-field-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .field-section-label {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid light-dark(var(--border-dark), var(--color-primary-30));
  }

  .field-options-grid {
    display: grid;
    gap: var(--spacing-md);
    grid-template-columns: 1fr; /* Mobile-first: 1 column */
  }

  .compound-option {
    min-height: 52px; /* Ensure WCAG touch target */
    justify-content: center;
  }

  /* ─── NAVIGATION ───────────────────────────────────────────────────── */

  .wizard-nav {
    display: flex;
    justify-content: center;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-3xl);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── DOCUMENT ACTION BAR ──────────────────────────────────────────── */

  .doc-action-bar {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-lg);
    border-bottom: 2px solid light-dark(var(--border-light), var(--border-dark-default));
  }

  /* Button overrides (layout only — base styles from global .brutal-btn) */
  .doc-action-btn {
    padding: var(--spacing-sm) var(--spacing-lg);
    font-family: var(--font-family-mono);
  }

  /* Use attribute selector instead of #id to keep specificity low (camelCase
     * id rename requires coordinated HTML + JS update; logged to Phase 9 backlog). */
  [id='btnGoBack'] {
    margin-right: auto;
  }

  .doc-action-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* ─── DOCUMENT PAGE ────────────────────────────────────────────────── */

  .output-container {
    /* max-width: 800px now provided by global .brutal-tool-shell--document */
    margin: 0 auto;
  }

  .doc-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--surface-faint-bg);
    backdrop-filter: blur(3px);
    border: 2px solid light-dark(var(--border-light), var(--border-dark-default));
    padding: var(--spacing-xl);
  }

  .doc-page,
  .doc-page * {
    user-select: text;
  }

  /* ─── DOCUMENT HEADER ──────────────────────────────────────────────── */

  .doc-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .doc-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .doc-brand :global(.doc-brand-icon) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .doc-brand-name {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }

  .doc-title {
    font-family: var(--font-family-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--spacing-xs) 0;
  }

  .doc-generation-date {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
    margin-top: var(--spacing-xs);
  }

  /* ─── DIVIDERS ─────────────────────────────────────────────────────── */

  .doc-divider {
    border: none;
    border-top: 1px solid light-dark(var(--border-light), var(--border-dark));
    margin: var(--spacing-xl) 0;
  }

  .doc-divider--heavy {
    border-top-width: 3px;
    border-top-color: var(--color-primary);
  }

  .doc-divider--post-toc {
    display: block;
  }

  .doc-footer .doc-divider {
    margin: 0 0 var(--spacing-xs) 0;
  }

  /* ─── SECTION HEADINGS ─────────────────────────────────────────────── */

  .doc-page :global(.doc-section-heading) {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary-ink);
    margin: 0 0 var(--spacing-lg) 0;
  }

  .doc-page :global(.doc-section-subtitle) {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: calc(var(--spacing-sm) * -1) 0 var(--spacing-md) 0;
    padding-left: var(--spacing-xl);
    font-style: italic;
  }

  /* ─── METADATA BLOCK ───────────────────────────────────────────────── */

  .doc-meta :global(.doc-meta-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-sm);
    margin: 0;
    padding-left: var(--spacing-xl);
  }

  .doc-meta :global(.doc-meta-card) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) 0;
  }

  .doc-meta :global(.doc-meta-label) {
    font-family: var(--font-family-mono);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    opacity: 0.7;
  }

  .doc-meta :global(.doc-meta-label--clickable) {
    cursor: pointer;
    transition:
      opacity var(--transition-fast),
      color var(--transition-fast);
  }

  .doc-meta :global(.doc-meta-label--clickable:hover) {
    opacity: 1;
    color: var(--color-primary);
    text-decoration: underline;
  }

  .doc-meta :global(.doc-meta-value) {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    line-height: 1.3;
  }

  /* Column alignment for 3-column grid */
  .doc-meta :global(.doc-meta-card--col2) {
    align-items: center;
    text-align: center;
  }

  .doc-meta :global(.doc-meta-card--col3) {
    align-items: flex-end;
    text-align: right;
  }

  .doc-meta :global(.doc-meta-card--identifier) {
    grid-column: span 1;
  }

  .doc-meta :global(.doc-meta-identifier-input) {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    line-height: 1.3;
    background: transparent;
    border: 1px solid transparent;
    border-bottom: 1px dashed light-dark(var(--color-primary-30), var(--border-dark));
    padding: 2px 0;
    width: 75%;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .doc-meta :global(.doc-meta-identifier-input:focus) {
    border-bottom-color: var(--color-primary);
  }

  .doc-meta :global(.doc-meta-identifier-input::placeholder) {
    color: var(--text-muted);
    font-weight: var(--font-weight-normal);
  }

  .doc-meta :global(.doc-meta-actions) {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
  }

  .doc-meta :global(.doc-meta-cta-button) {
    font-size: var(--text-size-compact);
    padding: var(--spacing-sm) var(--spacing-lg);
    text-align: center;
    line-height: 1.3;
    white-space: nowrap;
    border-radius: 0;
  }

  /* ─── TABLE OF CONTENTS ────────────────────────────────────────────── */

  .doc-toc :global(.doc-toc-list) {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 0;
    margin: 0 0 var(--spacing-lg) 0;
  }

  .doc-toc :global(.doc-toc-link) {
    display: flex;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-md);
    text-decoration: none;
    color: var(--text-primary);
    font-family: var(--font-family-mono);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
    border-left: 2px solid var(--color-primary);
    border-bottom: none;
    padding-bottom: var(--spacing-xs);
    outline: none;
  }

  .doc-toc :global(.doc-toc-link:first-child) {
    border-left: none;
  }

  .doc-toc :global(.doc-toc-link:hover) {
    color: var(--color-primary);
    border-bottom: none;
  }

  .doc-toc :global(.doc-toc-link:focus-visible) {
    color: var(--color-primary);
    background-color: light-dark(var(--accent-light-bg), var(--accent-light-bg-hover));
  }

  .doc-toc :global(.doc-toc-link:active) {
    color: var(--color-primary);
    background-color: light-dark(var(--accent-light-bg-hover), var(--border-dark));
  }

  .doc-toc :global(.doc-toc-topic-name) {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ─── ATTENTION AREAS ──────────────────────────────────────────────── */

  .doc-attention-anchors {
    margin-bottom: 0;
  }

  .doc-attention-grid {
    display: grid;
    gap: var(--spacing-md);
    padding-left: 0;
  }

  .doc-attention-grid :global(.doc-attention-card) {
    padding: calc(var(--spacing-xl) * 0.5) var(--spacing-xl);
    border-left: 3px solid var(--color-primary);
    background: var(--accent-wash-bg);
    border-radius: 0;
    min-width: 0;
    overflow: hidden;
  }

  .doc-attention-grid :global(.doc-attention-card.is-collapsed) {
    padding: var(--spacing-sm) var(--spacing-xl);
  }

  .doc-attention-grid :global(.doc-attention-card.relevance-high) {
    border-left-color: var(--color-authority);
    background: var(--color-authority-bg);
  }

  .doc-attention-grid :global(.doc-attention-card.relevance-medium) {
    border-left-color: var(--color-subdued);
    background: var(--color-subdued-bg);
  }

  .doc-attention-grid :global(.doc-attention-header) {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .doc-attention-grid :global(.doc-attention-title) {
    font-family: var(--font-family-mono);
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    line-height: 1.4;
    min-width: 0;
    margin: 0;
  }

  .doc-attention-grid :global(.doc-attention-divider) {
    width: 2rem;
    height: 2px;
    border: none;
    opacity: 0.4;
    margin: var(--spacing-md) 0;
  }

  .doc-attention-grid :global(.doc-attention-card .doc-attention-divider) {
    background: var(--color-primary);
  }

  .doc-attention-grid :global(.relevance-high .doc-attention-divider) {
    background: var(--color-authority);
  }

  .doc-attention-grid :global(.relevance-medium .doc-attention-divider) {
    background: var(--color-subdued);
  }

  .doc-attention-grid :global(.doc-attention-desc) {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ─── COLLAPSE / DISMISS CONTROLS ────────────────────────────────── */

  :global([data-card-toggle]) {
    cursor: pointer;
  }

  :global(.doc-attention-card.is-dismissed),
  :global(.doc-question.is-dismissed) {
    opacity: 0.45;
    border-style: dashed;
  }

  :global(.is-dismissed .brutal-na-btn) {
    border-style: solid;
  }

  /* Attention card collapse */

  .doc-attention-grid :global(.is-collapsed .doc-attention-divider) {
    max-height: 0;
    opacity: 0;
    margin: 0;
  }

  .doc-attention-grid :global(.is-collapsed .doc-attention-desc) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: var(--spacing-xs) 0 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Question card collapse */
  :global(.dm-card-body) {
    transition:
      max-height var(--transition-normal),
      opacity var(--transition-normal);
    max-height: 1000px;
    overflow: hidden;
    opacity: 1;
  }

  :global(.is-collapsed .dm-card-body) {
    max-height: 0;
    opacity: 0;
    margin: 0;
  }

  /* Truncate question text to one line when collapsed */
  :global(.doc-question.is-collapsed .doc-q-text) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0;
    font-weight: var(--font-weight-normal);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ─── TOPIC SECTIONS ───────────────────────────────────────────────── */

  /* All topic/question elements are dynamically injected via innerHTML,
       so they need :global() wrappers anchored on the static .doc-topics parent */

  .doc-topics :global(.doc-topic) {
    margin-top: var(--spacing-3xl);
  }

  .doc-topics :global(.doc-topic-header) {
    padding-bottom: var(--spacing-lg);
    border-bottom: 2px solid var(--color-primary);
    margin-bottom: var(--spacing-xl);
  }

  .doc-topics :global(.doc-topic-label-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-xs);
  }

  .doc-topics :global(.doc-topic-number) {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }

  .doc-topics :global(.doc-topic-title) {
    font-family: var(--font-family-mono);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-secondary-ink);
    margin: 0 0 var(--spacing-xs) 0;
  }

  .doc-topics :global(.doc-section-subtitle) {
    margin: 0 0 var(--spacing-sm) 0;
    padding-left: 0;
  }

  .doc-topics :global(.doc-topic-audience) {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
  }

  /* ─── QUESTIONS ────────────────────────────────────────────────────── */

  .doc-topics :global(.doc-questions) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--spacing-md);
  }

  .doc-topics :global(.doc-question) {
    padding: var(--spacing-lg);
    border: 1px solid light-dark(var(--border-light), var(--border-dark));
    border-radius: 0;
    border-left: 3px solid light-dark(var(--border-light), var(--border-dark));
    min-width: 0;
    overflow: hidden;
  }

  .doc-topics :global(.doc-question.is-collapsed) {
    padding: var(--spacing-sm) var(--spacing-lg);
  }

  .doc-topics :global(.doc-question.priority-high) {
    border-left-color: var(--color-authority);
  }

  .doc-topics :global(.doc-question.priority-medium) {
    border-left-color: var(--color-subdued);
  }

  .doc-topics :global(.doc-question.priority-standard) {
    border-left-color: var(--color-primary);
  }

  .doc-topics :global(.doc-q-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-sm);
  }

  .doc-topics :global(.doc-q-number) {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    margin-right: var(--spacing-sm);
  }

  .doc-topics :global(.doc-q-priority) {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1px var(--spacing-sm);
    border-radius: 0;
  }

  .doc-topics :global(.priority-high .doc-q-priority) {
    background: var(--color-authority-bg);
    color: var(--color-authority-ink);
  }

  .doc-topics :global(.priority-medium .doc-q-priority) {
    background: var(--color-subdued-bg);
    color: var(--color-subdued-ink);
  }

  .doc-topics :global(.priority-standard .doc-q-priority) {
    background: var(--accent-light-bg-hover);
    color: var(--color-primary);
  }

  .doc-topics :global(.doc-q-text) {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0 0 var(--spacing-sm) 0;
  }

  .doc-topics :global(.doc-q-rationale) {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
    font-style: italic;
    margin: 0;
  }

  .doc-topics :global(.doc-q-triggers) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-sm);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .doc-topics :global(.doc-q-trigger-tag) {
    display: inline-block;
    padding: 1px var(--spacing-xs);
    font-family: var(--font-family-mono);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
    border-radius: 0;
  }

  /* ─── V2: EXIT IMPACT BADGES ──────────────────────────────────────── */

  .doc-topics :global(.doc-q-badges) {
    display: flex;
    gap: var(--spacing-xs);
    align-items: center;
  }

  .doc-topics :global(.doc-q-exit-impact) {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1px var(--spacing-sm);
    border-radius: 0;
  }

  .doc-topics :global(.exit-impact-multiple-expander) {
    background: color-mix(in srgb, var(--color-success) 12%, transparent);
    color: var(--color-success-ink);
  }

  .doc-topics :global(.exit-impact-valuation-drag) {
    background: color-mix(in srgb, var(--color-warning) 12%, transparent);
    color: var(--color-warning-ink);
  }

  .doc-topics :global(.exit-impact-operational-risk) {
    background: color-mix(in srgb, var(--color-error) 12%, transparent);
    color: var(--color-error-ink);
  }

  .doc-topics :global(.doc-q-red-flag) {
    font-size: var(--text-sm);
    color: var(--color-error-ink);
    line-height: 1.6;
    margin: 0 0 var(--spacing-sm) 0;
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--dm-negative-dark-bg);
    border-left: 2px solid color-mix(in srgb, var(--color-error) 30%, transparent);
    border-radius: 0;
  }

  /* ─── DOCUMENT FOOTER ──────────────────────────────────────────────── */

  .doc-footer {
    margin-top: var(--spacing-md);
    padding-top: 0;
    opacity: 0.5;
  }

  .doc-footer-brand {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-xs);
    font-family: var(--font-family-mono);
    font-size: var(--text-3xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  .doc-footer-brand img {
    width: 10px;
    height: 10px;
  }

  .doc-footer-disclaimer {
    font-family: var(--font-family-mono);
    font-size: var(--text-3xs);
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
    text-transform: none;
  }

  /* DM methodology — scoped overrides on shared .tool-methodology */
  .diligence-machine :global(.tool-methodology) {
    max-width: 800px;
    margin: var(--spacing-2xl) auto 0;
  }

  .diligence-machine :global(.tool-methodology__trigger) {
    justify-content: center;
    padding-left: var(--spacing-lg);
    padding-right: var(--spacing-lg);
  }

  /* ─── BACK LINK ────────────────────────────────────────────────────── */

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-3xl);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  /* ─── RESPONSIVE ───────────────────────────────────────────────────── */

  @media (min-width: 768px) {
    .diligence-machine {
      padding: 0 0 var(--spacing-2_5xl);
    }

    /* Expand wizard step width on tablet+ for better multi-column layout */
    .wizard-step {
      max-width: 700px;
    }

    /* Headcount (4 options): 2 columns in 2x2 grid */
    .field-options-grid[data-field-id='headcount'] {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Revenue Range (4 options): 2 columns in 2x2 grid */
    .field-options-grid[data-field-id='revenue-range'] {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Growth Stage (3 options): 3 columns in single row */
    .field-options-grid[data-field-id='growth-stage'] {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Company Age (5 options): 3 columns (2-2-1 layout) */
    .field-options-grid[data-field-id='company-age'] {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    /* Desktop: even wider for optimal spacing */
    .wizard-step {
      max-width: 800px;
    }

    /* Headcount (4 options): 4 columns in single row */
    .field-options-grid[data-field-id='headcount'] {
      grid-template-columns: repeat(4, 1fr);
    }

    /* Revenue Range (4 options): 4 columns in single row */
    .field-options-grid[data-field-id='revenue-range'] {
