---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HubHeader from '../../../components/hub/HubHeader.astro';
import DeltaIcon from '../../../components/DeltaIcon.astro';

// Published facts on this page are pinned by
// `tests/integration/mcp-marketing-parity.test.ts`, which reads this file's
// MARKUP region against mcp-server source. Tier ceilings and tool names are
// written as literal markup on purpose — a value interpolated from frontmatter
// would leave the guard with nothing to compare.

const ACCESS_EMAIL = 'contact@globalstrategic.tech';
const ACCESS_BODY = [
  'Name:',
  'Firm:',
  'Intended use case:',
  'Tools of interest:',
  'Expected monthly volume:',
  '',
].join('\n');

/** Prefilled operator-inbox intake — see PILOT_ONBOARDING.md § 0. */
function accessHref(tier?: string) {
  const subject = tier
    ? `GST MCP Server access request (${tier})`
    : 'GST MCP Server access request';
  return `mailto:${ACCESS_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(ACCESS_BODY)}`;
}
---

<BaseLayout
  title="MCP Server | GST"
  description="Connect your AI agents to GST's diligence engine, portfolio record, and regulatory map over the Model Context Protocol. Operator-provisioned access for deal teams."
  ogTitle="GST MCP Server | Diligence Tools for Your Agents"
  ogDescription="Sixteen diligence, portfolio, and regulatory tools exposed over the Model Context Protocol, with operator-provisioned access and per-client capability tiers."
  ogImage="/og-image.png"
  ogImageAlt="GST MCP Server - Model Context Protocol access to GST diligence tooling"
  ogUrl="https://globalstrategic.tech/hub/mcp/"
>
  <section class="mcp-section">
    <div class="container">
      <HubHeader title="GST MCP Server">
        <Fragment slot="subtitle"
          >Use <a
            href="/hub/tools/"
            target="_blank"
            rel="noopener"
            class="mcp-lede-link"
            onclick="trackCTA('mcp-lede-hub-tools', 'hub-mcp')"
            >GST's advisory tools<span class="sr-only"> (opens in new window)</span></a
          > with your AI agents. Supercharge your analysis to accelerate and lower costs of decision-making.</Fragment
        >
      </HubHeader>

      <div class="mcp-block" id="what-it-does">
        <h2 class="brutal-heading-lg">What it does</h2>
        <p class="mcp-lede">
          Your analysts already screen targets, portfolio companies and deals with AI agents;
          connect those AI agents to GST's MCP server to accelerate assessment, benchmarking, and
          project administration.
        </p>

        <div class="mcp-usecases">
          <article class="brutal-trust-card">
            <h3>Deal Screening</h3>
            <p>
              During initial screening, an analyst's agent calls the diligence agenda tool with the
              target's profile and returns a starter agenda the IC memo is built around, recovering
              2 to 4 hours per screened deal.
            </p>
          </article>
          <article class="brutal-trust-card">
            <h3>Cost Benchmarking</h3>
            <p>
              A portfolio operating partner benchmarks total technology spend against stage-adjusted
              ranges and prices the carrying cost of technical debt, turning "engineering feels
              slow" into a number the board can act on.
            </p>
          </article>
          <article class="brutal-trust-card">
            <h3>Regulatory Exposure</h3>
            <p>
              Before bidding on a healthtech target, an agent scopes which frameworks are in play by
              jurisdiction and effective date, so counsel starts from an exposure list instead of an
              open question.
            </p>
          </article>
          <article class="brutal-trust-card">
            <h3>Programmatic Access</h3>
            <p>
              A client's internal tooling (Retool, a Slack bot, a custom dashboard) calls the server
              directly, treating GST's frameworks as a managed API rather than a site somebody has
              to visit.
            </p>
          </article>
        </div>
      </div>

      <div class="mcp-block">
        <h2 class="brutal-heading-lg">What's exposed</h2>
        <p class="mcp-note">
          The server implements all three MCP server primitives: Tools, Resources, and Prompts.
          Together they give an agent what a good analyst needs on day one: instruments to run the
          numbers, the reference material to run them against, and a method for what order to do it
          in.
        </p>

        {
          /* The counts a reader compares, on the section that explains what they
          are counts OF. This is the only place the three totals appear together,
          so `mcp-marketing-parity.test.ts` reads them here. */
        }
        <div class="mcp-primitive-summary">
          <div class="brutal-stat-tile">
            <div class="brutal-stat-tile__value">16</div>
            <div class="brutal-stat-tile__label">Tools</div>
          </div>
          <div class="brutal-stat-tile">
            <div class="brutal-stat-tile__value">133</div>
            <div class="brutal-stat-tile__label">Resources</div>
          </div>
          <div class="brutal-stat-tile">
            <div class="brutal-stat-tile__value">12</div>
            <div class="brutal-stat-tile__label">Prompts</div>
          </div>
        </div>

        <div class="mcp-primitive">
          <div class="mcp-primitive__head">
            <h3>Tools</h3>
            <span class="mcp-primitive__count">16</span>
          </div>
          <p class="mcp-primitive__def">
            The work an associate would otherwise build in a spreadsheet, or wait on an advisor to
            deliver. Each tool runs a GST model against your deal's parameters and returns figures
            defensible enough for an IC memo: a scoped diligence agenda, a cost benchmark, a debt
            estimate, a regulatory exposure list. The model invokes them on its own as the
            conversation calls for them, so an analyst asks in plain English instead of learning an
            API. Radar tools are granted separately. <a
              href="https://modelcontextprotocol.io/docs/concepts/tools"
              target="_blank"
              rel="noopener noreferrer">Tools in the MCP spec</a
            >
          </p>
          <details class="brutal-faq__item mcp-disclosure">
            <summary class="brutal-faq__question">
              <span>Browse all 16 tools</span>
              <DeltaIcon class="delta-chevron" />
            </summary>
            <div class="mcp-catalog">
              <div class="mcp-catalog__group">
                <h4>Diligence agenda</h4>
                <p class="mcp-catalog__gloss">
                  Turns a target profile into a prioritized diligence agenda with scope and timeline
                  estimates.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />generate_diligence_agenda</li>
                </ul>
                <a class="mcp-catalog__try" href="/hub/tools/diligence-machine/"
                  >Try it in a browser</a
                >
              </div>
              <div class="mcp-catalog__group">
                <h4>Engagement history</h4>
                <p class="mcp-catalog__gloss">
                  Searches GST's engagement record by sector, deal type, stage, and scale, and lists
                  the values each filter accepts.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />search_portfolio</li>
                  <li><DeltaIcon class="bullet-icon" />list_portfolio_facets</li>
                </ul>
                <a class="mcp-catalog__try" href="/ma-portfolio/">Try it in a browser</a>
              </div>
              <div class="mcp-catalog__group">
                <h4>Regulatory exposure</h4>
                <p class="mcp-catalog__gloss">
                  Queries 123 regulatory frameworks by jurisdiction, category, and effective date.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />search_regulations</li>
                  <li><DeltaIcon class="bullet-icon" />list_regulation_facets</li>
                </ul>
                <a class="mcp-catalog__try" href="/hub/tools/regulatory-map/">Try it in a browser</a
                >
              </div>
              <div class="mcp-catalog__group">
                <h4>Infrastructure cost</h4>
                <p class="mcp-catalog__gloss">
                  Scores cloud cost governance maturity across six domains and returns a prioritized
                  improvement list.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />assess_infrastructure_cost_governance</li>
                </ul>
                <a class="mcp-catalog__try" href="/hub/tools/infrastructure-cost-governance/"
                  >Try it in a browser</a
                >
              </div>
              <div class="mcp-catalog__group">
                <h4>Technology spend</h4>
                <p class="mcp-catalog__gloss">
                  Benchmarks total technology cost against stage-adjusted ranges and projects a
                  36-month trajectory.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />compute_techpar</li>
                </ul>
                <a class="mcp-catalog__try" href="/hub/tools/techpar/">Try it in a browser</a>
              </div>
              <div class="mcp-catalog__group">
                <h4>Technical debt</h4>
                <p class="mcp-catalog__gloss">
                  Estimates the annual carrying cost of technical debt from team size, salary, and
                  delivery metrics.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />estimate_tech_debt_cost</li>
                </ul>
                <a class="mcp-catalog__try" href="/hub/tools/tech-debt-calculator/"
                  >Try it in a browser</a
                >
              </div>
              <div class="mcp-catalog__group">
                <h4>Information requests</h4>
                <p class="mcp-catalog__gloss">
                  Builds a fillable information request list, populates it from evidence already in
                  hand, then ingests the completed file and checks every answer back to its source.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />generate_information_request_list_xlsx</li>
                  <li><DeltaIcon class="bullet-icon" />fill_information_request_list_xlsx</li>
                  <li><DeltaIcon class="bullet-icon" />list_irl_requests</li>
                  <li><DeltaIcon class="bullet-icon" />prepare_irl_body</li>
                  <li><DeltaIcon class="bullet-icon" />validate_irl_provenance</li>
                  <li><DeltaIcon class="bullet-icon" />compose_dossier_envelope</li>
                </ul>
                <a class="mcp-catalog__try" href="/hub/tools/information-request-list-generator/"
                  >Try it in a browser</a
                >
              </div>
              <div class="mcp-catalog__group">
                <h4>Radar search</h4>
                <p class="mcp-catalog__gloss">
                  Searches curated PE, M&amp;A, and enterprise-technology intelligence, filtered by
                  category and recency.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />search_radar</li>
                  <li><DeltaIcon class="bullet-icon" />get_latest_insights</li>
                </ul>
                <a class="mcp-catalog__try" href="/hub/radar/">Try it in a browser</a>
              </div>
            </div>
          </details>
        </div>

        <div class="mcp-primitive">
          <div class="mcp-primitive__head">
            <h3>Resources</h3>
            <span class="mcp-primitive__count">133</span>
          </div>
          <p class="mcp-primitive__def">
            The frameworks behind the numbers, readable in full. An agent working from GST's actual
            VDR taxonomy, diligence checklists, and regulation corpus grounds its answers in a
            published method rather than in whatever it absorbed during training, which is the
            difference between a citation you can check and a confident guess. The host application
            loads these as context, so they are in the conversation before the model needs them. <a
              href="https://modelcontextprotocol.io/docs/concepts/resources"
              target="_blank"
              rel="noopener noreferrer">Resources in the MCP spec</a
            >
          </p>
          <details class="brutal-faq__item mcp-disclosure">
            <summary class="brutal-faq__question">
              <span>Browse all 133 resources</span>
              <DeltaIcon class="delta-chevron" />
            </summary>
            <div class="mcp-catalog">
              <div class="mcp-catalog__group">
                <h4>Library <span class="mcp-catalog__count">4</span></h4>
                <p class="mcp-catalog__gloss">
                  The reference guides behind GST's diligence method, in full.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />Business &amp; Technology Architectures</li>
                  <li><DeltaIcon class="bullet-icon" />Virtual Data Room Structure Guide</li>
                  <li><DeltaIcon class="bullet-icon" />Information Request List</li>
                  <li><DeltaIcon class="bullet-icon" />IRL to tool-input mapping</li>
                </ul>
                <code class="mcp-catalog__uri">gst://library/&lt;slug&gt;</code>
              </div>
              <div class="mcp-catalog__group">
                <h4>Regulatory frameworks <span class="mcp-catalog__count">123</span></h4>
                <p class="mcp-catalog__gloss">
                  One document per framework, each with its requirements, penalties, and effective
                  dates.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />Data privacy</li>
                  <li><DeltaIcon class="bullet-icon" />AI governance</li>
                  <li><DeltaIcon class="bullet-icon" />Cybersecurity</li>
                  <li><DeltaIcon class="bullet-icon" />Industry compliance</li>
                </ul>
                <code class="mcp-catalog__uri"
                  >gst://regulations/&lt;jurisdiction&gt;/&lt;framework&gt;</code
                >
              </div>
              <div class="mcp-catalog__group">
                <h4>Radar feeds <span class="mcp-catalog__count">6</span></h4>
                <p class="mcp-catalog__gloss">
                  FYI carries GST-annotated highlights; Wire carries the full stream, whole or by
                  category.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />FYI, annotated highlights</li>
                  <li><DeltaIcon class="bullet-icon" />Wire, all categories</li>
                  <li><DeltaIcon class="bullet-icon" />PE &amp; M&amp;A</li>
                  <li><DeltaIcon class="bullet-icon" />Enterprise tech</li>
                  <li><DeltaIcon class="bullet-icon" />AI &amp; automation</li>
                  <li><DeltaIcon class="bullet-icon" />Security</li>
                </ul>
                <code class="mcp-catalog__uri">gst://radar/fyi|wire/&lt;category&gt;</code>
              </div>
            </div>
          </details>
        </div>

        <div class="mcp-primitive">
          <div class="mcp-primitive__head">
            <h3>Prompts</h3>
            <span class="mcp-primitive__count">12</span>
          </div>
          <p class="mcp-primitive__def">
            Knowing which tool to call is not the hard part. Knowing the order is, and that is what
            a firm's experience actually buys. Each prompt captures a GST workflow as a sequence, so
            a first-year associate running a diligence kickoff follows the same progression a GST
            engagement would. They surface as slash commands in the client, chosen deliberately by a
            person rather than guessed at by a model. <a
              href="https://modelcontextprotocol.io/docs/concepts/prompts"
              target="_blank"
              rel="noopener noreferrer">Prompts in the MCP spec</a
            >
          </p>
          <details class="brutal-faq__item mcp-disclosure">
            <summary class="brutal-faq__question">
              <span>Browse all 12 prompts</span>
              <DeltaIcon class="delta-chevron" />
            </summary>
            <div class="mcp-catalog">
              <div class="mcp-catalog__group">
                <h4>Deal workflow</h4>
                <p class="mcp-catalog__gloss">
                  Open a diligence engagement, size up a target quickly, and produce the memos a
                  deal team hands onward.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />gst_diligence_kickoff</li>
                  <li><DeltaIcon class="bullet-icon" />gst_target_quick_look</li>
                  <li><DeltaIcon class="bullet-icon" />gst_diligence_handoff_memo</li>
                  <li><DeltaIcon class="bullet-icon" />gst_comparable_engagements_memo</li>
                </ul>
              </div>
              <div class="mcp-catalog__group">
                <h4>Information requests</h4>
                <p class="mcp-catalog__gloss">
                  Issue a request list to a target, populate it from evidence in hand, then sweep
                  what comes back into a cited dossier without rekeying it.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />gst_irl_create</li>
                  <li><DeltaIcon class="bullet-icon" />gst_irl_populate</li>
                  <li><DeltaIcon class="bullet-icon" />gst_irl_ingestion</li>
                  <li><DeltaIcon class="bullet-icon" />gst_irl_sweep</li>
                  <li><DeltaIcon class="bullet-icon" />gst_irl_extract</li>
                </ul>
              </div>
              <div class="mcp-catalog__group">
                <h4>Review &amp; briefing</h4>
                <p class="mcp-catalog__gloss">
                  Standing reviews: architecture by layer, regulatory exposure, and the day's radar.
                </p>
                <ul>
                  <li><DeltaIcon class="bullet-icon" />gst_architecture_layer_review</li>
                  <li><DeltaIcon class="bullet-icon" />gst_regulatory_exposure_brief</li>
                  <li><DeltaIcon class="bullet-icon" />gst_radar_brief_today</li>
                </ul>
              </div>
            </div>
          </details>
        </div>
      </div>

      <div class="mcp-block" id="tiers">
        <h2 class="brutal-heading-lg">Capability tiers</h2>
        <p class="mcp-note">
          Tiers differ by who is using the server and how broadly, not by which tools you get.
          Scopes are set per client during provisioning.
        </p>

        {
          /* The tier headers and the ceilings table are one comparison object
          split across two elements, so they must share a column split exactly:
          four equal tracks here (no column gap) against `table-layout: fixed`
          below, both resolving to 25%, with the same horizontal padding on the
          cells. That is what puts each tier above its own numbers, and
          `hub-mcp-page.test.ts` measures it rather than trusting it. */
        }
        <div class="mcp-tiers">
          <div class="mcp-tier">
            <div class="mcp-tier__head">
              <h3 class="mcp-tier__name">Pilot</h3>
            </div>
            <code class="mcp-tier__id">free-pilot</code>
            <p class="mcp-tier__note">
              Evaluation access for a single team. Narrow scopes, radar excluded by default.
            </p>
            <a
              href={accessHref('free-pilot')}
              class="mcp-tier__cta"
              onclick="trackCTA('mcp-access-free-pilot', 'hub-mcp')">Request this tier →</a
            >
          </div>

          <div class="mcp-tier">
            <div class="mcp-tier__head">
              <h3 class="mcp-tier__name">Deal Team</h3>
              <span class="brutal-bench-table__label brutal-bench-table__label--score">Typical</span
              >
            </div>
            <code class="mcp-tier__id">paid</code>
            <p class="mcp-tier__note">Production access for a deal team, invoiced per agreement.</p>
            <a
              href={accessHref('paid')}
              class="mcp-tier__cta"
              onclick="trackCTA('mcp-access-paid', 'hub-mcp')">Request this tier →</a
            >
          </div>

          <div class="mcp-tier">
            <div class="mcp-tier__head">
              <h3 class="mcp-tier__name">Firm</h3>
            </div>
            <code class="mcp-tier__id">enterprise</code>
            <p class="mcp-tier__note">
              Firm-wide access across multiple clients, compliance capabilities on request.
            </p>
            <a
              href={accessHref('enterprise')}
              class="mcp-tier__cta"
              onclick="trackCTA('mcp-access-enterprise', 'hub-mcp')">Request this tier →</a
            >
          </div>
        </div>

        {
          /* No header row inside the table: the tier headers above ARE the
          column headers. The metric labels are therefore `<th scope="row">` —
          which is what they are, and which is also what gives every value cell
          a header, since axe's `td-has-header` applies to any table larger than
          3x3. `data-tier` names each value's column in the markup: it is what
          the parity guard binds each ceiling to, and below 768px it is printed
          onto the cell as generated text, where the rows stack and the headers
          above are no longer over their columns.

          The explicit roles are INSURANCE, not a fix for a demonstrated defect,
          and this comment previously claimed otherwise. The mobile form sets
          `display: grid` / `flex` on `tr` and `td`, which is the shape that
          has historically dropped table semantics — but measured against
          Chromium's real accessibility tree over CDP, at 1280 and at 480, with
          the roles stripped and present, the five elements come back identical
          in all four combinations (table / rowgroup / row / rowheader / cell).
          So Chromium does NOT degrade here. Measure it per element
          (`DOM.querySelector` then `Accessibility.queryAXTree`) if you re-check:
          with the roles stripped the `tbody` node is present but IGNORED, so a
          full-tree read reports it missing and suggests a degradation that a
          per-element query shows is not there. Firefox and WebKit were not measured; the roles cost
          nothing, match the implicit semantics exactly, and are kept for those.
          Note a trap if anyone tries to guard this: Playwright resolves roles
          from the DOM, so a `getByRole` assertion passes whether or not the
          engine actually degrades, and would prove nothing. */
        }
        <table
          class="brutal-bench-table mcp-tier-table"
          role="table"
          aria-label="Capability ceilings by tier: Pilot, Deal Team, Firm"
        >
          <tbody role="rowgroup">
            <tr role="row">
              <th scope="row" role="rowheader">Calls / min</th>
              <td role="cell" data-tier="Pilot">30</td>
              <td role="cell" data-tier="Deal Team">60</td>
              <td role="cell" data-tier="Firm">120</td>
            </tr>
            <tr role="row">
              <th scope="row" role="rowheader">Calls / day</th>
              <td role="cell" data-tier="Pilot">300</td>
              <td role="cell" data-tier="Deal Team">2,000</td>
              <td role="cell" data-tier="Firm">10,000</td>
            </tr>
            <tr role="row">
              <th scope="row" role="rowheader">Radar / min</th>
              <td role="cell" data-tier="Pilot">3</td>
              <td role="cell" data-tier="Deal Team">5</td>
              <td role="cell" data-tier="Firm">10</td>
            </tr>
            <tr role="row">
              <th scope="row" role="rowheader">Radar / day</th>
              <td role="cell" data-tier="Pilot">20</td>
              <td role="cell" data-tier="Deal Team">50</td>
              <td role="cell" data-tier="Firm">150</td>
            </tr>
          </tbody>
        </table>

        <p class="brutal-callout">
          <span class="brutal-callout__title">On these numbers</span>
          These are tunable, non-contractual capability ceilings, NOT ratified SLA quotas. They are abuse
          and capacity limits, adjustable per client, and nothing here is a promised allowance.
        </p>
      </div>

      <div class="mcp-block">
        <h2 class="brutal-heading-lg">How access works</h2>
        <div class="mcp-access">
          <div>
            <div class="brutal-label mcp-access__label">Provisioning</div>
            <ul class="mcp-facts">
              <li>
                <DeltaIcon class="bullet-icon" /><span
                  >Access is operator-provisioned. There is no self-serve signup and no dynamic
                  client registration. A client record is created by GST, with scopes and a tier
                  assigned deliberately.</span
                >
              </li>
              <li>
                <DeltaIcon class="bullet-icon" /><span
                  >Radar tools are granted separately and are excluded from a typical grant, because
                  they draw on a shared third-party research budget.</span
                >
              </li>
            </ul>
          </div>
          <div>
            <div class="brutal-label mcp-access__label">Authentication</div>
            <ul class="mcp-facts">
              <li>
                <DeltaIcon class="bullet-icon" /><span
                  >Machine-to-machine clients authenticate with OAuth 2.1 <code
                    >client_credentials</code
                  >, using a client secret or a registered signing key.</span
                >
              </li>
              <li>
                <DeltaIcon class="bullet-icon" /><span
                  >The interactive authorization-code flow, for a person connecting a desktop AI
                  client, requires PKCE with S256, with no exceptions and no plaintext challenge.</span
                >
              </li>
            </ul>
          </div>
          <div>
            <div class="brutal-label mcp-access__label">Operations</div>
            <ul class="mcp-facts">
              <li>
                <DeltaIcon class="bullet-icon" /><span
                  >A tamper-evident, hash-chained audit log with seven-year retention exists as
                  built-and-tested capability. It is activated for a client whose contract requires
                  it, as part of onboarding.</span
                >
                {
                  /* Framing is deliberate and load-bearing: the capture pipeline is
                deactivated (ADR-0014) and PILOT_ONBOARDING.md § 3 says in terms "Do
                not promise active audit capture in writing." Do not upgrade this
                sentence into a guarantee. */
                }
              </li>
              <li>
                <DeltaIcon class="bullet-icon" /><span
                  >Operational health (dependency status, per-tool latency, request volume) is
                  published on the status page.</span
                >
                {
                  /* Named rather than linked: the URL is a copyable value in "For
                your engineers" directly below, and printing it twice makes the
                reader check whether the two agree. */
                }
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mcp-block mcp-block--engineers">
        <h2 class="brutal-heading-md">For your engineers</h2>
        <p class="mcp-engineers__lede">
          One endpoint to configure, once a client record exists. Credentials arrive with
          provisioning.
        </p>

        <div class="mcp-endpoints">
          <p class="mcp-endpoint">
            <span class="mcp-endpoint__label">Endpoint</span>
            <code data-endpoint-url>https://mcp.globalstrategic.tech/mcp</code>
            <button
