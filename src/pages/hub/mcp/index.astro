<script>
  import { trackCTA } from '../../../utils/analytics';
  import { copyWithFeedback } from '../../../utils/copy-feedback';

  // Each button copies the `<code>` in its own row. Read from the DOM rather
  // than repeated here: those `<code>` values are what the parity guard pins, so
  // a copy in script would be a second thing to keep in sync. Row-scoped rather
  // than id-matched so adding another endpoint row needs no script change.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-endpoint]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.closest('.mcp-endpoint')?.querySelector('code')?.textContent?.trim() ?? '';
      void copyWithFeedback(value, btn, {
        label: 'Copied',
        copiedClass: 'brutal-btn--copied',
        // Swap only the visible word, leaving the `.sr-only` suffix in place.
        // That suffix is what distinguishes the two buttons ("Copy endpoint URL"
        // vs "Copy status page URL") without an `aria-label` — a label would
        // override the name and stop `aria-live` announcing the change to
        // "Copied", which is the confirmation a screen-reader user gets.
        feedbackTarget: btn.querySelector<HTMLElement>('[data-copy-label]') ?? btn,
      });
    });
  });
  // TODO(phase-3): replace with proper ambient `Window` type declaration.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  (window as any).trackCTA = trackCTA;
</script>

<style>
  .mcp-section {
