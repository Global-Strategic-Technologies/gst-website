---
/**
 * /hub/radar — The Radar: Curated Intelligence Feed
 *
 * SERVER-RENDERED with ISR. The feed is rendered INLINE — deliberately not a
 * server island. Under `server:defer` the initial HTML carried only the shell
 * (~44 words of nav and headings, measured); the feed arrived via a second
 * JS-initiated request. Googlebot executes JS on a deferred queue, so a page
 * whose substance lives entirely in that payload gets judged on the shell —
 * which is why this route sat unindexed. See RADAR.md § "Why the feed is not
 * a server island" before reintroducing `server:defer`.
 *
 * Trade-off accepted, not overlooked: inlining moves the fetch inside the
 * cached ISR entry, so a failed revalidation bakes the empty state into a 200
 * for up to 6h where the uncached island self-healed on the next request.
 * Tracked as BL-098.
 *
 * Content tiers (rendered in a single unified feed):
 *   1. FYI — Annotated items from Inoreader (highlights + GST Take)
 *   2. The Wire — Automated RSS from Inoreader subscriptions
 */
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RadarHeader from '../../../components/radar/RadarHeader.astro';
import RadarFeed from '../../../components/radar/RadarFeed.astro';
import CategoryFilter from '../../../components/radar/CategoryFilter.astro';
import PrintReportHeader from '../../../components/PrintReportHeader.astro';

import { CATEGORIES } from '../../../lib/inoreader/transform';
---

<BaseLayout
  title="The Radar — Technology & M&A Intelligence | GST"
  description="Curated intelligence on technology trends, M&A dynamics, and enterprise technology shifts. Practitioner perspectives from 50+ PE technology engagements."
  ogTitle="The Radar - Perspectives | GST"
  ogDescription="Curated technology and M&A intelligence for PE investors and portfolio company leaders."
  ogImage="/og-image.png"
  ogImageAlt="GST Radar - Technology and M&A Intelligence Feed"
>
  <PrintReportHeader title="The Radar" />

  <div class="radar-container">
    <div class="container">
      <RadarHeader />

      <CategoryFilter categories={CATEGORIES} />

      <RadarFeed />

      <a href="/hub/" class="cta-button secondary">Return to Hub</a>
    </div>
  </div>
</BaseLayout>

<style>
  .radar-container {
    padding-bottom: var(--spacing-3xl);
  }

  @media print {
    .category-filter,
    .cta-button {
      display: none;
    }

    .radar-container {
      padding: 0;
    }

    @page {
      margin: 1.5cm;
    }
  }
</style>
