---
/**
 * Every non-English page on the site comes from this one route (BL-153,
 * ADR-0030). `getStaticPaths` is the cross product of the non-default locales
 * and the Tier A routes that have a template, so adding a page to every locale
 * is one `TIER_A_ROUTES` entry plus one `TEMPLATES` entry — no per-route
 * `[locale]/about.astro` files.
 *
 * `Astro.currentLocale` here is the locale CODE (`pt-BR`), not the URL segment
 * (`pt-br`) — verified in the Phase 0 spike. The template receives the
 * registry object and renders `BaseLayout` itself, exactly as the English
 * wrapper (`src/pages/about.astro`) does.
 */
import { nonDefaultLocales } from '../../i18n/locales';
import { TIER_A_ROUTES, routeParam } from '../../i18n/routes';
import { TEMPLATES, type TemplateId } from '../../page-templates/registry';

export function getStaticPaths() {
  return nonDefaultLocales().flatMap((locale) =>
    TIER_A_ROUTES.filter((route) => route.id in TEMPLATES).map((route) => ({
      params: { locale: locale.path, route: routeParam(route) },
      props: { localeCode: locale.code, templateId: route.id as TemplateId },
    }))
  );
}

interface Props {
  localeCode: string;
  templateId: TemplateId;
}

const { localeCode, templateId } = Astro.props;
const locale = nonDefaultLocales().find((l) => l.code === localeCode);
if (!locale) throw new Error(`i18n: catch-all rendered for unknown locale "${localeCode}"`);
const Template = TEMPLATES[templateId];
---

<Template locale={locale} />
