---
// English route for /about/. The page body lives in
// src/page-templates/AboutPage.astro and is shared with every locale via
// src/pages/[locale]/[...route].astro (BL-153). This file stays at its path
// so route-scanning tests keep finding the route where it has always been.
import AboutPage from '../page-templates/AboutPage.astro';
import { DEFAULT_LOCALE } from '../i18n/locales';
---

<AboutPage locale={DEFAULT_LOCALE} />
